---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`골프 스코어 분석 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	</head>
	<body>
		<Header />
		<main class="w-full max-w-4xl mx-auto px-4 py-8">
            <h1 class="text-3xl font-bold text-center mb-8 flex justify-center items-center gap-2">
                ⛳️ 스코어 분석
                <span class="relative inline-block ml-2 group">
                    <select id="year-select" class="appearance-none bg-white/80 backdrop-blur-sm border border-gray-200 rounded-lg text-2xl font-bold text-blue-600 px-4 py-1.5 pr-10 cursor-pointer shadow-lg shadow-blue-500/10 transition-all duration-300 hover:shadow-xl hover:shadow-blue-500/20 hover:border-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-400">
                        <!-- 옵션은 동적으로 채워집니다 -->
                        <option>Loading...</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3 text-blue-500 transition-transform duration-300 group-hover:translate-y-0.5">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </div>
                </span>
            </h1>
            
            <!-- 차트 섹션 -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-xl font-bold mb-4">🏆 선수별 평균 스코어</h2>
                <div class="relative h-[400px] w-full flex items-center justify-center">
                    <p class="text-gray-500" id="loading-text">데이터를 불러오는 중입니다...</p>
                    <canvas id="scoreChart"></canvas>
                </div>
            </div>

            <!-- 게임 표 섹션 -->
            <div id="tournaments-container" class="hidden mb-8">
                <!-- 동적으로 게임 표가 추가됩니다 -->
            </div>

            <!-- 통계 섹션 -->
            <div class="bg-white rounded-xl shadow-lg p-4 sm:p-6 mb-8 hidden" id="stats-container">
                <h2 class="text-xl font-bold mb-4">📊 선수별 상세 통계</h2>
                <p class="text-sm text-gray-500 mb-4">* 선수를 클릭하면 상세 라운드 기록과 경기별 추이를 볼 수 있습니다.</p>

                <!-- 모바일 카드 뷰 (md 미만에서 표시) -->
                <div id="stats-cards-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:hidden">
                    <!-- 카드가 동적으로 추가됩니다 -->
                </div>

                <!-- 데스크톱 테이블 뷰 (md 이상에서 표시) -->
                <div class="hidden md:block overflow-x-auto">
                    <table class="w-full text-sm text-left text-gray-500">
                        <thead class="text-xs text-white uppercase bg-green-600">
                            <tr>
                                <th scope="col" class="px-6 py-3">순위</th>
                                <th scope="col" class="px-6 py-3">이름</th>
                                <th scope="col" class="px-6 py-3 text-center">핸디캡</th>
                                <th scope="col" class="px-6 py-3 text-center">평균 타수</th>
                                <th scope="col" class="px-6 py-3 text-center">베스트</th>
                                <th scope="col" class="px-6 py-3 text-center">라운드 수</th>
                            </tr>
                        </thead>
                        <tbody id="stats-table-body">
                            <!-- 데이터가 여기에 추가됩니다 -->
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 경기별 스코어 추이 라인 차트 -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8 hidden" id="line-chart-container">
                <h2 class="text-xl font-bold mb-4">📈 경기별 스코어 추이</h2>
                <p class="text-sm text-gray-500 mb-4">* 위쪽이 더 좋은 성적입니다. 아래 선수 이름을 클릭하면 해당 선수 라인이 강조됩니다.</p>
                <div class="relative h-[450px] w-full">
                    <canvas id="lineChart"></canvas>
                </div>
                <!-- 범례 -->
                <div id="line-chart-legend" class="mt-4 flex flex-wrap gap-3 justify-center">
                    <!-- 동적으로 범례가 추가됩니다 -->
                </div>
            </div>

            <!-- 상세 기록 섹션 (히든) -->
            <div id="detail-section" class="hidden bg-white rounded-xl shadow-lg p-4 sm:p-6 fade-in">
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-xl font-bold flex-1 mr-4 break-keep" id="detail-title">선수 상세 기록</h2>
                    <button id="close-detail" class="text-gray-500 hover:text-gray-700 flex-shrink-0 mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <!-- 카드 그리드 컨테이너 -->
                <div id="detail-cards-container" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <!-- 카드가 동적으로 추가됩니다 -->
                </div>
            </div>
            <!-- 툴팁 팝업 (동반 플레이어 정보) -->
            <div id="hover-tooltip" class="fixed hidden z-50 bg-white rounded-lg shadow-xl border border-gray-200 p-4 min-w-[200px] transform transition-opacity duration-200 opacity-0">
                <h3 id="tooltip-title" class="text-sm font-bold text-gray-900 mb-2 border-b pb-1">🏌️‍♂️ 해당 라운드 순위</h3>
                <div id="tooltip-content" class="text-xs">
                    <!-- 내용이 동적으로 들어갑니다 -->
                </div>
            </div>
		</main>
		<Footer />

        <style>
            #year-select {
                background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.7) 100%);
            }

            #year-select option {
                background: white;
                padding: 12px;
            }

            .fade-in {
                animation: fadeIn 0.3s ease-in;
            }
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }
            tr.selected-row {
                background-color: #dcfce7 !important; /* bg-green-100 */
                border-left: 4px solid #16a34a !important; /* border-green-600 */
            }
            tr.cursor-pointer:hover {
                background-color: #f0fdf4; /* bg-green-50 */
            }
            /* 툴팁용 스타일 */
            .tooltip-row {
                display: flex;
                justify-content: space-between;
                padding: 4px 0;
                border-bottom: 1px solid #f3f4f6;
            }
            .tooltip-row:last-child {
                border-bottom: none;
            }
            .rank-badge {
                display: inline-block;
                width: 20px;
                text-align: center;
                font-weight: bold;
            }
            .rank-1 { color: #eab308; } /* 1등 금색 */
            .rank-2 { color: #94a3b8; } /* 2등 은색 */
            .rank-3 { color: #b45309; } /* 3등 동색 */

            /* 라운드 카드 스타일 */
            .round-card {
                position: relative;
                overflow: hidden;
            }
            .round-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #3b82f6, #10b981);
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            .round-card:hover::before {
                opacity: 1;
            }

            /* 선수 통계 카드 스타일 */
            .stats-player-card {
                position: relative;
                overflow: hidden;
            }
            .stats-player-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, #22c55e, #16a34a);
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            .stats-player-card:hover::before {
                opacity: 1;
            }
        </style>

        <script>
            document.addEventListener('DOMContentLoaded', async () => {
                const ctx = document.getElementById('scoreChart');
                const loadingText = document.getElementById('loading-text');
                const statsContainer = document.getElementById('stats-container');
                const tableBody = document.getElementById('stats-table-body');
                const statsCardsContainer = document.getElementById('stats-cards-container');
                const detailSection = document.getElementById('detail-section');
                const detailTitle = document.getElementById('detail-title');
                const detailCardsContainer = document.getElementById('detail-cards-container');
                const closeDetailBtn = document.getElementById('close-detail');
                const tooltip = document.getElementById('hover-tooltip');
                const tooltipContent = document.getElementById('tooltip-content');
                const tooltipTitle = document.getElementById('tooltip-title');
                const yearSelect = document.getElementById('year-select');

                let allPlayers = [];
                let allTournaments = []; // 모든 토너먼트 정보 저장
                let chartInstance = null;
                let lineChartInstance = null;
                let selectedPlayerName = null;
                let allGames = []; // 모든 게임 정보 저장

                // 선수별 고유 색상 팔레트 (12명까지)
                const playerColors = [
                    { bg: 'rgba(239, 68, 68, 0.8)', border: 'rgb(239, 68, 68)' },      // red
                    { bg: 'rgba(59, 130, 246, 0.8)', border: 'rgb(59, 130, 246)' },    // blue
                    { bg: 'rgba(34, 197, 94, 0.8)', border: 'rgb(34, 197, 94)' },      // green
                    { bg: 'rgba(249, 115, 22, 0.8)', border: 'rgb(249, 115, 22)' },    // orange
                    { bg: 'rgba(168, 85, 247, 0.8)', border: 'rgb(168, 85, 247)' },    // purple
                    { bg: 'rgba(236, 72, 153, 0.8)', border: 'rgb(236, 72, 153)' },    // pink
                    { bg: 'rgba(20, 184, 166, 0.8)', border: 'rgb(20, 184, 166)' },    // teal
                    { bg: 'rgba(234, 179, 8, 0.8)', border: 'rgb(234, 179, 8)' },      // yellow
                    { bg: 'rgba(99, 102, 241, 0.8)', border: 'rgb(99, 102, 241)' },    // indigo
                    { bg: 'rgba(107, 114, 128, 0.8)', border: 'rgb(107, 114, 128)' },  // gray
                    { bg: 'rgba(6, 182, 212, 0.8)', border: 'rgb(6, 182, 212)' },      // cyan
                    { bg: 'rgba(132, 204, 22, 0.8)', border: 'rgb(132, 204, 22)' },    // lime
                ];

                // 토글 함수 (전역으로 등록)
                window.toggleTournament = function(toggleId) {
                    const content = document.getElementById(toggleId);
                    const icon = document.getElementById(`${toggleId}-icon`);
                    
                    if (content.classList.contains('hidden')) {
                        content.classList.remove('hidden');
                        icon.classList.add('rotate-180');
                    } else {
                        content.classList.add('hidden');
                        icon.classList.remove('rotate-180');
                    }
                };

                // 게임 표 렌더링 함수
                function renderTournaments(tournaments) {
                    const container = document.getElementById('tournaments-container');
                    container.innerHTML = '';
                    container.classList.remove('hidden');

                    tournaments.forEach((tournament, index) => {
                        // 대회 제목 추출 (첫 경기의 지역명 사용)
                        const tournamentName = tournament.games && tournament.games.length > 0 
                            ? tournament.games[0].region || `경기 ${index + 1}`
                            : `경기 ${index + 1}`;

                        const tournamentDiv = document.createElement('div');
                        tournamentDiv.className = 'bg-white rounded-xl shadow-lg mb-8';
                        
                        // 마지막 경기만 펼쳐진 상태, 나머지는 접힌 상태
                        const isOpen = index === tournaments.length - 1;
                        const toggleId = `tournament-${index}`;
                        
                        let html = `
                            <div class="p-6 cursor-pointer hover:bg-gray-50 transition-colors flex justify-between items-center" onclick="toggleTournament('${toggleId}')">
                                <h2 class="text-xl font-bold">🏌️ ${tournamentName}</h2>
                                <svg id="${toggleId}-icon" class="w-6 h-6 transition-transform ${isOpen ? 'rotate-180' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                                </svg>
                            </div>
                        `;
                        html += `<div id="${toggleId}" class="overflow-x-auto px-6 pb-6 ${isOpen ? '' : 'hidden'}">`;
                        html += '<table class="w-full text-sm border-collapse">';
                        
                        // 헤더 행
                        html += '<thead><tr class="bg-green-600 text-white">';
                        html += '<th class="border border-gray-300 px-3 py-2 text-left sticky left-0 bg-green-600 z-10">PRO</th>';
                        
                        tournament.games.forEach(game => {
                            const gameInfo = `${game.date}<br>${game.course}`;
                            html += `<th class="border border-gray-300 px-3 py-2 text-center whitespace-pre-line min-w-[120px]">${gameInfo}</th>`;
                        });
                        
                        html += '<th class="border border-gray-300 px-3 py-2 text-center">평균</th>';
                        html += '<th class="border border-gray-300 px-3 py-2 text-center">Total</th>';
                        html += '<th class="border border-gray-300 px-3 py-2 text-center">순위</th>';
                        html += '</tr></thead>';
                        
                        // 순위별로 정렬 (오름차순)
                        const sortedPlayers = [...tournament.players].sort((a, b) => {
                            const rankA = parseInt(a.rank) || 999;
                            const rankB = parseInt(b.rank) || 999;
                            return rankA - rankB;
                        });

                        // 데이터 행
                        html += '<tbody>';
                        sortedPlayers.forEach((player, pIndex) => {
                            const rowClass = pIndex % 2 === 0 ? 'bg-white' : 'bg-gray-50';
                            html += `<tr class="${rowClass} hover:bg-green-50 transition-colors">`;
                            html += `<td class="border border-gray-300 px-3 py-2 font-bold sticky left-0 ${rowClass} z-10">${player.name}</td>`;
                            
                            // 각 경기별 스코어
                            tournament.games.forEach(game => {
                                const score = player.scores.find(s => s.colIndex === game.colIndex);
                                const scoreValue = score ? score.score : '-';
                                const scoreClass = score && score.score <= 72 ? 'text-red-600 font-bold' : '';
                                html += `<td class="border border-gray-300 px-3 py-2 text-center ${scoreClass}">${scoreValue}</td>`;
                            });
                            
                            // 평균
                            const avg = player.scores.length > 0 
                                ? (player.scores.reduce((sum, s) => sum + s.score, 0) / player.scores.length).toFixed(1)
                                : '-';
                            html += `<td class="border border-gray-300 px-3 py-2 text-center font-bold">${avg}</td>`;
                            
                            // Total
                            html += `<td class="border border-gray-300 px-3 py-2 text-center font-bold">${player.total || '-'}</td>`;
                            
                            // 순위 (배경색으로 강조)
                            let rankBgClass = '';
                            let rankTextClass = 'font-bold';
                            if (player.rank === '1') {
                                rankBgClass = 'bg-yellow-400 text-yellow-900';  // 금색
                            } else if (player.rank === '2') {
                                rankBgClass = 'bg-gray-300 text-gray-900';  // 은색
                            } else if (player.rank === '3') {
                                rankBgClass = 'bg-orange-400 text-orange-900';  // 동색
                            }
                            html += `<td class="border border-gray-300 px-3 py-2 text-center ${rankTextClass} ${rankBgClass}">${player.rank}</td>`;
                            html += '</tr>';
                        });
                        html += '</tbody></table></div>';
                        
                        tournamentDiv.innerHTML = html;
                        container.appendChild(tournamentDiv);
                    });
                }

                // 라인 차트 렌더링 함수
                function renderLineChart(tournaments, players) {
                    const lineChartContainer = document.getElementById('line-chart-container');
                    const lineChartCtx = document.getElementById('lineChart');
                    const legendContainer = document.getElementById('line-chart-legend');

                    // 기존 차트 제거
                    if (lineChartInstance) {
                        lineChartInstance.destroy();
                        lineChartInstance = null;
                    }

                    // 모든 게임 정보 수집 (날짜순 정렬)
                    allGames = [];
                    tournaments.forEach((tournament, tIndex) => {
                        tournament.games.forEach(game => {
                            allGames.push({
                                tournamentIndex: tIndex,
                                region: tournament.games[0]?.region || '',
                                date: game.date,
                                course: game.course,
                                label: `${game.date}\n${game.course}`,
                                colIndex: game.colIndex,
                                tournament: tournament
                            });
                        });
                    });

                    // 날짜순 정렬
                    allGames.sort((a, b) => new Date(a.date) - new Date(b.date));

                    // X축 레이블
                    const labels = allGames.map((g, idx) => `G${idx + 1}`);

                    // 각 선수별 데이터셋 생성
                    const datasets = players.map((player, pIndex) => {
                        const color = playerColors[pIndex % playerColors.length];
                        const isSelected = player.name === selectedPlayerName;

                        // 각 게임별 스코어 찾기
                        const data = allGames.map(game => {
                            const round = player.rounds.find(r =>
                                r.date.trim() === game.date.trim() &&
                                r.course.trim() === game.course.trim()
                            );
                            return round ? round.score : null;
                        });

                        return {
                            label: player.name,
                            data: data,
                            borderColor: color.border.replace('rgb', 'rgba').replace(')', ', 0.5)'),
                            backgroundColor: color.bg,
                            borderWidth: 1.5,
                            pointRadius: 1,
                            pointHoverRadius: 5,
                            tension: 0.3,
                            spanGaps: true,
                            order: 0,
                        };
                    });

                    // Y축 범위 계산 (최소/최대 스코어)
                    const allScores = datasets.flatMap(d => d.data.filter(v => v !== null));
                    const minScore = Math.min(...allScores) - 2;
                    const maxScore = Math.max(...allScores) + 2;

                    // 등수 계산 플러그인
                    const rankPlugin = {
                        id: 'rankPlugin',
                        afterDatasetsDraw: function(chart) {
                            if (!selectedPlayerName) return;

                            const ctx = chart.ctx;
                            const meta = chart.getDatasetMeta(
                                datasets.findIndex(d => d.label === selectedPlayerName)
                            );

                            if (!meta || meta.hidden) return;

                            meta.data.forEach((point, index) => {
                                const gameData = allGames[index];
                                if (!gameData) return;

                                // 해당 게임의 모든 선수 스코어 수집
                                const gameScores = [];
                                players.forEach(p => {
                                    const round = p.rounds.find(r =>
                                        r.date.trim() === gameData.date.trim() &&
                                        r.course.trim() === gameData.course.trim()
                                    );
                                    if (round) {
                                        gameScores.push({ name: p.name, score: round.score });
                                    }
                                });

                                // 순위 계산 - 공동 순위 처리
                                const selectedPlayer = gameScores.find(s => s.name === selectedPlayerName);
                                if (!selectedPlayer) return; // 해당 게임에 참가하지 않음

                                const rank = gameScores.filter(s => s.score < selectedPlayer.score).length + 1;

                                const x = point.x;
                                const y = point.y;

                                // 등수 배지 그리기
                                const badgeY = y - 20;
                                const badgeRadius = 12;

                                // 배경 원
                                ctx.save();
                                ctx.beginPath();
                                ctx.arc(x, badgeY, badgeRadius, 0, Math.PI * 2);

                                // 등수별 색상
                                if (rank === 1) {
                                    ctx.fillStyle = '#fbbf24'; // gold
                                } else if (rank === 2) {
                                    ctx.fillStyle = '#9ca3af'; // silver
                                } else if (rank === 3) {
                                    ctx.fillStyle = '#f97316'; // bronze
                                } else {
                                    ctx.fillStyle = '#6b7280'; // gray
                                }
                                ctx.fill();

                                // 테두리
                                ctx.strokeStyle = '#ffffff';
                                ctx.lineWidth = 2;
                                ctx.stroke();

                                // 텍스트
                                ctx.fillStyle = '#ffffff';
                                ctx.font = 'bold 11px sans-serif';
                                ctx.textAlign = 'center';
                                ctx.textBaseline = 'middle';
                                ctx.fillText(rank, x, badgeY);
                                ctx.restore();
                            });
                        }
                    };

                    // 라인 차트 생성
                    lineChartInstance = new Chart(lineChartCtx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: datasets
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: {
                                mode: 'index',
                                intersect: false,
                            },
                            plugins: {
                                legend: { display: false },
                                title: {
                                    display: true,
                                    text: '경기별 스코어 추이 (낮을수록 좋은 성적)',
                                    font: { size: 14 }
                                },
                                tooltip: {
                                    itemSort: function(a, b) {
                                        // 스코어 오름차순 정렬 (낮은 점수 = 높은 순위가 위로)
                                        return a.raw - b.raw;
                                    },
                                    callbacks: {
                                        title: function(context) {
                                            const idx = context[0].dataIndex;
                                            const game = allGames[idx];
                                            return game ? `${game.date} - ${game.course}` : '';
                                        },
                                        label: function(context) {
                                            const score = context.raw;
                                            if (score === null) return null;

                                            // 해당 게임의 모든 스코어 수집
                                            const idx = context.dataIndex;
                                            const gameScores = [];
                                            context.chart.data.datasets.forEach(ds => {
                                                const dsScore = ds.data[idx];
                                                if (dsScore !== null) {
                                                    gameScores.push(dsScore);
                                                }
                                            });

                                            // 공동 순위 계산: 나보다 낮은 스코어 개수 + 1
                                            const rank = gameScores.filter(s => s < score).length + 1;

                                            return `${rank}위 ${context.dataset.label}: ${score}타`;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    reverse: true, // 낮은 점수가 위로
                                    min: minScore,
                                    max: maxScore,
                                    title: { display: true, text: '타수 (낮을수록 좋음)' },
                                    ticks: {
                                        stepSize: 2
                                    }
                                },
                                x: {
                                    title: { display: true, text: '경기' },
                                    ticks: {
                                        callback: function(value, index) {
                                            const game = allGames[index];
                                            return game ? `G${index + 1}` : '';
                                        }
                                    }
                                }
                            }
                        },
                        plugins: [rankPlugin]
                    });

                    // 범례 렌더링
                    legendContainer.innerHTML = '';
                    players.forEach((player, pIndex) => {
                        const color = playerColors[pIndex % playerColors.length];
                        const isSelected = player.name === selectedPlayerName;

                        const legendItem = document.createElement('div');
                        legendItem.dataset.player = player.name;
                        legendItem.dataset.colorIndex = pIndex;
                        legendItem.className = `flex items-center gap-2 px-3 py-1.5 rounded-full cursor-pointer transition-all ${
                            isSelected
                                ? 'bg-gray-800 text-white ring-2 ring-offset-2'
                                : 'bg-gray-100 hover:bg-gray-200 text-gray-700'
                        }`;
                        legendItem.style.cssText = isSelected ? `--tw-ring-color: ${color.border}` : '';

                        legendItem.innerHTML = `
                            <span class="w-3 h-3 rounded-full" style="background-color: ${color.border}"></span>
                            <span class="text-sm font-medium">${player.name}</span>
                        `;

                        // 범례 클릭 시 선수 선택 (차트 재렌더링 없이 스타일만 업데이트)
                        legendItem.addEventListener('click', () => {
                            if (selectedPlayerName === player.name) {
                                selectedPlayerName = null; // 선택 해제
                                detailSection.classList.add('hidden');
                                highlightPlayerInTable(null);
                            } else {
                                selectedPlayerName = player.name;
                                // 통계 테이블 하이라이트
                                highlightPlayerInTable(player.name);
                                // 상세 정보도 표시
                                renderDetails(player, false);
                            }
                            updateChartHighlight();
                        });

                        legendContainer.appendChild(legendItem);
                    });

                    lineChartContainer.classList.remove('hidden');
                }

                // 차트 하이라이트만 업데이트 (재렌더링 없이)
                function updateChartHighlight() {
                    if (!lineChartInstance) return;

                    const hasSelection = selectedPlayerName !== null;

                    // 데이터셋 스타일 업데이트
                    lineChartInstance.data.datasets.forEach((dataset, index) => {
                        const color = playerColors[index % playerColors.length];
                        const isSelected = dataset.label === selectedPlayerName;

                        if (hasSelection) {
                            if (isSelected) {
                                // 선택된 선수: 굵고 선명하게, 앞으로
                                dataset.borderColor = color.border;
                                dataset.backgroundColor = color.bg;
                                dataset.borderWidth = 4;
                                dataset.pointRadius = 5;
                                dataset.pointHoverRadius = 8;
                                dataset.order = 0;
                            } else {
                                // 선택되지 않은 선수: 거의 보이지 않게
                                dataset.borderColor = color.border.replace('rgb', 'rgba').replace(')', ', 0.08)');
                                dataset.backgroundColor = color.bg.replace('0.8)', '0.05)');
                                dataset.borderWidth = 1;
                                dataset.pointRadius = 0;
                                dataset.pointHoverRadius = 0;
                                dataset.order = 1;
                            }
                        } else {
                            // 선택 없음: 얇고 반투명한 기본 스타일
                            dataset.borderColor = color.border.replace('rgb', 'rgba').replace(')', ', 0.5)');
                            dataset.backgroundColor = color.bg;
                            dataset.borderWidth = 1.5;
                            dataset.pointRadius = 1;
                            dataset.pointHoverRadius = 5;
                            dataset.order = 0;
                        }
                    });

                    // 차트 업데이트 (애니메이션 없이)
                    lineChartInstance.update('none');

                    // 범례 스타일 업데이트
                    updateLegendHighlight();
                }

                // 범례 하이라이트 업데이트
                function updateLegendHighlight() {
                    const legendContainer = document.getElementById('line-chart-legend');
                    if (!legendContainer) return;

                    const legendItems = legendContainer.querySelectorAll('div[data-player]');
                    legendItems.forEach(item => {
                        const playerName = item.dataset.player;
                        const isSelected = playerName === selectedPlayerName;
                        const colorIndex = parseInt(item.dataset.colorIndex);
                        const color = playerColors[colorIndex % playerColors.length];

                        if (isSelected) {
                            item.className = 'flex items-center gap-2 px-3 py-1.5 rounded-full cursor-pointer transition-all bg-gray-800 text-white ring-2 ring-offset-2';
                            item.style.cssText = `--tw-ring-color: ${color.border}`;
                        } else {
                            item.className = 'flex items-center gap-2 px-3 py-1.5 rounded-full cursor-pointer transition-all bg-gray-100 hover:bg-gray-200 text-gray-700';
                            item.style.cssText = '';
                        }
                    });
                }

                // 테이블에서 선수 하이라이트
                function highlightPlayerInTable(playerName) {
                    // 테이블 행 하이라이트
                    document.querySelectorAll('#stats-table-body tr').forEach(row => {
                        if (playerName && row.dataset.player === playerName) {
                            row.classList.add('selected-row', 'bg-green-100', 'border-green-600');
                            row.classList.remove('bg-white', 'border-transparent');
                        } else {
                            row.classList.remove('selected-row', 'bg-green-100', 'border-green-600');
                            row.classList.add('bg-white', 'border-transparent');
                        }
                    });
                    // 카드 하이라이트
                    document.querySelectorAll('.stats-player-card').forEach(card => {
                        if (playerName && card.dataset.player === playerName) {
                            card.classList.add('ring-2', 'ring-green-500', 'bg-green-50');
                        } else {
                            card.classList.remove('ring-2', 'ring-green-500', 'bg-green-50');
                        }
                    });
                }

                // 데이터 로드 함수
                async function loadData(sheetName = '') {
                    try {
                        // 로딩 상태 표시
                        loadingText.style.display = 'block';
                        loadingText.innerText = '데이터를 불러오는 중입니다...';
                        statsContainer.classList.add('hidden');
                        detailSection.classList.add('hidden');
                        document.getElementById('tournaments-container').classList.add('hidden');
                        document.getElementById('line-chart-container').classList.add('hidden');
                        hideTooltip();

                        // 선택된 선수 초기화
                        selectedPlayerName = null;

                        // 차트 캔버스 초기화 (잔상 제거)
                        if (chartInstance) {
                            chartInstance.destroy();
                            chartInstance = null;
                        }
                        if (lineChartInstance) {
                            lineChartInstance.destroy();
                            lineChartInstance = null;
                        }

                        const url = sheetName ? `/api/golf-data?sheetName=${encodeURIComponent(sheetName)}` : '/api/golf-data';
                        const response = await fetch(url);
                        const result = await response.json();

                        if (!result.success) throw new Error(result.message || '데이터 로드 실패');

                        // 시트 목록 업데이트 (최초 1회 또는 필요시)
                        if (yearSelect.options.length <= 1 && result.sheets) {
                            yearSelect.innerHTML = '';
                            result.sheets.forEach(sheet => {
                                const option = document.createElement('option');
                                option.value = sheet;
                                option.textContent = sheet;
                                if (sheet === result.currentSheet) {
                                    option.selected = true;
                                }
                                yearSelect.appendChild(option);
                            });
                        }

                        // 선택된 값 동기화 (API가 반환한 실제 시트명으로)
                        if (result.currentSheet) {
                            yearSelect.value = result.currentSheet;
                        }

                        allPlayers = result.playerStats;
                        
                        loadingText.style.display = 'none';
                        statsContainer.classList.remove('hidden');
                        tableBody.innerHTML = ''; // 기존 테이블 초기화
                        statsCardsContainer.innerHTML = ''; // 기존 카드 초기화

                        // 게임 표 렌더링
                        if (result.tournaments && result.tournaments.length > 0) {
                            allTournaments = result.tournaments; // 저장
                            renderTournaments(result.tournaments);
                            // 라인 차트 렌더링
                            renderLineChart(result.tournaments, allPlayers);
                        }

                        // 선수 클릭 핸들러
                        function handlePlayerClick(player, element, isCard = false) {
                            // 테이블 선택 스타일 토글
                            document.querySelectorAll('#stats-table-body tr').forEach(r => {
                                r.classList.remove('selected-row', 'bg-green-100', 'border-green-600');
                                r.classList.add('bg-white', 'border-transparent');
                            });
                            // 카드 선택 스타일 토글
                            document.querySelectorAll('.stats-player-card').forEach(c => {
                                c.classList.remove('ring-2', 'ring-green-500', 'bg-green-50');
                            });

                            if (isCard) {
                                element.classList.add('ring-2', 'ring-green-500', 'bg-green-50');
                                // 대응하는 테이블 행도 선택
                                const correspondingRow = document.querySelector(`#stats-table-body tr[data-player="${player.name}"]`);
                                if (correspondingRow) {
                                    correspondingRow.classList.add('selected-row', 'bg-green-100', 'border-green-600');
                                    correspondingRow.classList.remove('bg-white', 'border-transparent');
                                }
                            } else {
                                element.classList.add('selected-row', 'bg-green-100', 'border-green-600');
                                element.classList.remove('bg-white', 'border-transparent');
                                // 대응하는 카드도 선택
                                const correspondingCard = document.querySelector(`.stats-player-card[data-player="${player.name}"]`);
                                if (correspondingCard) {
                                    correspondingCard.classList.add('ring-2', 'ring-green-500', 'bg-green-50');
                                }
                            }

                            // 선택된 선수 설정 및 라인 차트 하이라이트 업데이트
                            selectedPlayerName = player.name;
                            updateChartHighlight();

                            // 상세 정보 렌더링
                            renderDetails(player);
                        }

                        // 테이블 & 카드 렌더링
                        allPlayers.forEach((player, index) => {
                            // 순위별 배지 스타일
                            let rankBadgeClass = 'bg-gray-200 text-gray-700';
                            if (index === 0) {
                                rankBadgeClass = 'bg-yellow-400 text-yellow-900';
                            } else if (index === 1) {
                                rankBadgeClass = 'bg-gray-300 text-gray-800';
                            } else if (index === 2) {
                                rankBadgeClass = 'bg-orange-400 text-orange-900';
                            }

                            // 테이블 행 생성
                            const row = document.createElement('tr');
                            row.className = 'bg-white border-b transition-colors duration-200 cursor-pointer border-l-4 border-transparent';
                            row.dataset.player = player.name;

                            row.innerHTML = `
                                <td class="px-6 py-4 font-medium">${index + 1}</td>
                                <td class="px-6 py-4 font-bold text-gray-900">${player.name}</td>
                                <td class="px-6 py-4 text-center font-bold text-blue-600">${player.handicap > 0 ? '+' : ''}${player.handicap}</td>
                                <td class="px-6 py-4 text-center">${player.averageScore}</td>
                                <td class="px-6 py-4 text-center text-green-600 font-bold">${player.bestScore}</td>
                                <td class="px-6 py-4 text-center">${player.roundCount}</td>
                            `;

                            row.addEventListener('click', () => handlePlayerClick(player, row, false));
                            tableBody.appendChild(row);

                            // 카드 생성
                            const card = document.createElement('div');
                            card.className = 'stats-player-card bg-gradient-to-br from-white to-gray-50 border border-gray-200 rounded-xl p-4 cursor-pointer hover:shadow-lg hover:border-green-300 transition-all duration-300';
                            card.dataset.player = player.name;

                            card.innerHTML = `
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex items-center gap-2">
                                        <span class="${rankBadgeClass} w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold">
                                            ${index + 1}
                                        </span>
                                        <span class="font-bold text-gray-900 text-lg">${player.name}</span>
                                    </div>
                                    <span class="bg-blue-100 text-blue-700 px-2 py-1 rounded-full text-sm font-bold">
                                        ${player.handicap > 0 ? '+' : ''}${player.handicap}
                                    </span>
                                </div>
                                <div class="grid grid-cols-3 gap-2 text-center">
                                    <div class="bg-gray-50 rounded-lg p-2">
                                        <div class="text-xs text-gray-500 mb-1">평균</div>
                                        <div class="text-lg font-bold text-gray-800">${player.averageScore}</div>
                                    </div>
                                    <div class="bg-green-50 rounded-lg p-2">
                                        <div class="text-xs text-gray-500 mb-1">베스트</div>
                                        <div class="text-lg font-bold text-green-600">${player.bestScore}</div>
                                    </div>
                                    <div class="bg-gray-50 rounded-lg p-2">
                                        <div class="text-xs text-gray-500 mb-1">라운드</div>
                                        <div class="text-lg font-bold text-gray-800">${player.roundCount}</div>
                                    </div>
                                </div>
                            `;

                            card.addEventListener('click', () => handlePlayerClick(player, card, true));
                            statsCardsContainer.appendChild(card);
                        });

                        // 차트 렌더링
                        chartInstance = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: allPlayers.map(p => p.name),
                                datasets: [{
                                    label: '평균 스코어',
                                    data: allPlayers.map(p => p.averageScore),
                                    backgroundColor: 'rgba(34, 197, 94, 0.6)', // Green
                                    borderColor: 'rgba(34, 197, 94, 1)',
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    title: { display: true, text: '선수별 평균 스코어' }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: false,
                                        min: 70,
                                        title: { display: true, text: '타수' }
                                    }
                                }
                            },
                            plugins: [{
                                id: 'customLabels',
                                afterDatasetsDraw: function(chart) {
                                    const ctx = chart.ctx;
                                    chart.data.datasets.forEach((dataset, i) => {
                                        const meta = chart.getDatasetMeta(i);
                                        if (!meta.hidden) {
                                            meta.data.forEach((bar, index) => {
                                                const data = dataset.data[index];
                                                
                                                ctx.fillStyle = '#15803d'; // 진한 초록색
                                                ctx.font = 'bold 14px sans-serif';
                                                ctx.textAlign = 'center';
                                                ctx.textBaseline = 'bottom';
                                                
                                                const x = bar.x;
                                                const y = bar.y - 5; // 막대 위 5px
                                                
                                                ctx.fillText(data, x, y);
                                            });
                                        }
                                    });
                                }
                            }]
                        });

                    } catch (error) {
                        console.error(error);
                        loadingText.innerText = '오류 발생: ' + error.message;
                        loadingText.classList.add('text-red-500');
                    }
                }

                // 초기 로드
                loadData();

                // 연도 변경 이벤트
                yearSelect.addEventListener('change', (e) => {
                    loadData(e.target.value);
                });

                // 이벤트 위임: 툴팁 표시 (클릭 시)
                detailCardsContainer.addEventListener('click', (e) => {
                    const rankTarget = e.target.closest('.rank-cell');
                    const regionTarget = e.target.closest('.region-cell');

                    if (!rankTarget && !regionTarget) return;

                    // 버블링 방지
                    e.stopPropagation();

                    const card = (rankTarget || regionTarget).closest('.round-card');
                    if (!card || !card.dataset.date || !card.dataset.course) return;

                    const region = card.dataset.region || '';
                    const date = card.dataset.date;
                    const course = card.dataset.course;

                    const participants = getRoundParticipants(region, date, course);

                    let title = '🏌️‍♂️ 해당 라운드 순위';
                    let useTourRank = false;

                    if (regionTarget) {
                        title = `🏆 ${region} 종합 순위`;
                        useTourRank = true;
                    }

                    showTooltip(e, participants, title, useTourRank);
                });

                // 문서 전체 클릭 시 툴팁 닫기
                document.addEventListener('click', (e) => {
                    const target = e.target;
                    if (!tooltip.contains(target) && !target.closest('.rank-cell')) {
                        hideTooltip();
                    }
                });

                // 상세 닫기 버튼
                closeDetailBtn.addEventListener('click', () => {
                    detailSection.classList.add('hidden');
                    document.querySelectorAll('#stats-table-body tr').forEach(r => {
                        r.classList.remove('selected-row', 'bg-green-100', 'border-green-600');
                        r.classList.add('bg-white', 'border-transparent');
                    });
                    // 라인 차트 선택 해제
                    selectedPlayerName = null;
                    updateChartHighlight();
                    hideTooltip();
                });

                function renderDetails(player, scroll = true) {
                    // 대회 횟수 계산 (고유한 tournamentId 개수)
                    const uniqueTournaments = new Set();
                    player.rounds.forEach(r => {
                        const key = r.tournamentId !== undefined ? r.tournamentId : r.region;
                        uniqueTournaments.add(key);
                    });
                    const tournamentCount = uniqueTournaments.size;

                    // 순위 집계 (대회 단위 중복 제거)
                    // tournamentId + rank 조합으로 고유한 대회 기록만 추출
                    const uniqueRanks = new Set();
                    player.rounds.forEach(r => {
                        // tournamentId가 있으면 사용, 없으면 region 사용 (호환성)
                        const key = r.tournamentId !== undefined ? r.tournamentId : r.region;
                        uniqueRanks.add(`${key}|${r.rank}`);
                    });

                    const rankCounts = {};
                    uniqueRanks.forEach(item => {
                        const parts = item.split('|');
                        const rankStr = parts[1]; // "1", "2", "-" 등
                        const rankNum = parseInt(rankStr);

                        if (!isNaN(rankNum)) {
                            rankCounts[rankNum] = (rankCounts[rankNum] || 0) + 1;
                        }
                    });

                    // 통계 배지 생성 (시각적 표현)
                    const ranks = Object.keys(rankCounts).map(Number).sort((a, b) => a - b);
                    let badgesHtml = '';

                    ranks.forEach(rank => {
                        const count = rankCounts[rank];
                        let bgColor, textColor, icon;

                        if (rank === 1) {
                            bgColor = 'bg-yellow-400';
                            textColor = 'text-yellow-900';
                            icon = '🥇';
                        } else if (rank === 2) {
                            bgColor = 'bg-gray-300';
                            textColor = 'text-gray-800';
                            icon = '🥈';
                        } else if (rank === 3) {
                            bgColor = 'bg-orange-400';
                            textColor = 'text-orange-900';
                            icon = '🥉';
                        } else {
                            bgColor = 'bg-blue-100';
                            textColor = 'text-blue-800';
                            icon = `${rank}위`;
                        }

                        badgesHtml += `<span class="inline-flex items-center gap-1 ${bgColor} ${textColor} px-2.5 py-1 rounded-full text-sm font-bold ml-1">${icon} ${count}</span>`;
                    });

                    detailTitle.innerHTML = `
                        <span class="inline-flex items-center gap-2 flex-wrap">
                            <span class="bg-green-600 text-white px-3 py-1 rounded-lg text-lg font-bold">${player.name}</span>
                            <span class="bg-blue-600 text-white px-2.5 py-1 rounded-full text-sm font-bold">🏆 ${tournamentCount}대회</span>
                            <span class="bg-gray-700 text-white px-2.5 py-1 rounded-full text-sm font-bold">⛳ ${player.roundCount}경기</span>
                            ${badgesHtml}
                        </span>
                    `;
                    detailCardsContainer.innerHTML = '';

                    if (player.rounds.length === 0) {
                        detailCardsContainer.innerHTML = '<div class="col-span-full text-center text-gray-500 py-8">기록 없음</div>';
                    } else {
                        // 대회별 옅은 배경 팔레트
                        const tournamentTints = [
                            'bg-blue-50',
                            'bg-amber-50',
                            'bg-emerald-50',
                            'bg-rose-50',
                            'bg-violet-50',
                            'bg-cyan-50',
                        ];

                        // 대회 단위로 그룹화 (tournamentId 없으면 region 사용)
                        const groupsMap = new Map();
                        player.rounds.forEach(r => {
                            const key = r.tournamentId !== undefined ? r.tournamentId : r.region;
                            if (!groupsMap.has(key)) groupsMap.set(key, []);
                            groupsMap.get(key).push(r);
                        });

                        // 그룹 내부는 날짜 내림차순, 그룹 자체도 그룹 내 최신 날짜 내림차순
                        const groups = Array.from(groupsMap.values())
                            .map(rounds => rounds.slice().sort((a, b) => new Date(b.date) - new Date(a.date)))
                            .sort((a, b) => new Date(b[0].date) - new Date(a[0].date));

                        groups.forEach((rounds, gIdx) => {
                            const tint = tournamentTints[gIdx % tournamentTints.length];

                            rounds.forEach(round => {
                                const card = document.createElement('div');
                                card.className = `round-card ${tint} border border-gray-200 rounded-xl p-4 hover:shadow-lg hover:border-blue-200 transition-all duration-300`;
                            card.dataset.region = round.region || '';
                            card.dataset.date = round.date;
                            card.dataset.course = round.course;

                            const dailyRank = calculateDailyRank(round.region || '', round.date, round.course, round.score);
                            const isGoodScore = round.score <= 72;
                            const tourRankText = round.rank && !isNaN(parseInt(round.rank)) ? `${round.rank}위` : (round.rank || '-');

                            // 순위별 배지 스타일
                            let rankBadgeClass = 'bg-gray-100 text-gray-700';
                            if (dailyRank === 1) {
                                rankBadgeClass = 'bg-yellow-400 text-yellow-900';
                            } else if (dailyRank === 2) {
                                rankBadgeClass = 'bg-gray-300 text-gray-800';
                            } else if (dailyRank === 3) {
                                rankBadgeClass = 'bg-orange-400 text-orange-900';
                            }

                            card.innerHTML = `
                                <div class="flex justify-between items-start mb-3">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span class="region-cell inline-flex items-center gap-1.5 text-blue-600 font-bold cursor-pointer hover:text-blue-800 transition-colors">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            </svg>
                                            ${round.region || '-'}
                                        </span>
                                        <span class="text-sm text-gray-600">(종합순위:${tourRankText})</span>
                                    </div>
                                    <span class="rank-cell ${rankBadgeClass} px-2.5 py-1 rounded-full text-sm font-bold cursor-pointer hover:scale-105 transition-transform">
                                        ${dailyRank}위
                                    </span>
                                </div>
                                <div class="space-y-2 text-sm text-gray-600 mb-3">
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        <span>${round.date}</span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                        <span class="truncate">${round.course}</span>
                                    </div>
                                </div>
                                <div class="flex justify-center pt-2 border-t border-gray-100">
                                    <span class="text-2xl font-bold ${isGoodScore ? 'text-red-500' : 'text-gray-800'}">
                                        ${round.score}<span class="text-base font-normal text-gray-500 ml-1">타</span>
                                    </span>
                                </div>
                            `;
                            detailCardsContainer.appendChild(card);
                            });

                            // 한 대회 라운드 수가 홀수이면 sm 이상 화면에서 우측 한 칸을 비워 다음 대회가 새 행에서 시작되도록 함
                            if (rounds.length % 2 === 1) {
                                const filler = document.createElement('div');
                                filler.className = 'hidden sm:block';
                                filler.setAttribute('aria-hidden', 'true');
                                detailCardsContainer.appendChild(filler);
                            }
                        });
                    }

                    detailSection.classList.remove('hidden');
                    if (scroll) detailSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }

                function calculateDailyRank(region, date, course, myScore) {
                    const scores = [];
                    allPlayers.forEach(p => {
                        const round = p.rounds.find(r => 
                            (r.region || '').trim() === region.trim() &&
                            r.date.trim() === date.trim() && 
                            r.course.trim() === course.trim()
                        );
                        if (round) scores.push(round.score);
                    });
                    scores.sort((a, b) => a - b);
                    return scores.indexOf(myScore) + 1;
                }

                function getRoundParticipants(region, date, course) {
                    const participants = [];
                    allPlayers.forEach(p => {
                        const round = p.rounds.find(r =>
                            (r.region || '').trim() === region.trim() &&
                            r.date.trim() === date.trim() &&
                            r.course.trim() === course.trim()
                        );
                        if (round) {
                            participants.push({
                                name: p.name,
                                score: round.score,
                                tourRank: round.rank // 투어 순위 (원본 데이터)
                            });
                        }
                    });
                    // 기본은 스코어 순 정렬
                    participants.sort((a, b) => a.score - b.score);

                    // 공동 순위 계산: 나보다 낮은 스코어 개수 + 1
                    const scores = participants.map(p => p.score);
                    return participants.map(p => ({
                        ...p,
                        rank: scores.filter(s => s < p.score).length + 1
                    }));
                }

                function showTooltip(e, participants, title = '🏌️‍♂️ 해당 라운드 순위', useTourRank = false) {
                    if (tooltipTitle) tooltipTitle.textContent = title;
                    
                    // 표시할 데이터 복사
                    let displayParticipants = [...participants];

                    // 투어 순위 모드면 투어 순위 기준으로 정렬
                    if (useTourRank) {
                        displayParticipants.sort((a, b) => {
                            // 숫자가 아닌 경우(예: -) 뒤로 보냄
                            const rankA = parseInt(a.tourRank) || 999;
                            const rankB = parseInt(b.tourRank) || 999;
                            return rankA - rankB;
                        });
                    }

                    let html = '';
                    // 레이아웃 설정: 투어 순위 모드일 때는 2열 (순위, 이름), 기본 모드는 3열 (순위, 이름, 점수)
                    const gridClass = useTourRank ? 'grid-cols-[30px_1fr]' : 'grid-cols-[24px_1fr_30px]';

                    displayParticipants.forEach(p => {
                        // 표시할 순위 값 결정
                        const rankValue = useTourRank ? (p.tourRank || '-') : p.rank;
                        const rankNum = parseInt(rankValue);
                        const rankClass = rankNum === 1 ? 'rank-1' : (rankNum === 2 ? 'rank-2' : (rankNum === 3 ? 'rank-3' : ''));
                        
                        // 점수 표시 여부 (투어 순위 모드에서는 제외)
                        const scoreHtml = useTourRank ? '' : `<span class="font-bold text-gray-900 text-right">${p.score}</span>`;

                        html += `
                            <div class="grid ${gridClass} gap-x-3 items-center py-1.5 border-b border-gray-100 last:border-0 whitespace-nowrap min-w-[150px]">
                                <span class="rank-badge ${rankClass}">${rankValue}</span>
                                <span class="font-medium text-gray-800 text-left">${p.name}</span>
                                ${scoreHtml}
                            </div>
                        `;
                    });
                    tooltipContent.innerHTML = html;

                    tooltip.classList.remove('hidden');
                    setTimeout(() => tooltip.classList.remove('opacity-0'), 10);

                    // 위치 계산
                    const tooltipWidth = tooltip.offsetWidth;
                    const windowWidth = window.innerWidth;
                    const mouseX = e.clientX;
                    const mouseY = e.clientY;
                    
                    let left = mouseX + 15; // 기본: 마우스 오른쪽
                    
                    // 화면 오른쪽을 벗어나는 경우 왼쪽으로 배치
                    if (left + tooltipWidth > windowWidth - 10) { // 10px 여백
                        left = mouseX - tooltipWidth - 15;
                    }

                    // 왼쪽으로 배치했을 때 화면 왼쪽을 벗어나는 경우 (너무 좁은 화면 등) 조정
                    if (left < 10) {
                        left = 10;
                    }

                    const top = mouseY + 15; // 마우스 아래쪽

                    tooltip.style.top = `${top}px`;
                    tooltip.style.left = `${left}px`;
                }

                function hideTooltip() {
                    tooltip.classList.add('opacity-0');
                    setTimeout(() => tooltip.classList.add('hidden'), 200);
                }
            });
        </script>
	</body>
</html>

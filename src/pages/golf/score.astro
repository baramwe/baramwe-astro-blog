---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`골프 스코어 분석 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	</head>
	<body>
		<Header />
		<main class="w-full max-w-4xl mx-auto px-4 py-8">
            <h1 class="text-3xl font-bold text-center mb-8 flex justify-center items-center gap-2">
                ⛳️ 골프 스코어 분석
                <span class="relative inline-block ml-2">
                    <select id="year-select" class="appearance-none bg-transparent border-b-2 border-gray-800 text-3xl font-bold text-blue-600 focus:outline-none cursor-pointer py-0 pr-8">
                        <!-- 옵션은 동적으로 채워집니다 -->
                        <option>Loading...</option>
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700">
                        <svg class="fill-current h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
                    </div>
                </span>
            </h1>
            
            <!-- 차트 섹션 -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
                <h2 class="text-xl font-bold mb-4">🏆 선수별 평균 스코어</h2>
                <div class="relative h-[400px] w-full flex items-center justify-center">
                    <p class="text-gray-500" id="loading-text">데이터를 불러오는 중입니다...</p>
                    <canvas id="scoreChart"></canvas>
                </div>
            </div>

            <!-- 통계 테이블 섹션 -->
            <div class="overflow-x-auto bg-white rounded-xl shadow-lg p-6 mb-8 hidden" id="stats-container">
                <h2 class="text-xl font-bold mb-4">📊 선수별 상세 통계</h2>
                <p class="text-sm text-gray-500 mb-4">* 선수를 클릭하면 상세 라운드 기록을 볼 수 있습니다.</p>
                <table class="w-full text-sm text-left text-gray-500">
                    <thead class="text-xs text-white uppercase bg-green-600">
                        <tr>
                            <th scope="col" class="px-6 py-3">순위</th>
                            <th scope="col" class="px-6 py-3">이름</th>
                            <th scope="col" class="px-6 py-3 text-center">핸디캡</th>
                            <th scope="col" class="px-6 py-3 text-center">평균 타수</th>
                            <th scope="col" class="px-6 py-3 text-center">베스트</th>
                            <th scope="col" class="px-6 py-3 text-center">라운드 수</th>
                        </tr>
                    </thead>
                    <tbody id="stats-table-body">
                        <!-- 데이터가 여기에 추가됩니다 -->
                    </tbody>
                </table>
            </div>

            <!-- 상세 기록 섹션 (히든) -->
            <div id="detail-section" class="hidden bg-white rounded-xl shadow-lg p-6 fade-in">
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-xl font-bold flex-1 mr-4 break-keep" id="detail-title">선수 상세 기록</h2>
                    <button id="close-detail" class="text-gray-500 hover:text-gray-700 flex-shrink-0 mt-1">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left text-gray-500">
                        <thead class="text-xs text-gray-700 uppercase bg-gray-100">
                            <tr>
                                <th scope="col" class="px-6 py-3">지역</th>
                                <th scope="col" class="px-6 py-3">날짜</th>
                                <th scope="col" class="px-6 py-3">골프장</th>
                                <th scope="col" class="px-6 py-3 text-center">스코어</th>
                                <th scope="col" class="px-6 py-3 text-center">순위</th>
                            </tr>
                        </thead>
                        <tbody id="detail-table-body">
                            <!-- 상세 데이터 -->
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- 툴팁 팝업 (동반 플레이어 정보) -->
            <div id="hover-tooltip" class="fixed hidden z-50 bg-white rounded-lg shadow-xl border border-gray-200 p-4 min-w-[200px] transform transition-opacity duration-200 opacity-0">
                <h3 id="tooltip-title" class="text-sm font-bold text-gray-900 mb-2 border-b pb-1">🏌️‍♂️ 해당 라운드 순위</h3>
                <div id="tooltip-content" class="text-xs">
                    <!-- 내용이 동적으로 들어갑니다 -->
                </div>
            </div>
		</main>
		<Footer />

        <style>
            .fade-in {
                animation: fadeIn 0.3s ease-in;
            }
            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(10px); }
                to { opacity: 1; transform: translateY(0); }
            }
            tr.selected-row {
                background-color: #dcfce7 !important; /* bg-green-100 */
                border-left: 4px solid #16a34a !important; /* border-green-600 */
            }
            tr.cursor-pointer:hover {
                background-color: #f0fdf4; /* bg-green-50 */
            }
            /* 툴팁용 스타일 */
            .tooltip-row {
                display: flex;
                justify-content: space-between;
                padding: 4px 0;
                border-bottom: 1px solid #f3f4f6;
            }
            .tooltip-row:last-child {
                border-bottom: none;
            }
            .rank-badge {
                display: inline-block;
                width: 20px;
                text-align: center;
                font-weight: bold;
            }
            .rank-1 { color: #eab308; } /* 1등 금색 */
            .rank-2 { color: #94a3b8; } /* 2등 은색 */
            .rank-3 { color: #b45309; } /* 3등 동색 */
        </style>

        <script>
            document.addEventListener('DOMContentLoaded', async () => {
                const ctx = document.getElementById('scoreChart');
                const loadingText = document.getElementById('loading-text');
                const statsContainer = document.getElementById('stats-container');
                const tableBody = document.getElementById('stats-table-body');
                const detailSection = document.getElementById('detail-section');
                const detailTitle = document.getElementById('detail-title');
                const detailTableBody = document.getElementById('detail-table-body');
                const closeDetailBtn = document.getElementById('close-detail');
                const tooltip = document.getElementById('hover-tooltip');
                const tooltipContent = document.getElementById('tooltip-content');
                const tooltipTitle = document.getElementById('tooltip-title');
                const yearSelect = document.getElementById('year-select');

                let allPlayers = [];
                let chartInstance = null;

                // 데이터 로드 함수
                async function loadData(sheetName = '') {
                    try {
                        // 로딩 상태 표시
                        loadingText.style.display = 'block';
                        loadingText.innerText = '데이터를 불러오는 중입니다...';
                        statsContainer.classList.add('hidden');
                        detailSection.classList.add('hidden');
                        hideTooltip();
                        
                        // 차트 캔버스 초기화 (잔상 제거)
                        if (chartInstance) {
                            chartInstance.destroy();
                            chartInstance = null;
                        }

                        const url = sheetName ? `/api/golf-data?sheetName=${encodeURIComponent(sheetName)}` : '/api/golf-data';
                        const response = await fetch(url);
                        const result = await response.json();

                        if (!result.success) throw new Error(result.message || '데이터 로드 실패');

                        // 시트 목록 업데이트 (최초 1회 또는 필요시)
                        if (yearSelect.options.length <= 1 && result.sheets) {
                            yearSelect.innerHTML = '';
                            result.sheets.forEach(sheet => {
                                const option = document.createElement('option');
                                option.value = sheet;
                                option.textContent = sheet;
                                if (sheet === result.currentSheet) {
                                    option.selected = true;
                                }
                                yearSelect.appendChild(option);
                            });
                        }

                        // 선택된 값 동기화 (API가 반환한 실제 시트명으로)
                        if (result.currentSheet) {
                            yearSelect.value = result.currentSheet;
                        }

                        allPlayers = result.playerStats;
                        
                        loadingText.style.display = 'none';
                        statsContainer.classList.remove('hidden');
                        tableBody.innerHTML = ''; // 기존 테이블 초기화

                        // 테이블 렌더링
                        allPlayers.forEach((player, index) => {
                            const row = document.createElement('tr');
                            row.className = 'bg-white border-b transition-colors duration-200 cursor-pointer border-l-4 border-transparent';
                            
                            row.innerHTML = `
                                <td class="px-6 py-4 font-medium">${index + 1}</td>
                                <td class="px-6 py-4 font-bold text-gray-900">${player.name}</td>
                                <td class="px-6 py-4 text-center font-bold text-blue-600">${player.handicap > 0 ? '+' : ''}${player.handicap}</td>
                                <td class="px-6 py-4 text-center">${player.averageScore}</td>
                                <td class="px-6 py-4 text-center text-green-600 font-bold">${player.bestScore}</td>
                                <td class="px-6 py-4 text-center">${player.roundCount}</td>
                            `;

                            row.addEventListener('click', () => {
                                // 선택 스타일 토글
                                document.querySelectorAll('#stats-table-body tr').forEach(r => {
                                    r.classList.remove('selected-row', 'bg-green-100', 'border-green-600');
                                    r.classList.add('bg-white', 'border-transparent');
                                });
                                row.classList.add('selected-row', 'bg-green-100', 'border-green-600');
                                row.classList.remove('bg-white', 'border-transparent');

                                // 상세 정보 렌더링
                                renderDetails(player);
                            });

                            tableBody.appendChild(row);
                        });

                        // 차트 렌더링
                        chartInstance = new Chart(ctx, {
                            type: 'bar',
                            data: {
                                labels: allPlayers.map(p => p.name),
                                datasets: [{
                                    label: '평균 스코어',
                                    data: allPlayers.map(p => p.averageScore),
                                    backgroundColor: 'rgba(34, 197, 94, 0.6)', // Green
                                    borderColor: 'rgba(34, 197, 94, 1)',
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: {
                                    legend: { display: false },
                                    title: { display: true, text: '선수별 평균 스코어' }
                                },
                                scales: {
                                    y: {
                                        beginAtZero: false,
                                        min: 70,
                                        title: { display: true, text: '타수' }
                                    }
                                }
                            }
                        });

                    } catch (error) {
                        console.error(error);
                        loadingText.innerText = '오류 발생: ' + error.message;
                        loadingText.classList.add('text-red-500');
                    }
                }

                // 초기 로드
                loadData();

                // 연도 변경 이벤트
                yearSelect.addEventListener('change', (e) => {
                    loadData(e.target.value);
                });

                // 이벤트 위임: 툴팁 표시 (클릭 시)
                detailTableBody.addEventListener('click', (e) => {
                    const rankTarget = e.target.closest('.rank-cell');
                    const regionTarget = e.target.closest('.region-cell');
                    
                    if (!rankTarget && !regionTarget) return;

                    // 버블링 방지
                    e.stopPropagation();

                    const tr = (rankTarget || regionTarget).closest('tr');
                    if (!tr || !tr.dataset.date || !tr.dataset.course) return;

                    const region = tr.dataset.region || '';
                    const date = tr.dataset.date;
                    const course = tr.dataset.course;

                    const participants = getRoundParticipants(region, date, course);
                    
                    let title = '🏌️‍♂️ 해당 라운드 순위';
                    let useTourRank = false;

                    if (regionTarget) {
                        title = `🏆 ${region} 종합 순위`;
                        useTourRank = true;
                    }

                    showTooltip(e, participants, title, useTourRank);
                });

                // 문서 전체 클릭 시 툴팁 닫기
                document.addEventListener('click', (e) => {
                    const target = e.target;
                    if (!tooltip.contains(target) && !target.closest('.rank-cell')) {
                        hideTooltip();
                    }
                });

                // 상세 닫기 버튼
                closeDetailBtn.addEventListener('click', () => {
                    detailSection.classList.add('hidden');
                    document.querySelectorAll('#stats-table-body tr').forEach(r => r.classList.remove('selected-row', 'bg-green-100', 'border-green-600'));
                    hideTooltip();
                });

                function renderDetails(player) {
                    // 순위 집계 (대회 단위 중복 제거)
                    // tournamentId + rank 조합으로 고유한 대회 기록만 추출
                    const uniqueRanks = new Set();
                    player.rounds.forEach(r => {
                        // tournamentId가 있으면 사용, 없으면 region 사용 (호환성)
                        const key = r.tournamentId !== undefined ? r.tournamentId : r.region;
                        uniqueRanks.add(`${key}|${r.rank}`);
                    });

                    const rankCounts = {};
                    uniqueRanks.forEach(item => {
                        const parts = item.split('|');
                        const rankStr = parts[1]; // "1", "2", "-" 등
                        const rankNum = parseInt(rankStr);
                        
                        if (!isNaN(rankNum)) {
                            rankCounts[rankNum] = (rankCounts[rankNum] || 0) + 1;
                        }
                    });

                    // 통계 텍스트 생성 (모든 순위 표시)
                    const ranks = Object.keys(rankCounts).map(Number).sort((a, b) => a - b);
                    const statsParts = [];
                    
                    ranks.forEach(rank => {
                        const label = rank === 1 ? '우승' : (rank === 2 ? '준우승' : `${rank}위`);
                        statsParts.push(`${label}: ${rankCounts[rank]}회`);
                    });

                    let statsStr = '';
                    if (statsParts.length > 0) {
                        statsStr = ' - ' + statsParts.join(', ');
                    }

                    detailTitle.textContent = `${player.name} 라운드 기록 (${player.roundCount}전)${statsStr}`;
                    detailTableBody.innerHTML = '';

                    if (player.rounds.length === 0) {
                        detailTableBody.innerHTML = '<tr><td colspan="5" class="p-4 text-center">기록 없음</td></tr>';
                    } else {
                        // 날짜 내림차순 정렬 (최신순)
                        const sortedRounds = [...player.rounds].sort((a, b) => {
                            const dateA = new Date(a.date).getTime();
                            const dateB = new Date(b.date).getTime();
                            return dateB - dateA; // 내림차순
                        });

                        sortedRounds.forEach(round => {
                            const tr = document.createElement('tr');
                            tr.className = 'bg-white border-b hover:bg-gray-50';
                            tr.dataset.region = round.region || '';
                            tr.dataset.date = round.date;
                            tr.dataset.course = round.course;
                            
                            const scoreClass = round.score <= 72 ? 'text-red-600 font-bold' : '';
                            const dailyRank = calculateDailyRank(round.region || '', round.date, round.course, round.score);

                            tr.innerHTML = `
                                <td class="px-6 py-4 font-bold text-blue-600 cursor-pointer hover:text-blue-800 transition-colors region-cell">${round.region || '-'}</td>
                                <td class="px-6 py-4">${round.date}</td>
                                <td class="px-6 py-4">${round.course}</td>
                                <td class="px-6 py-4 text-center ${scoreClass}">${round.score}</td>
                                <td class="px-6 py-4 text-center font-bold text-blue-600 cursor-pointer hover:text-blue-800 transition-colors rank-cell relative">
                                    ${dailyRank}위
                                </td>
                            `;
                            detailTableBody.appendChild(tr);
                        });
                    }

                    detailSection.classList.remove('hidden');
                    detailSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }

                function calculateDailyRank(region, date, course, myScore) {
                    const scores = [];
                    allPlayers.forEach(p => {
                        const round = p.rounds.find(r => 
                            (r.region || '').trim() === region.trim() &&
                            r.date.trim() === date.trim() && 
                            r.course.trim() === course.trim()
                        );
                        if (round) scores.push(round.score);
                    });
                    scores.sort((a, b) => a - b);
                    return scores.indexOf(myScore) + 1;
                }

                function getRoundParticipants(region, date, course) {
                    const participants = [];
                    allPlayers.forEach(p => {
                        const round = p.rounds.find(r => 
                            (r.region || '').trim() === region.trim() &&
                            r.date.trim() === date.trim() && 
                            r.course.trim() === course.trim()
                        );
                        if (round) {
                            participants.push({
                                name: p.name,
                                score: round.score,
                                tourRank: round.rank // 투어 순위 (원본 데이터)
                            });
                        }
                    });
                    // 기본은 스코어 순 정렬
                    participants.sort((a, b) => a.score - b.score);
                    return participants.map((p, i) => ({
                        ...p,
                        rank: i + 1 // 경기 순위 (스코어 기준 계산)
                    }));
                }

                function showTooltip(e, participants, title = '🏌️‍♂️ 해당 라운드 순위', useTourRank = false) {
                    if (tooltipTitle) tooltipTitle.textContent = title;
                    
                    // 표시할 데이터 복사
                    let displayParticipants = [...participants];

                    // 투어 순위 모드면 투어 순위 기준으로 정렬
                    if (useTourRank) {
                        displayParticipants.sort((a, b) => {
                            // 숫자가 아닌 경우(예: -) 뒤로 보냄
                            const rankA = parseInt(a.tourRank) || 999;
                            const rankB = parseInt(b.tourRank) || 999;
                            return rankA - rankB;
                        });
                    }

                    let html = '';
                    // 레이아웃 설정: 투어 순위 모드일 때는 2열 (순위, 이름), 기본 모드는 3열 (순위, 이름, 점수)
                    const gridClass = useTourRank ? 'grid-cols-[30px_1fr]' : 'grid-cols-[24px_1fr_30px]';

                    displayParticipants.forEach(p => {
                        // 표시할 순위 값 결정
                        const rankValue = useTourRank ? (p.tourRank || '-') : p.rank;
                        const rankNum = parseInt(rankValue);
                        const rankClass = rankNum === 1 ? 'rank-1' : (rankNum === 2 ? 'rank-2' : (rankNum === 3 ? 'rank-3' : ''));
                        
                        // 점수 표시 여부 (투어 순위 모드에서는 제외)
                        const scoreHtml = useTourRank ? '' : `<span class="font-bold text-gray-900 text-right">${p.score}</span>`;

                        html += `
                            <div class="grid ${gridClass} gap-x-3 items-center py-1.5 border-b border-gray-100 last:border-0 whitespace-nowrap min-w-[150px]">
                                <span class="rank-badge ${rankClass}">${rankValue}</span>
                                <span class="font-medium text-gray-800 text-left">${p.name}</span>
                                ${scoreHtml}
                            </div>
                        `;
                    });
                    tooltipContent.innerHTML = html;

                    tooltip.classList.remove('hidden');
                    setTimeout(() => tooltip.classList.remove('opacity-0'), 10);

                    // 위치 계산
                    const tooltipWidth = tooltip.offsetWidth;
                    const windowWidth = window.innerWidth;
                    const mouseX = e.clientX;
                    const mouseY = e.clientY;
                    
                    let left = mouseX + 15; // 기본: 마우스 오른쪽
                    
                    // 화면 오른쪽을 벗어나는 경우 왼쪽으로 배치
                    if (left + tooltipWidth > windowWidth - 10) { // 10px 여백
                        left = mouseX - tooltipWidth - 15;
                    }

                    // 왼쪽으로 배치했을 때 화면 왼쪽을 벗어나는 경우 (너무 좁은 화면 등) 조정
                    if (left < 10) {
                        left = 10;
                    }

                    const top = mouseY + 15; // 마우스 아래쪽

                    tooltip.style.top = `${top}px`;
                    tooltip.style.left = `${left}px`;
                }

                function hideTooltip() {
                    tooltip.classList.add('opacity-0');
                    setTimeout(() => tooltip.classList.add('hidden'), 200);
                }
            });
        </script>
	</body>
</html>

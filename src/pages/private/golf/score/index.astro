---
import GolfLayout from '../../../../layouts/GolfLayout.astro'
import RoundList from '../../../../components/golf/RoundList.astro'
import YearChips from '../../../../components/golf/YearChips.astro'
import Dropdown from '../../../../components/golf/Dropdown.astro'
import { getDB } from '../../../../lib/auth/db'
import { countryFlag, countryName, homeSummary, listRoundYears, listRounds, parseRoundSort, periodSummary, type RoundSort } from '../../../../lib/golf/repo'
export const prerender = false

const userId = Astro.locals.golf!.user.id
const db = getDB(Astro.locals, Astro.request)!
const year = String(new Date().getFullYear())

// ?y=all | YYYY  — 없으면 '최근 라운드' 10개
const yParam = Astro.url.searchParams.get('y')
const selected = yParam === 'all' || /^\d{4}$/.test(yParam ?? '') ? yParam! : null
const filterYear = selected && selected !== 'all' ? selected : undefined
// ?s=new(기본)|old|best|worst — 연도/전체 목록에서만 사용
const sort = selected ? parseRoundSort(Astro.url.searchParams.get('s')) : 'new'

const [summary, years, periodRounds, period] = await Promise.all([
  homeSummary(db, userId, year),
  listRoundYears(db, userId),
  listRounds(db, userId, selected ? 2000 : 10, filterYear, sort),
  selected ? periodSummary(db, userId, filterYear) : Promise.resolve(null),
])

// ?c=JP — 연도/전체 목록에서 해외 국가별로 좁혀 보기 (한국 외 국가만 칩으로 노출)
const countries = selected
  ? [...new Set(periodRounds.map((r) => r.country_code))]
      .filter((c) => countryFlag(c))
      .map((code) => ({ code, flag: countryFlag(code), name: countryName(code), count: periodRounds.filter((r) => r.country_code === code).length }))
      .sort((a, b) => b.count - a.count)
  : []
const cParam = Astro.url.searchParams.get('c')?.toUpperCase() ?? null
const country = countries.find((c) => c.code === cParam)?.code ?? null
const rounds = country ? periodRounds.filter((r) => r.country_code === country) : periodRounds

// 상단 카드: 연도/전체 선택 시 그 기간 기준, 미선택이면 아래 목록(최근 10개) 기준
const prefix = selected === 'all' ? '전체' : (selected ?? year)
// 최근 목록 중 18홀 + 본인 스코어가 있는 라운드만 평균·베스트에 쓴다 (periodSummary 와 같은 기준)
const recentFull = rounds.filter((r) => r.back_course != null && r.my_total != null)
const recentBest = recentFull.reduce<(typeof recentFull)[number] | null>(
  (b, r) => (!b || r.my_total! < b.my_total! ? r : b), // 동타면 먼저 나온(최신) 라운드
  null,
)
const stats = period
  ? [
      { label: `${prefix} 라운드`, value: period.rounds ?? 0 },
      { label: `${prefix} 평균`, value: period.avg ?? '-' },
      { label: `${prefix} 베스트`, value: period.best ?? '-', sub: period.best_on ?? '' },
    ]
  : [
      { label: '최근 라운드', value: rounds.length },
      {
        label: '최근 평균',
        value: recentFull.length
          ? Math.round((recentFull.reduce((s, r) => s + r.my_total!, 0) / recentFull.length) * 10) / 10
          : '-',
      },
      { label: '최근 베스트', value: recentBest?.my_total ?? '-', sub: recentBest?.played_on ?? '' },
    ]
const periodLabel = selected === 'all' ? '전체 기록' : `${selected}년`
const SORTS: { key: RoundSort; label: string }[] = [
  { key: 'new', label: '최신순' },
  { key: 'old', label: '시간순' },
  { key: 'best', label: 'BEST' },
  { key: 'worst', label: 'WORST' },
]
const listHref = (s: RoundSort, c: string | null) =>
  `/private/golf/score?y=${selected}${s === 'new' ? '' : `&s=${s}`}${c ? `&c=${c}` : ''}`
const sortHref = (k: RoundSort) => listHref(k, country)
---
<GolfLayout title="홈" active="home">
  <section id="stats" class="grid grid-cols-3 gap-2 mb-5">
    {stats.map((s) => (
      <div class="g-card text-center !p-3">
        <div class="text-xs font-medium text-kb-subdued">{s.label}</div>
        <div class="text-2xl font-semibold tabular-nums text-kb-title mt-1">{s.value}</div>
        {s.sub && <div class="text-[11px] text-kb-muted">{s.sub}</div>}
      </div>
    ))}
  </section>
  <p class="text-[11px] text-kb-muted -mt-3 mb-3">평균·베스트는 18홀 라운드 기준</p>

  {years.length > 0 && <YearChips years={years} selected={selected} total={summary.rounds} sort={sort} />}

  <section id="rounds" class="scroll-mt-28">
    {period ? (
      <>
      <div class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-2">
        <h2 class="shrink-0 text-lg font-semibold">
          <a href={listHref(sort, null)} class="transition hover:text-kb-primary-hover">{periodLabel}</a>
        </h2>
        {countries.length > 0 && (
          <Dropdown
            ariaLabel="국가별로 보기"
            label={country ? (countries.find((c) => c.code === country)?.name ?? '모든 국가') : '모든 국가'}
            highlight={!!country}
            items={[
              { href: listHref(sort, null), label: '모든 국가', current: !country },
              ...countries.map((c) => ({ href: listHref(sort, c.code), label: c.name, count: c.count, current: country === c.code })),
            ]}
          />
        )}
        <div class="ml-auto">
          <Dropdown
            ariaLabel="정렬"
            align="right"
            itemClass="round-sort"
            label={SORTS.find((o) => o.key === sort)?.label ?? '최신순'}
            highlight={sort !== 'new'}
            items={SORTS.map((o) => ({ href: sortHref(o.key), label: o.label, current: sort === o.key }))}
          />
        </div>
      </div>
      {(sort === 'best' || sort === 'worst') && period.full_rounds !== period.rounds && (
        <p class="-mt-1 mb-2 text-[11px] text-kb-muted">18홀 라운드 먼저, 9홀은 뒤에 표시</p>
      )}
      </>
    ) : (
      <div class="flex items-center justify-between mb-2">
        <h2 class="font-semibold">최근 라운드</h2>
        {summary.rounds > 10 && <a href="/private/golf/score/rounds" class="text-sm text-kb-primary">전체 {summary.rounds}개 →</a>}
      </div>
    )}

    {rounds.length === 0 ? (
      <div class="g-card text-center text-sm text-kb-text space-y-3">
        <p>아직 기록이 없어요.</p>
        <a href="/private/golf/score/rounds/new" class="g-btn inline-block">첫 라운드 입력하기</a>
      </div>
    ) : (
      <RoundList rounds={rounds} />
    )}
  </section>

  <script>
    // 국가·정렬 드롭다운(details): 바깥을 누르거나 Esc 면 닫기. #rounds 가 교체돼도 동작하도록 document 에 위임
    const closeDropdowns = (except?: Element | null) =>
      document.querySelectorAll<HTMLDetailsElement>('details.g-dropdown[open]').forEach((d) => { if (d !== except) d.open = false })
    document.addEventListener('click', (e) => closeDropdowns((e.target as Element | null)?.closest('details.g-dropdown')))
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDropdowns() })
  </script>
</GolfLayout>

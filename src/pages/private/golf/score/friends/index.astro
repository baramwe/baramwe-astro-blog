---
import GolfLayout from '../../../../../layouts/GolfLayout.astro'
import BuddyRecord from '../../../../../components/golf/BuddyRecord.astro'
import { getDB } from '../../../../../lib/auth/db'
import { listBuddies } from '../../../../../lib/golf/repo'
export const prerender = false

const ownerId = Astro.locals.golf!.user.id
const db = getDB(Astro.locals, Astro.request)!
const [buddies, self] = await Promise.all([
  listBuddies(db, ownerId, 2), // 조인 등 1회 동반자는 제외
  db.prepare(`SELECT display_name FROM golf_players WHERE owner_user_id = ? AND is_self = 1`).bind(ownerId).first<{ display_name: string }>(),
])
const selfName = self?.display_name ?? '나'
const winRate = (b: { wins: number; losses: number; draws: number }) =>
  Math.round((b.wins / (b.wins + b.losses + b.draws || 1)) * 100)
---
<GolfLayout title="골친" active="friends">
  <div class="mb-7 border-b border-[#d9d8d1] pb-4">
    <h1 class="font-serif text-3xl font-bold tracking-[-.05em]">골친</h1>
    <p class="mt-1 text-sm leading-relaxed text-[#73766f]">2라운드 이상 함께한 동반자 · 많이 함께한 순 · 같은 라운드에서 타수가 적으면 승</p>
  </div>

  {buddies.length === 0 ? (
    <p class="border-y border-[#d9d8d1] py-10 text-center text-sm text-[#73766f]">아직 동반자와 함께 기록한 라운드가 없어요.</p>
  ) : (
    <ol class="border-t border-[#d9d8d1]">
      {buddies.map((b, i) => (
        <li class="border-b border-[#d9d8d1]">
          <a href={`/private/golf/score/friends/${b.id}`} class="group block py-5 transition-colors hover:bg-[#eeece5]">
            <div class="mb-4 flex items-center gap-3">
              <span
                class:list={[
                  'g-data flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-[#d9d8d1] text-sm font-bold text-[#53564f] transition-colors group-hover:border-[#176d50] group-hover:text-[#176d50]',
                ]}
              >{i + 1}</span>
              <div class="min-w-0 flex-1">
                <div class="truncate text-[18px] font-bold tracking-[-.025em]">{b.display_name}</div>
                <div class="g-data text-[11px] text-[#73766f]">{b.rounds}라운드 함께 · 최근 {b.last_on}</div>
              </div>
              <div class="text-right leading-none">
                <div class="text-[10px] font-bold tracking-[.08em] text-[#8a8c85]">승률</div>
                <div class="g-data mt-1 text-xl font-bold text-[#176d50]">{winRate(b)}%</div>
              </div>
            </div>

            <BuddyRecord selfName={selfName} buddyName={b.display_name} wins={b.wins} draws={b.draws} losses={b.losses} />

            {b.my_avg !== null && (
              <div class="g-data mt-3 flex justify-between border-t border-[#d9d8d1] pt-2.5 text-[11px] text-[#73766f]">
                <span>평균 <b class="font-bold text-[#20231f]">{b.my_avg}</b></span>
                <span class="text-[#8a8c85]">18홀 기준</span>
                <span>평균 <b class="font-bold text-[#20231f]">{b.their_avg}</b></span>
              </div>
            )}
          </a>
        </li>
      ))}
    </ol>
  )}
</GolfLayout>

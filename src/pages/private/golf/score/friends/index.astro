---
import GolfLayout from '../../../../../layouts/GolfLayout.astro'
import BuddyRecord from '../../../../../components/golf/BuddyRecord.astro'
import { getDB } from '../../../../../lib/auth/db'
import { listBuddies } from '../../../../../lib/golf/repo'
export const prerender = false

const ownerId = Astro.locals.golf!.user.id
const db = getDB(Astro.locals, Astro.request)!
const [buddies, self] = await Promise.all([
  listBuddies(db, ownerId, 2), // 조인 등 1회 동반자는 제외
  db.prepare(`SELECT display_name FROM golf_players WHERE owner_user_id = ? AND is_self = 1`).bind(ownerId).first<{ display_name: string }>(),
])
const selfName = self?.display_name ?? '나'
const winRate = (b: { wins: number; losses: number; draws: number }) =>
  Math.round((b.wins / (b.wins + b.losses + b.draws || 1)) * 100)
---
<GolfLayout title="골친" active="friends">
  <div class="mb-4">
    <h1 class="text-xl font-bold">골친</h1>
    <p class="text-sm text-gray-500 mt-0.5">2라운드 이상 함께한 동반자 · 많이 함께한 순 · 같은 라운드에서 타수가 적으면 승</p>
  </div>

  {buddies.length === 0 ? (
    <p class="g-card text-center text-sm text-gray-600">아직 동반자와 함께 기록한 라운드가 없어요.</p>
  ) : (
    <ol class="space-y-3">
      {buddies.map((b, i) => (
        <li>
          <a href={`/private/golf/score/friends/${b.id}`} class="g-card block !px-4 !py-4 transition hover:border-emerald-400 hover:shadow-sm">
            <div class="mb-3 flex items-center gap-3">
              <span
                class:list={[
                  'flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold tabular-nums',
                  i === 0 ? 'bg-amber-400 text-white' : i === 1 ? 'bg-gray-300 text-white' : i === 2 ? 'bg-orange-300 text-white' : 'bg-emerald-50 text-emerald-700',
                ]}
              >{i + 1}</span>
              <div class="min-w-0 flex-1">
                <div class="truncate text-[17px] font-semibold">{b.display_name}</div>
                <div class="text-[13px] text-gray-500">{b.rounds}라운드 함께 · 최근 {b.last_on}</div>
              </div>
              <div class="text-right">
                <div class="text-[11px] text-gray-400">승률</div>
                <div class="text-lg font-bold tabular-nums text-emerald-800">{winRate(b)}%</div>
              </div>
            </div>

            <BuddyRecord selfName={selfName} buddyName={b.display_name} wins={b.wins} draws={b.draws} losses={b.losses} />

            {b.my_avg !== null && (
              <div class="mt-2.5 flex justify-between text-xs text-gray-500 tabular-nums">
                <span>평균 <b class="font-semibold text-gray-700">{b.my_avg}</b></span>
                <span class="text-gray-400">18홀 기준</span>
                <span>평균 <b class="font-semibold text-gray-700">{b.their_avg}</b></span>
              </div>
            )}
          </a>
        </li>
      ))}
    </ol>
  )}
</GolfLayout>

---
import GolfLayout from '../../../../../layouts/GolfLayout.astro'
import BuddyRecord from '../../../../../components/golf/BuddyRecord.astro'
import Dropdown from '../../../../../components/golf/Dropdown.astro'
import { getDB } from '../../../../../lib/auth/db'
import { listBuddies } from '../../../../../lib/golf/repo'
export const prerender = false

const ownerId = Astro.locals.golf!.user.id
const db = getDB(Astro.locals, Astro.request)!
const [buddies, self] = await Promise.all([
  listBuddies(db, ownerId, 2), // 조인 등 1회 동반자는 제외
  db.prepare(`SELECT display_name FROM golf_players WHERE owner_user_id = ? AND is_self = 1`).bind(ownerId).first<{ display_name: string }>(),
])
const selfName = self?.display_name ?? '나'
const winRate = (b: { wins: number; losses: number; draws: number }) =>
  Math.round((b.wins / (b.wins + b.losses + b.draws || 1)) * 100)

// 정렬: 기본(골친) = 함께 친 라운드 많은 순(listBuddies 순서), 승률↑ 높은 순, 승률↓ 낮은 순
const SORTS = [
  { key: 'rounds', label: '골친' },
  { key: 'win_desc', label: '승률', arrow: 'up' },
  { key: 'win_asc', label: '승률', arrow: 'down' },
] as const
type SortKey = (typeof SORTS)[number]['key']
const sortParam = Astro.url.searchParams.get('sort')
const sort: SortKey = SORTS.some((s) => s.key === sortParam) ? (sortParam as SortKey) : 'rounds'
if (sort !== 'rounds') {
  const sign = sort === 'win_desc' ? -1 : 1
  // 승률이 같으면 함께 친 라운드 많은 순
  buddies.sort((a, b) => sign * (winRate(a) - winRate(b)) || b.rounds - a.rounds)
}
const cur = SORTS.find((s) => s.key === sort)!
const sortHref = (k: SortKey) => (k === 'rounds' ? Astro.url.pathname : `${Astro.url.pathname}?sort=${k}`)
---
<GolfLayout title="골친" active="friends">
  <div class="mb-4 flex items-center justify-between gap-3">
    <h1 class="text-xl font-bold">골친</h1>
    {buddies.length > 1 && (
      <Dropdown
        ariaLabel="골친 정렬"
        align="right"
        label={cur.label}
        labelArrow={'arrow' in cur ? cur.arrow : undefined}
        highlight={sort !== 'rounds'}
        items={SORTS.map((s) => ({ href: sortHref(s.key), label: s.label, arrow: 'arrow' in s ? s.arrow : undefined, current: s.key === sort }))}
      />
    )}
  </div>

  {buddies.length === 0 ? (
    <p class="g-card text-center text-sm text-kb-text">아직 동반자와 함께 기록한 라운드가 없어요.</p>
  ) : (
    <ol class="space-y-3">
      {buddies.map((b, i) => (
        <li>
          <a href={`/private/golf/score/friends/${b.id}`} class="g-card block !px-4 !py-4 transition hover:border-kb-primary hover:shadow-sm">
            <div class="mb-3 flex items-center gap-3">
              <span
                class:list={[
                  'flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-sm font-bold tabular-nums',
                  'bg-kb-sunken text-kb-subdued border border-kb-border',
                ]}
              >{i + 1}</span>
              <div class="min-w-0 flex-1">
                <div class="truncate text-[17px] font-semibold">{b.display_name}</div>
                <div class="text-[13px] text-kb-subdued">{b.rounds}라운드 함께 · 최근 {b.last_on}</div>
              </div>
              <div class="text-right">
                <div class="text-[11px] text-kb-muted">승률</div>
                <div class="text-lg font-bold tabular-nums text-kb-primary">{winRate(b)}%</div>
              </div>
            </div>

            <BuddyRecord selfName={selfName} buddyName={b.display_name} wins={b.wins} draws={b.draws} losses={b.losses} />

            {b.my_avg !== null && (
              <div class="mt-2.5 flex justify-between text-xs text-kb-subdued tabular-nums">
                <span>평균 <b class="font-semibold text-kb-text">{b.my_avg}</b></span>
                <span class="text-kb-muted">18홀 기준</span>
                <span>평균 <b class="font-semibold text-kb-text">{b.their_avg}</b></span>
              </div>
            )}
          </a>
        </li>
      ))}
    </ol>
  )}

  <script>
    // 드롭다운(details.g-dropdown) 바깥 클릭·Esc 로 닫기
    const closeDropdowns = (except?: Element | null) =>
      document.querySelectorAll<HTMLDetailsElement>('details.g-dropdown[open]').forEach((d) => { if (d !== except) d.open = false })
    document.addEventListener('click', (e) => closeDropdowns((e.target as Element | null)?.closest('details.g-dropdown')))
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDropdowns() })
  </script>
</GolfLayout>

---
import GolfLayout from '../../../../../layouts/GolfLayout.astro'
import BuddyRecord from '../../../../../components/golf/BuddyRecord.astro'
import Dropdown from '../../../../../components/golf/Dropdown.astro'
import { getDB } from '../../../../../lib/auth/db'
import { countryName, getBuddy } from '../../../../../lib/golf/repo'
export const prerender = false

// 집계 기간: 골친 목록과 같은 조건 (전체 / 최근 5·10 라운드)
const PERIODS = [
  { key: 'all', label: '전체', recent: null },
  { key: '5', label: '최근5', recent: 5 },
  { key: '10', label: '최근10', recent: 10 },
] as const
const period = PERIODS.find((p) => p.key === Astro.url.searchParams.get('n')) ?? PERIODS[0]
const withPeriod = (path: string, key: string) => (key === 'all' ? path : `${path}?n=${key}`)

const db = getDB(Astro.locals, Astro.request)!
const data = await getBuddy(db, Astro.locals.golf!.user.id, String(Astro.params.id), period.recent)
if (!data) return new Response('Not found', { status: 404 })
const { buddy, self_name: selfName, rounds } = data

const result = (my: number, their: number) => (my < their ? 'win' : my > their ? 'loss' : 'draw')
const BADGE = {
  win: { label: '승', cls: 'bg-kb-win text-kb-ink' },
  loss: { label: '패', cls: 'bg-kb-loss text-kb-ink' },
  draw: { label: '무', cls: 'bg-kb-border text-kb-text' },
} as const
const winRate = Math.round((buddy.wins / (buddy.rounds || 1)) * 100)
---
<GolfLayout title={`${buddy.display_name} 전적`} active="friends">
  <a href={withPeriod('/private/golf/score/friends', period.key)} class="mb-3 inline-flex items-center gap-1 text-[15px] text-kb-primary">← 골친</a>

  <section class="g-card mb-5 !p-5">
    <div class="mb-4 flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h1 class="truncate text-xl font-bold">{selfName} <span class="font-normal text-kb-muted">vs</span> {buddy.display_name}</h1>
        <p class="text-[15px] text-kb-subdued">
          {period.recent && buddy.total_rounds > buddy.rounds
            ? <>최근 {buddy.rounds}라운드 기준</>
            : <>{buddy.total_rounds}라운드 함께</>} · 최근 {buddy.last_on}
        </p>
      </div>
      <div class="shrink-0 rounded-xl bg-kb-primary-subtle px-3 py-1.5 text-center">
        <div class="text-[13px] text-kb-primary">승률</div>
        <div class="text-xl font-bold tabular-nums text-kb-primary">{winRate}%</div>
      </div>
    </div>
    <BuddyRecord size="lg" selfName={selfName} buddyName={buddy.display_name} wins={buddy.wins} draws={buddy.draws} losses={buddy.losses} />
    {buddy.my_avg !== null && (
      <div class="mt-3 grid grid-cols-2 gap-2 text-center text-[15px] tabular-nums">
        <div class="rounded-lg bg-kb-sunken py-2"><div class="text-[13px] text-kb-subdued">{selfName} 평균</div><b class="text-lg text-kb-title">{buddy.my_avg}</b></div>
        <div class="rounded-lg bg-kb-sunken py-2"><div class="text-[13px] text-kb-subdued">{buddy.display_name} 평균</div><b class="text-lg text-kb-title">{buddy.their_avg}</b></div>
      </div>
    )}
  </section>

  <div class="mb-2 flex items-center justify-between gap-3">
    <h2 class="text-lg font-semibold">함께한 라운드</h2>
    <Dropdown
      ariaLabel="집계 기간"
      align="right"
      label={period.label}
      highlight={period.key !== 'all'}
      items={PERIODS.map((p) => ({ href: withPeriod(Astro.url.pathname, p.key), label: p.label, current: p.key === period.key }))}
    />
  </div>
  <ul class="space-y-2.5">
    {rounds.map((r) => {
      const res = result(r.my, r.their)
      const b = BADGE[res]
      return (
        <li>
          <a href={`/private/golf/score/rounds/${r.id}`} class="g-card flex items-center gap-3 !px-3.5 !py-4 hover:border-kb-primary">
            <div class="min-w-0 flex-1">
              <div class="text-[14px] text-kb-subdued">{r.played_on} · {countryName(r.country_code)}{r.region ? ` ${r.region}` : ''}</div>
              <div class="mt-0.5 truncate text-[18px] font-semibold">
                {r.club_name}
                <span class="ml-1 text-[14px] font-normal text-kb-subdued">{r.front_course}{r.back_course ? ` · ${r.back_course}` : ' (9홀)'}</span>
              </div>
              {r.others && <div class="truncate text-[14px] text-kb-muted">{r.others} 동반</div>}
            </div>
            <div class="shrink-0 text-right">
              <div class="flex items-center justify-end gap-2 tabular-nums">
                <span class:list={['text-2xl font-bold leading-none', res === 'win' ? 'text-kb-win' : 'text-kb-title']}>{r.my}</span>
                <span class="text-[13px] font-medium text-kb-muted">vs</span>
                <span class:list={['text-2xl font-bold leading-none', res === 'loss' ? 'text-kb-loss' : 'text-kb-title']}>{r.their}</span>
                <span class:list={['ml-1 inline-flex h-7 w-7 items-center justify-center rounded-full text-[15px] font-bold', b.cls]}>{b.label}</span>
              </div>
            </div>
          </a>
        </li>
      )
    })}
  </ul>

  <script>
    // 드롭다운(details.g-dropdown) 바깥 클릭·Esc 로 닫기
    const closeDropdowns = (except?: Element | null) =>
      document.querySelectorAll<HTMLDetailsElement>('details.g-dropdown[open]').forEach((d) => { if (d !== except) d.open = false })
    document.addEventListener('click', (e) => closeDropdowns((e.target as Element | null)?.closest('details.g-dropdown')))
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDropdowns() })
  </script>
</GolfLayout>

---
import GolfLayout from '../../../../layouts/GolfLayout.astro'
import { getDB } from '../../../../lib/auth/db'
import { listBuddies, rankingStats } from '../../../../lib/golf/repo'
export const prerender = false

const ownerId = Astro.locals.golf!.user.id
const db = getDB(Astro.locals, Astro.request)!
const BASE = '/private/golf/score'
const TOP = 5
const MIN_ROUNDS = 3

// ?more=players | clubs | best-clubs — 해당 랭킹 전체 보기
const more = Astro.url.searchParams.get('more')
const [buddies, stats] = await Promise.all([listBuddies(db, ownerId, MIN_ROUNDS), rankingStats(db, ownerId)])

// 동반자: 나와 3회 이상 + 함께한 18홀 평균이 낮은 순
const players = buddies.filter((b) => b.their_avg !== null).sort((a, b) => a.their_avg! - b.their_avg! || b.rounds - a.rounds)
const clubs = stats.clubs
// 평균타수 낮은 골프장: 내 18홀 평균이 있는 모든 골프장, 평균 낮은 순 (같으면 많이 친 순)
const bestClubs = clubs
  .filter((c) => c.avg !== null)
  .sort((a, b) => a.avg! - b.avg! || b.full_rounds - a.full_rounds)
// more 가 있으면 그 랭킹만 전체, 없으면 각 랭킹 상위 TOP
const pick = <T,>(key: string, list: T[]) => (!more ? list.slice(0, TOP) : more === key ? list : null)
const showPlayers = pick('players', players)
const showClubs = pick('clubs', clubs)
const showBestClubs = pick('best-clubs', bestClubs)

// 연도별 라운드 수 (막대)
const maxYear = Math.max(1, ...stats.years.map((y) => y.rounds))
// 연도별 평균타수 (꺾은선) — 18홀 평균이 있는 해만
const avgYears = stats.years.filter((y) => y.avg != null).map((y) => ({ year: y.year, avg: Number(y.avg) }))
const avgMin = Math.floor(Math.min(...avgYears.map((y) => y.avg))) - 1
const avgMax = Math.ceil(Math.max(...avgYears.map((y) => y.avg))) + 1
const bestAvg = Math.min(...avgYears.map((y) => y.avg))
// 플롯 영역: 위·아래 여백을 두고 % 좌표로 그린다 (점·라벨은 HTML, 선은 SVG)
const avgX = (i: number) => ((i + 0.5) / avgYears.length) * 100
// 위·아래 라벨이 카드 밖으로 안 나가게 상하 여백을 18% 씩 둔다
const avgY = (v: number) => 18 + (1 - (v - avgMin) / (avgMax - avgMin || 1)) * 64
const avgLine = avgYears.map((y, i) => `${avgX(i)},${avgY(y.avg)}`).join(' ')
const avgGrid = [avgMax, Math.round((avgMin + avgMax) / 2), avgMin]

const medal = (_i: number) => 'bg-kb-sunken text-kb-subdued border border-kb-border'
---
<GolfLayout title="랭킹" active="ranking">
  {more && (
    <a href={`${BASE}/ranking`} class="mb-3 inline-block text-sm text-kb-primary">‹ 랭킹</a>
  )}

  {showPlayers && (
    <section class="mb-6">
      <div class="mb-2 flex items-end justify-between">
        <div>
          <h2 class="text-lg font-bold">동반자 평균타수 랭킹</h2>
          <p class="text-xs text-kb-subdued">나와 {MIN_ROUNDS}회 이상 함께 · 함께 친 18홀 평균</p>
        </div>
        {!more && players.length > TOP && <a href={`${BASE}/ranking?more=players`} class="g-btn-ghost shrink-0 text-sm">더보기 ›</a>}
      </div>
      {showPlayers.length === 0 ? (
        <p class="g-card text-center text-sm text-kb-text">{MIN_ROUNDS}회 이상 함께한 동반자가 아직 없어요.</p>
      ) : (
        <ol class="g-card !p-0 divide-y divide-kb-border overflow-hidden">
          {showPlayers.map((b, i) => (
            <li>
              <a href={`${BASE}/friends/${b.id}`} class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-kb-hover">
                <span class:list={['flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold tabular-nums', medal(i)]}>{i + 1}</span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-semibold">{b.display_name}</span>
                  <span class="text-xs text-kb-subdued">{b.rounds}라운드 함께</span>
                </span>
                <span class="text-xl font-bold tabular-nums text-kb-primary">{b.their_avg}</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </section>
  )}

  {showClubs && (
    <section class="mb-6">
      <div class="mb-2 flex items-end justify-between">
        <div>
          <h2 class="text-lg font-bold">자주 찾은 골프장</h2>
          <p class="text-xs text-kb-subdued">라운드 수 많은 순 · 평균은 내 18홀 기준</p>
        </div>
        {!more && clubs.length > TOP && <a href={`${BASE}/ranking?more=clubs`} class="g-btn-ghost shrink-0 text-sm">더보기 ›</a>}
      </div>
      {showClubs.length === 0 ? (
        <p class="g-card text-center text-sm text-kb-text">아직 라운드 기록이 없어요.</p>
      ) : (
        <ol class="g-card !p-0 divide-y divide-kb-border overflow-hidden">
          {showClubs.map((c, i) => (
            <li>
              <a href={`${BASE}/rounds?club=${encodeURIComponent(c.id)}`} class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-kb-hover">
                <span class:list={['flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold tabular-nums', medal(i)]}>{i + 1}</span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-semibold">{c.name}</span>
                  {c.avg !== null && <span class="text-xs text-kb-subdued tabular-nums">평균 {c.avg}</span>}
                </span>
                <span class="text-xl font-bold tabular-nums text-kb-primary">{c.rounds}<span class="ml-0.5 text-sm font-normal text-kb-subdued">회</span></span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </section>
  )}

  {showBestClubs && (
    <section class="mb-6">
      <div class="mb-2 flex items-end justify-between">
        <div>
          <h2 class="text-lg font-bold">평균타수 낮은 골프장</h2>
          <p class="text-xs text-kb-subdued">내 18홀 평균 낮은 순</p>
        </div>
        {!more && bestClubs.length > TOP && <a href={`${BASE}/ranking?more=best-clubs`} class="g-btn-ghost shrink-0 text-sm">더보기 ›</a>}
      </div>
      {showBestClubs.length === 0 ? (
        <p class="g-card text-center text-sm text-kb-text">18홀 기록이 있는 골프장이 아직 없어요.</p>
      ) : (
        <ol class="g-card !p-0 divide-y divide-kb-border overflow-hidden">
          {showBestClubs.map((c, i) => (
            <li>
              <a href={`${BASE}/rounds?club=${encodeURIComponent(c.id)}`} class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-kb-hover">
                <span class:list={['flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold tabular-nums', medal(i)]}>{i + 1}</span>
                <span class="min-w-0 flex-1">
                  <span class="block truncate font-semibold">{c.name}</span>
                  <span class="text-xs text-kb-subdued tabular-nums">18홀 {c.full_rounds}회</span>
                </span>
                <span class="text-xl font-bold tabular-nums text-kb-primary">{c.avg}</span>
              </a>
            </li>
          ))}
        </ol>
      )}
    </section>
  )}

  {!more && stats.years.length > 0 && (
    <section class="mb-6">
      <h2 class="mb-2 text-lg font-bold">연도별 라운드</h2>
      <div class="g-card">
        <div class="flex h-40 items-end gap-1">
          {stats.years.map((y) => (
            <div class="flex h-full min-w-0 flex-1 flex-col items-center justify-end">
              <span class:list={['mb-1 text-xs font-semibold tabular-nums', y.rounds === maxYear ? 'text-kb-success' : 'text-kb-primary']}>{y.rounds}</span>
              <div class="w-full max-w-10 rounded-t bg-kb-primary" style={`height:${(y.rounds / maxYear) * 85}%`}></div>
            </div>
          ))}
        </div>
        <div class="mt-1.5 flex gap-1 border-t border-kb-border pt-1.5">
          {stats.years.map((y) => (
            <div class="min-w-0 flex-1 text-center text-xs tabular-nums text-kb-text">{y.year.slice(2)}</div>
          ))}
        </div>
      </div>
    </section>
  )}

  {!more && avgYears.length > 0 && (
    <section class="mb-6">
      <h2 class="mb-2 text-lg font-bold">연도별 평균타수</h2>
      <div class="g-card">
        <div class="relative h-48">
          {/* 가로 눈금선 */}
          {avgGrid.map((v) => (
            <div class="absolute left-7 right-0 border-t border-dashed border-kb-border" style={`top:${avgY(v)}%`}>
              <span class="absolute -left-7 -top-[5px] w-6 text-right text-[10px] leading-none tabular-nums text-kb-muted">{v}</span>
            </div>
          ))}
          <div class="absolute inset-y-0 left-7 right-0">
          <svg class="absolute inset-0 h-full w-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <polyline points={avgLine} fill="none" stroke="#61A2FF" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
          </svg>
          {avgYears.map((y, i) => {
            const best = y.avg === bestAvg
            // 점이 촘촘한 모바일에서 이웃 라벨이 겹치지 않게 위·아래를 번갈아 둔다
            const below = i % 2 === 1
            return (
              <div class="absolute -translate-x-1/2 -translate-y-1/2" style={`left:${avgX(i)}%;top:${avgY(y.avg)}%`} title={`${y.year}년 평균 ${y.avg}`}>
                <span class:list={[
                  'absolute left-1/2 -translate-x-1/2 whitespace-nowrap rounded-sm bg-kb-panel px-0.5 text-[10px] font-semibold leading-tight tabular-nums sm:text-[11px]',
                  below ? 'top-full mt-1' : 'bottom-full mb-1',
                  best ? 'text-kb-success' : 'text-kb-primary',
                ]}>{y.avg}</span>
                <span class:list={['block h-2.5 w-2.5 rounded-full border-2 border-kb-panel', best ? 'bg-kb-success' : 'bg-kb-primary']}></span>
              </div>
            )
          })}
          </div>
        </div>
        <div class="mt-1.5 ml-7 flex border-t border-kb-border pt-1.5">
          {avgYears.map((y) => <div class="min-w-0 flex-1 text-center text-xs tabular-nums text-kb-text">{y.year.slice(2)}</div>)}
        </div>
      </div>
    </section>
  )}
</GolfLayout>

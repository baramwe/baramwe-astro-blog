---
import GolfLayout from '../../../../../layouts/GolfLayout.astro'
import RoundList from '../../../../../components/golf/RoundList.astro'
import { getDB } from '../../../../../lib/auth/db'
import { listRounds } from '../../../../../lib/golf/repo'
export const prerender = false

const db = getDB(Astro.locals, Astro.request)!
const rounds = await listRounds(db, Astro.locals.golf!.user.id, 2000)
---
<GolfLayout title="라운드" active="rounds">
  <div class="flex items-center justify-between mb-3">
    <h1 class="text-lg font-bold">내 라운드 <span class="text-sm font-normal text-gray-500">{rounds.length}</span></h1>
    <a href="/private/golf/score/rounds/new" class="g-btn text-sm">+ 입력</a>
  </div>
  {rounds.length === 0
    ? <p class="g-card text-sm text-gray-600 text-center">아직 기록이 없어요.</p>
    : <RoundList rounds={rounds} />}
</GolfLayout>

---
import GolfLayout from '../../../../../../layouts/GolfLayout.astro'
import { getDB } from '../../../../../../lib/auth/db'
import { countClubRounds, countryName, getRound } from '../../../../../../lib/golf/repo'
export const prerender = false

const db = getDB(Astro.locals, Astro.request)!
const round = await getRound(db, Astro.locals.golf!.user.id, String(Astro.params.id))
if (!round) return new Response('Not found', { status: 404 })
// 이 골프장에서 2번 이상 쳤으면 하단에 '더 보기' (그 골프장 라운드 목록으로)
const clubRounds = await countClubRounds(db, Astro.locals.golf!.user.id, round.club_id)

// 내 스코어는 상단 정보 카드 우측에, 동반자는 아래 가로 카드로
const me = round.players.find((p) => p.is_self)
const mates = round.players.filter((p) => !p.is_self)

const holeCount = round.pars.length
const hasHoles = round.players.some((p) => p.strokes.some((s) => s !== null))
const halves = holeCount === 18 ? [[0, 9, 'OUT'], [9, 18, 'IN']] as const : [[0, 9, 'OUT']] as const
const parSum = (a: number, b: number) => round.pars.slice(a, b).reduce((x, y) => x + y, 0)
const totalPar = parSum(0, holeCount)

// 스코어 표기: 버디 이하 파란 원, 보기 사각, 더블+ 진한 사각
const cellClass = (s: number | null, par: number) => {
  if (s === null) return 'text-gray-300'
  const d = s - par
  if (d <= -2) return 'bg-blue-600 text-white rounded-full'
  if (d === -1) return 'ring-1 ring-blue-600 text-blue-700 rounded-full'
  if (d === 1) return 'ring-1 ring-gray-400'
  if (d >= 2) return 'bg-gray-700 text-white'
  return ''
}
---
<GolfLayout title={`${round.club_name} ${round.played_on}`} active="home">
  <div class="g-card mb-4">
    <div class="flex items-start gap-3">
      <div class="min-w-0 flex-1">
        <div class="text-xs text-gray-500">{round.played_on} · {countryName(round.country_code)}{round.tee ? ` · ${round.tee} 티` : ''}</div>
        <h1 class="text-xl font-bold">{round.club_name}</h1>
        <div class="text-sm text-gray-600">{round.front_course}{round.back_course ? ` → ${round.back_course}` : ' (9홀)'} · PAR {totalPar}</div>
      </div>
      {me && (
        <div class="shrink-0 text-right leading-tight">
          <div class="text-3xl font-bold tabular-nums text-emerald-800">{me.total}</div>
          <div class="text-sm text-gray-500">{me.display_name}</div>
        </div>
      )}
    </div>
    {round.memo && <p class="mt-3 text-gray-800">{round.memo}</p>}
  </div>

  {/* 동반자: 가로 카드 (이름 + 타수). 카드 탭 → 상대전적 */}
  {mates.length > 0 && (
    <div class="mb-4 grid grid-flow-col auto-cols-fr gap-2">
      {mates.map((p) => (
        <a
          href={`/private/golf/score/friends/${p.player_id}`}
          aria-label={`${p.display_name} 상대전적 보기`}
          class="g-card !px-2 !py-3 min-w-0 text-center transition-colors hover:border-emerald-300 hover:bg-emerald-50/60 active:bg-emerald-50"
        >
          <div class="truncate text-sm text-gray-700">{p.display_name}</div>
          <div class="mt-0.5 text-xl font-bold tabular-nums text-emerald-800">{p.total}</div>
        </a>
      ))}
    </div>
  )}

  {hasHoles && halves.map(([a, b, label]) => (
    <div class="g-card mb-4 !p-2 overflow-x-auto">
      <table class="w-full text-center text-sm tabular-nums">
        <thead>
          <tr class="text-xs text-gray-500 bg-emerald-100">
            <th class="text-left px-2 py-1 font-normal">홀</th>
            {round.pars.slice(a, b).map((_, i) => <th class="px-1 py-1 font-normal min-w-[1.75rem]">{a + i + 1}</th>)}
            <th class="px-2 py-1 font-semibold">{label}</th>
          </tr>
          <tr class="text-xs text-gray-500 border-b border-gray-200 bg-amber-100">
            <td class="text-left px-2 py-1">PAR</td>
            {round.pars.slice(a, b).map((par) => <td class="py-1">{par}</td>)}
            <td class="py-1 font-semibold">{parSum(a, b)}</td>
          </tr>
        </thead>
        <tbody>
          {round.players.map((p) => (
            <tr class="border-b border-gray-50">
              <td class="text-left px-2 py-1.5 whitespace-nowrap max-w-[5rem] truncate">{p.display_name}</td>
              {p.strokes.slice(a, b).map((s, i) => (
                <td class="py-1.5"><span class={`inline-flex w-6 h-6 items-center justify-center ${cellClass(s, round.pars[a + i])}`}>{s ?? '·'}</span></td>
              ))}
              <td class="py-1.5 font-semibold">{p.strokes.slice(a, b).every((s) => s !== null) ? p.strokes.slice(a, b).reduce((x, y) => x! + y!, 0) : '-'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))}

  {clubRounds >= 2 && (
    <div class="mt-2 mb-4 text-center">
      <a href={`/private/golf/score/rounds?club=${encodeURIComponent(round.club_id)}`} aria-label={`${round.club_name} 라운드 ${clubRounds}개 더 보기`} class="g-btn-ghost inline-flex items-center gap-1.5 text-sm text-emerald-800 hover:border-emerald-400 hover:bg-emerald-50">
        {round.club_name}
        <span class="text-gray-500 tabular-nums">{clubRounds}</span>
        <span aria-hidden="true">›</span>
      </a>
    </div>
  )}
</GolfLayout>

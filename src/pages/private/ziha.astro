      #ziha-panel { width: 100%; max-width: none; max-height: calc(100vh - 6rem); overflow-y: auto; padding: .85rem; }
      #panel-tabs { gap: .35rem; }
      #panel-tabs button { flex: 1; }
      #tab-edit > div[style*="display:flex"] { flex-wrap: wrap; }
      #ps-q { flex: 1 1 100%; width: 100%; }
      #ps-star, #ps-site { flex: 1 1 auto; min-width: 0; }
      #ps-btn { flex: 0 0 auto; }
      #p-result li { align-items: flex-start; flex-wrap: nowrap; }
      #p-result .item-title { white-space: normal; overflow-wrap: anywhere; }
      #p-result .btn-sm { flex: 0 0 auto; }
      #p-edit-form div[style*="display:flex"] { flex-wrap: wrap; }
      #p-edit-form div[style*="display:flex"] > * { min-width: 0; }
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap">
      <div class="top">
        <h1><span class="dot"></span>북마크</h1>
        <div class="search">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          <input type="search" id="sq" placeholder="제목·배우·메모 검색 (&& 로 AND)" autocomplete="off" />
          <kbd>/</kbd>
          <ul id="sq-ac" role="listbox"></ul>
        </div>
        <div class="ctrls">
          <select id="sstar" aria-label="별점">
            <option value="">★ 전체</option>
            <option value="1_gte">★ 이상</option>
            <option value="2_gte">★★ 이상</option>
            <option value="3_gte">★★★</option>
            <option value="1_eq">★ 정확히</option>
            <option value="2_eq">★★ 정확히</option>
            <option value="3_eq">★★★ 정확히</option>
          </select>

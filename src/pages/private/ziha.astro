---
export const prerender = false;

import { generateDailyToken, verifyDailyToken } from '../../lib/daily-token';
import { getDB } from '../../lib/auth/db';
import { SITES, SITE_LABELS } from '../../lib/ziha-site';

// POST: 토큰 검증
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const input = (form.get('token') ?? '').toString().trim().toLowerCase();
  if (await verifyDailyToken(input)) {
    const token = await generateDailyToken();
    return new Response(null, {
      status: 302,
      headers: {
        Location: '/private/ziha',
        'Set-Cookie': `ziha_auth=${token}; HttpOnly; SameSite=Strict; Path=/private/ziha; Max-Age=86400`,
      },
    });
  }
}

const todayToken = await generateDailyToken();
const cookie = Astro.request.headers.get('cookie') ?? '';
const cookieMatch = cookie.match(/ziha_auth=([^;]+)/);
// 로컬 dev(npm run dev) 및 preview(wrangler dev)에서는 코드 입력 없이 바로 접근 허용.
// 프로덕션 도메인은 localhost가 아니므로 배포 시에는 적용되지 않는다.
const reqHost = new URL(Astro.request.url).hostname;
const isLocal = import.meta.env.DEV || reqHost === 'localhost' || reqHost === '127.0.0.1';
const authed = Astro.request.method === 'GET' && (isLocal || cookieMatch?.[1] === todayToken);

type Bookmark = { id: number; title: string; url: string; star: number; memo: string | null; site: string | null };
let bookmarks: Bookmark[] = [];
let hiddenMemos: string[] = [];
let hiddenActors: string[] = [];

if (authed) {
  const db = getDB(Astro.locals, Astro.request);
  if (db) {
    const { results } = await db
      .prepare('SELECT id, title, url, star, memo, sort, site FROM bookmarks ORDER BY CASE WHEN sort = 0 THEN 0 WHEN sort = 1 THEN 1 ELSE 2 END ASC, id DESC')
      .all<Bookmark>();
    bookmarks = results;
    try {
      const hidden = await db.prepare('SELECT memo FROM ziha_hidden_memos ORDER BY created_at, memo').all<{ memo: string }>();
      hiddenMemos = hidden.results.map(r => r.memo);
    } catch {
      hiddenMemos = []; // 0011 마이그레이션 전이면 숨김 없이 전부 노출
    }
    try {
      const hidden = await db.prepare('SELECT name FROM ziha_hidden_actors ORDER BY created_at, name').all<{ name: string }>();
      hiddenActors = hidden.results.map(r => r.name);
    } catch {
      hiddenActors = [];
    }
  }
}

// 인증된 경우 북마크 페이지 반환
if (authed) {
  // 목록은 클라이언트가 그린다(필터·분류를 즉시 하려고). </script> 조기 종료를 막도록 '<' 를 이스케이프한다.
  const dataJson = JSON.stringify(bookmarks).replace(/</g, '\\u003c');
  const hiddenJson = JSON.stringify(hiddenMemos).replace(/</g, '\\u003c');
  const hiddenActorsJson = JSON.stringify(hiddenActors).replace(/</g, '\\u003c');
  const siteOptions = SITES.map(k => `<option value="${k}">${SITE_LABELS[k]}</option>`).join('') + '<option value="none">기타</option>';

  const html = `<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>북마크</title>
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#0B1628" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <style>
    * { box-sizing: border-box; }
    html, body { max-width: 100%; overflow-x: hidden; }
    html { color-scheme: dark; background: #07101F; }
    ::selection { background: rgba(97, 162, 255, .35); }
    button { color: inherit; }
    option, optgroup { background: #0B1628; color: #CAD3E2; }
    input::placeholder { color: #6A7FA0; }
    input:focus, select:focus { outline: none; border-color: #61A2FF !important; box-shadow: 0 0 0 1px #61A2FF; }
    body { font-family: Inter, 'Pretendard Variable', Pretendard, system-ui, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; margin: 0; padding: 0 0 5rem; background: #07101F; color: #CAD3E2; font-size: 1.04rem; -webkit-font-smoothing: antialiased; }
    ul { list-style: none; margin: 0; padding: 0; }
    a { color: #61A2FF; text-decoration: none; overflow-wrap: anywhere; word-break: break-word; min-width: 0; }
    a:hover { text-decoration: underline; }
    .wrap { max-width: 1320px; margin: 0 auto; padding: 0 1.5rem; }
    header { position: sticky; top: 0; z-index: 10; background: rgba(7, 16, 31, .94); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid #1C2A40; padding: .55rem 0 .5rem; }
    .top { display: flex; align-items: center; gap: .6rem; }
    h1 { margin: 0; font-size: .92rem; font-weight: 600; color: #E3E8F2; display: flex; align-items: center; gap: .5rem; white-space: nowrap; }
    h1 .dot { width: .48rem; height: .48rem; border-radius: 50%; background: #61A2FF; box-shadow: 0 0 0 3px rgba(97, 162, 255, .18); }
    .search { position: relative; flex: 1; min-width: 0; display: flex; align-items: center; gap: .5rem; background: #0B1628; border: 1px solid #2B394F; border-radius: 7px; padding: 0 .55rem; color: #6A7FA0; }
    .search:focus-within { border-color: #61A2FF; box-shadow: 0 0 0 1px #61A2FF; }
    .search input { flex: 1; min-width: 0; background: transparent; border: none; color: #E3E8F2; font-size: .84rem; padding: .36rem 0; font-family: inherit; }
    .search input:focus { box-shadow: none; }
    .search kbd { font: 500 .66rem Inter, sans-serif; color: #6A7FA0; border: 1px solid #2B394F; border-radius: 4px; padding: .05rem .38rem; }
    .ctrls { display: flex; gap: .35rem; align-items: center; }
    .ctrls select { padding: .32rem .45rem; background: #0B1628; color: #E3E8F2; border: 1px solid #2B394F; border-radius: 6px; font-size: .78rem; font-family: inherit; }
    .ctrls button { padding: .34rem .7rem; border: none; border-radius: 6px; cursor: pointer; font-size: .78rem; font-family: inherit; white-space: nowrap; }
    .stats { color: #6A7FA0; font-size: .72rem; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .chip-row { display: flex; align-items: center; gap: .6rem; margin-top: .5rem; min-width: 0; }
    .chip-label { flex: 0 0 2.6rem; font-size: .72rem; color: #6A7FA0; }
    .chips { display: flex; gap: .35rem; overflow-x: auto; scrollbar-width: none; min-width: 0; padding: 1px; }
    .chips::-webkit-scrollbar { display: none; }
    .chips.dragging { cursor: grabbing; user-select: none; }
    .chips.dragging .chip { pointer-events: none; }
    .chip { flex: 0 0 auto; display: inline-flex; align-items: center; gap: .35rem; border: 1px solid #2B394F; background: #0B1628; color: #98A8C3; border-radius: 999px; padding: .26rem .7rem; font-size: .8rem; font-family: inherit; cursor: pointer; }
    .chip:hover { border-color: #61A2FF; color: #E3E8F2; }
    .chip[aria-pressed="true"] { background: #61A2FF; border-color: #61A2FF; color: #07101F; font-weight: 500; }
    .chip .n { font-size: .7rem; opacity: .7; font-variant-numeric: tabular-nums; }
    .chip-empty { font-size: .76rem; color: #4A5D7A; }
    .chip-x { display: inline-grid; place-items: center; width: 1rem; height: 1rem; margin: 0 -.35rem 0 -.1rem; border-radius: 50%; font-size: .85rem; line-height: 1; color: #6A7FA0; }
    .chip-x:hover { background: rgba(246, 114, 106, .18); color: #F6726A; }
    .chip[aria-pressed="true"] .chip-x { color: #07101F; }
    @media (hover: hover) {
      .chip .chip-x { opacity: 0; transition: opacity .12s; }
      .chip:hover .chip-x, .chip:focus-visible .chip-x { opacity: 1; }
    }
    .chip-hidden { border-style: dashed; color: #6A7FA0; }
    .mh { width: 280px; }
    .mh-row { display: flex; align-items: center; gap: .5rem; padding: .4rem 0; border-top: 1px solid #1C2A40; }
    .mh-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #E3E8F2; }
    .mh-cnt { flex: 0 0 auto; color: #6A7FA0; font-size: .7rem; font-variant-numeric: tabular-nums; }
    .mh-show { flex: 0 0 auto; padding: .2rem .55rem; border: 1px solid #2B394F; border-radius: 6px; background: transparent; color: #61A2FF; font-size: .72rem; font-family: inherit; cursor: pointer; }
    .mh-show:hover { border-color: #61A2FF; background: rgba(97, 162, 255, .12); }
    .mh-empty { padding: .4rem 0 .2rem; color: #6A7FA0; font-size: .75rem; }
    .toast { position: fixed; left: 50%; bottom: 1.2rem; z-index: 10000; transform: translateX(-50%); max-width: calc(100vw - 32px); padding: .45rem .9rem; background: #13223A; border: 1px solid #2B394F; border-radius: 8px; color: #E3E8F2; font-size: .8rem; box-shadow: 0 3px 10px rgba(0,0,0,.52); opacity: 0; pointer-events: none; transition: opacity .15s; }
    .toast.show { opacity: 1; }
    main.wrap { padding-top: .4rem; }
    section h2 { display: flex; align-items: center; gap: .5rem; margin: 1.3rem 0 .6rem; font-size: .85rem; font-weight: 600; color: #98A8C3; }
    section h2 .cnt { font-size: .7rem; font-weight: 500; color: #6A7FA0; background: #13223A; border-radius: 999px; padding: .05rem .5rem; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: .55rem; }
    .card { position: relative; min-width: 0; background: #0B1628; border: 1px solid #1C2A40; border-radius: 10px; transition: border-color .12s, background .12s; }
    .card:hover, .card.editing { border-color: #61A2FF; background: #0E1B31; }
    .card-link { display: flex; flex-direction: column; min-width: 0; height: 100%; padding: .65rem 2.3rem .65rem .8rem; color: inherit; }
    .card-link:hover { text-decoration: none; }
    .card-link:visited .tt { color: #B9C2D3; }
    .card-edit { position: absolute; top: .38rem; right: .38rem; width: 1.65rem; height: 1.65rem; display: grid; place-items: center; padding: 0; border: 1px solid transparent; border-radius: 6px; background: transparent; color: #4A5D7A; cursor: pointer; transition: color .12s, background .12s, border-color .12s; }
    .card:hover .card-edit { color: #98A8C3; }
    .card-edit:hover, .card-edit[aria-expanded="true"] { color: #E3E8F2; background: #13223A; border-color: #2B394F; }
    .card-edit:focus-visible { outline: none; border-color: #61A2FF; color: #E3E8F2; }
    .qe { position: absolute; z-index: 30; width: 300px; max-width: calc(100vw - 16px); padding: .7rem .75rem .55rem; background: #0B1628; color: #CAD3E2; border: 1px solid #2B394F; border-radius: 10px; box-shadow: 0 3px 10px rgba(0,0,0,.52), 0 6px 14px rgba(0,0,0,.28); font-size: .8rem; }
    .qe[hidden] { display: none; }
    .qe-title { color: #98A8C3; font-size: .74rem; margin-bottom: .6rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .qe-row { display: flex; align-items: center; gap: .5rem; margin-bottom: .5rem; }
    .qe-label { flex: 0 0 2rem; color: #6A7FA0; font-size: .72rem; }
    .qe-star { padding: .05rem .12rem; border: none; background: none; color: #2B394F; font-size: 1.2rem; line-height: 1; cursor: pointer; }
    .qe-star.on { color: #FACB3D; }
    .qe-star:hover { color: #FFD966; }
    .qe-hint { margin-left: auto; color: #4A5D7A; font-size: .68rem; white-space: nowrap; }
    .qe-row input { flex: 1; min-width: 0; padding: .38rem .5rem; background: #07101F; color: #E3E8F2; border: 1px solid #2B394F; border-radius: 6px; font-size: .8rem; font-family: inherit; }
    .qe-btn { flex: 0 0 auto; padding: .38rem .65rem; border: none; border-radius: 6px; background: #61A2FF; color: #07101F; font-weight: 500; font-size: .78rem; font-family: inherit; cursor: pointer; }
    .qe-keys { display: flex; flex-wrap: wrap; gap: .25rem; margin: -.15rem 0 .4rem 2.5rem; }

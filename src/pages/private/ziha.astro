    #sq-ac { display: none; position: absolute; left: 0; right: 0; top: calc(100% + 4px); z-index: 20; margin: 0; padding: .25rem 0; list-style: none; background: #0B1628; border: 1px solid #2B394F; border-radius: 6px; box-shadow: 0 3px 10px rgba(0,0,0,.52), 0 6px 14px rgba(0,0,0,.28); max-height: 50vh; overflow-y: auto; }
    #sq-ac li { display: flex; flex-wrap: nowrap; align-items: baseline; gap: .5rem; padding: .4rem .7rem; cursor: pointer; }
    #sq-ac li.on, #sq-ac li:hover { background: #13223A; }

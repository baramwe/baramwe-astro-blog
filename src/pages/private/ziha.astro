    #ziha-panel input, #ziha-panel select { width: 100%; padding: .35rem .5rem; background: #07101F; color: #E3E8F2; border: 1px solid #2B394F; border-radius: 4px; font-size: .8rem; box-sizing: border-box; margin-bottom: .3rem; }

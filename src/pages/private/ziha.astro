    .tag.star { background: rgba(250, 203, 61, .12); color: #FACB3D; }
    .tag.memo { background: #0B3A2E; color: #24C292; }
    .empty { text-align: center; color: #6A7FA0; padding: 3rem 0; }
    .btn-open { background: #61A2FF; color: #07101F; font-weight: 500; }
    .site { flex: 0 0 auto; font-size: .7rem; line-height: 1; padding: .18rem .35rem; border-radius: 3px; background: #13223A; color: #98A8C3; white-space: nowrap; align-self: center; }
    .site-topgirl { background: rgba(246, 114, 168, .14); color: #F672A8; }
    .site-sogirl  { background: rgba(97, 162, 255, .14);  color: #61A2FF; }
    .site-123av   { background: rgba(74, 210, 140, .14);  color: #4AD28C; }
    .site-missav  { background: rgba(250, 175, 80, .14);  color: #FAAF50; }
    .site-njav    { background: rgba(176, 140, 255, .14); color: #B08CFF; }
    .btn-dark  { background: rgba(97, 162, 255, .12); color: #61A2FF; font-weight: 500; }
    .btn-grey  { background: #13223A; color: #CAD3E2; border: 1px solid #2B394F !important; }
    #ziha-mgmt { position: fixed; bottom: 1rem; right: 1rem; z-index: 9999; display: flex; flex-direction: column; align-items: flex-end; gap: .5rem; }
    #ziha-toggle { background: #0B1628; color: #CAD3E2; border: 1px solid #2B394F; border-radius: 50%; width: 2.5rem; height: 2.5rem; font-size: 1.2rem; cursor: pointer; }

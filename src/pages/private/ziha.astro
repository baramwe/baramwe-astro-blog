    .qe-foot { display: flex; align-items: center; gap: .5rem; padding-top: .45rem; border-top: 1px solid #1C2A40; }
    .qe-foot .qe-status { flex: 1; min-width: 0; }
    .qe-del { flex: 0 0 auto; padding: .3rem .65rem; border: 1px solid rgba(246, 114, 106, .45); border-radius: 6px; background: transparent; color: #F6726A; font-size: .74rem; font-family: inherit; cursor: pointer; }
    .qe-del:hover { background: rgba(246, 114, 106, .12); border-color: #F6726A; }
    .qe-del.armed { background: #F6726A; border-color: #F6726A; color: #07101F; font-weight: 500; }
    .qe-del:disabled { opacity: .5; cursor: default; }
    .tt { color: #E3E8F2; font-size: calc(.78rem + 1px); line-height: 1.38; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .hh { color: #6A7FA0; font-size: calc(.74rem + 1px); margin-top: .15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .tags { display: flex; flex-wrap: wrap; gap: .25rem; margin-top: .35rem; }

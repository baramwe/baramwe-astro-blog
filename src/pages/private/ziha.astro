---
export const prerender = false;

import { generateDailyToken, verifyDailyToken } from '../../lib/daily-token';
import { getDB } from '../../lib/auth/db';
import { SITES, SITE_LABELS } from '../../lib/ziha-site';

// POST: 토큰 검증
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const input = (form.get('token') ?? '').toString().trim().toLowerCase();
  if (await verifyDailyToken(input)) {
    const token = await generateDailyToken();
    return new Response(null, {
      status: 302,
      headers: {
        Location: '/private/ziha',
        'Set-Cookie': `ziha_auth=${token}; HttpOnly; SameSite=Strict; Path=/private/ziha; Max-Age=86400`,
      },
    });
  }
}

const todayToken = await generateDailyToken();
const cookie = Astro.request.headers.get('cookie') ?? '';
const cookieMatch = cookie.match(/ziha_auth=([^;]+)/);
// 로컬 dev(npm run dev) 및 preview(wrangler dev)에서는 코드 입력 없이 바로 접근 허용.
// 프로덕션 도메인은 localhost가 아니므로 배포 시에는 적용되지 않는다.
const reqHost = new URL(Astro.request.url).hostname;
const isLocal = import.meta.env.DEV || reqHost === 'localhost' || reqHost === '127.0.0.1';
const authed = Astro.request.method === 'GET' && (isLocal || cookieMatch?.[1] === todayToken);

type Bookmark = { id: number; title: string; url: string; star: number; memo: string | null; site: string | null };
let bookmarks: Bookmark[] = [];

if (authed) {
  const db = getDB(Astro.locals, Astro.request);
  if (db) {
    const { results } = await db
      .prepare('SELECT id, title, url, star, memo, sort, site FROM bookmarks ORDER BY CASE WHEN sort = 0 THEN 0 WHEN sort = 1 THEN 1 ELSE 2 END ASC, id DESC')
      .all<Bookmark>();
    bookmarks = results;
  }
}

// 인증된 경우 북마크 페이지 반환
if (authed) {
  const stars = (n: number) => '★'.repeat(n);
  const esc = (s: string) =>
    String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

  const siteLabel = (s: string | null) => (s && (SITE_LABELS as Record<string, string>)[s]) || '';
  const items = bookmarks.map(b =>
    `<li>${b.star > 0 ? `<span class="star">${stars(b.star)}</span>` : ''}<a href="${esc(b.url)}" target="_blank" rel="noopener">${esc(b.title)}</a>${b.site ? `<span class="site site-${esc(b.site)}">${esc(siteLabel(b.site))}</span>` : ''}${b.memo ? `<span class="memo">${esc(b.memo)}</span>` : ''}</li>`
  ).join('\n');
  const siteOptions = SITES.map(k => `<option value="${k}">${SITE_LABELS[k]}</option>`).join('') + '<option value="none">기타</option>';

  const html = `<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>북마크</title>
  <meta name="color-scheme" content="dark" />
  <meta name="theme-color" content="#0B1628" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <style>
    * { box-sizing: border-box; }
    html, body { max-width: 100%; overflow-x: hidden; }
    html { color-scheme: dark; background: #07101F; }
    ::selection { background: rgba(97, 162, 255, .35); }
    button { color: inherit; }
    option, optgroup { background: #0B1628; color: #CAD3E2; }
    input::placeholder { color: #6A7FA0; }
    input:focus, select:focus { outline: none; border-color: #61A2FF !important; box-shadow: 0 0 0 1px #61A2FF; }
    body { font-family: Inter, 'Pretendard Variable', Pretendard, system-ui, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; margin: 0; padding: 1rem 1.5rem 5rem; background: #07101F; color: #CAD3E2; font-size: 1.04rem; -webkit-font-smoothing: antialiased; }
    ul { list-style: none; margin: 0; padding: 0; }
    li { padding: .3rem 0; display: flex; align-items: baseline; gap: .4rem; min-width: 0; }
    a { color: #61A2FF; text-decoration: none; overflow-wrap: anywhere; word-break: break-word; min-width: 0; }
    a:hover { text-decoration: underline; }
    .star { color: #FACB3D; margin-right: .1rem; font-size: .88rem; }
    .memo { color: #6A7FA0; font-size: .88rem; margin-left: .35rem; }
    .btn-open { background: #61A2FF; color: #07101F; font-weight: 500; }
    #search-bar { position: sticky; top: 0; background: #07101F; padding: .5rem 0; display: flex; gap: .5rem; align-items: center; z-index: 10; border-bottom: 1px solid #2B394F; margin-bottom: .75rem; }
    #search-bar input { flex: 1; padding: .4rem .6rem; background: #07101F; color: #E3E8F2; border: 1px solid #2B394F; border-radius: 4px; font-size: 1.04rem; }
    #search-bar select { padding: .4rem .5rem; background: #07101F; color: #E3E8F2; border: 1px solid #2B394F; border-radius: 4px; font-size: 1.04rem; }
    .site { flex: 0 0 auto; font-size: .7rem; line-height: 1; padding: .18rem .35rem; border-radius: 3px; background: #13223A; color: #98A8C3; white-space: nowrap; align-self: center; }
    .site-topgirl { background: rgba(246, 114, 168, .14); color: #F672A8; }
    .site-sogirl  { background: rgba(97, 162, 255, .14);  color: #61A2FF; }
    .site-123av   { background: rgba(74, 210, 140, .14);  color: #4AD28C; }
    .site-missav  { background: rgba(250, 175, 80, .14);  color: #FAAF50; }
    .site-njav    { background: rgba(176, 140, 255, .14); color: #B08CFF; }
    #search-bar button { padding: .4rem .8rem; border: none; border-radius: 4px; cursor: pointer; font-size: 1.04rem; }
    .btn-dark  { background: rgba(97, 162, 255, .12); color: #61A2FF; font-weight: 500; }
    .btn-grey  { background: #13223A; color: #CAD3E2; border: 1px solid #2B394F !important; }
    #ziha-mgmt { position: fixed; bottom: 1rem; right: 1rem; z-index: 9999; display: flex; flex-direction: column; align-items: flex-end; gap: .5rem; }
    #ziha-toggle { background: #0B1628; color: #CAD3E2; border: 1px solid #2B394F; border-radius: 50%; width: 2.5rem; height: 2.5rem; font-size: 1.2rem; cursor: pointer; }
    #ziha-panel { display: none; background: #0B1628; color: #CAD3E2; border: 1px solid #2B394F; border-radius: 8px; padding: 1rem; width: 540px; box-shadow: 0 3px 10px rgba(0,0,0,.52), 0 6px 14px rgba(0,0,0,.28); font-size: .8rem; }
    #ziha-panel input, #ziha-panel select { width: 100%; padding: .35rem .5rem; background: #07101F; color: #E3E8F2; border: 1px solid #2B394F; border-radius: 4px; font-size: .8rem; box-sizing: border-box; margin-bottom: .3rem; }
    .btn { padding: .35rem .7rem; border: none; border-radius: 4px; cursor: pointer; font-size: .8rem; }
    .btn-sm { padding: .2rem .4rem; font-size: .72rem; }
    .btn-primary { background: #61A2FF; color: #07101F; font-weight: 500; }
    .btn-danger  { background: #4A1A1C; color: #F6726A; }
    #panel-tabs { display: flex; gap: .5rem; margin-bottom: .75rem; border-bottom: 1px solid #2B394F; padding-bottom: .5rem; }
    #panel-tabs button { background: none; color: #98A8C3; border: none; cursor: pointer; font-size: .8rem; padding: .2rem .4rem; border-radius: 3px; }
    #panel-tabs button.active { background: #61A2FF; color: #07101F; }
    .panel-section { display: none; }
    .panel-section.active { display: block; }
    #p-result { list-style: none; margin: .4rem 0 0; padding: 0; max-height: 260px; overflow-y: auto; }
    #p-result li { display: flex; align-items: center; gap: .4rem; padding: .25rem 0; border-bottom: 1px solid #2B394F; }
    #p-result .item-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #61A2FF; text-decoration: none; }
    #p-result .item-title:hover { text-decoration: underline; }
    #p-msg { color: #24C292; font-size: .75rem; margin-top: .4rem; min-height: 1em; }
    #rank-result { list-style: none; margin: .4rem 0 0; padding: 0; max-height: 380px; overflow-y: auto; }
    #rank-result li { display: flex; align-items: center; gap: .5rem; padding: .32rem .1rem; border-bottom: 1px solid #2B394F; }
    #rank-result .rank-no { flex: 0 0 1.7rem; text-align: right; color: #6A7FA0; font-size: .74rem; font-variant-numeric: tabular-nums; }
    #rank-result .item-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #61A2FF; text-decoration: none; }
    #rank-result .item-title:hover { text-decoration: underline; }
    #rank-result .rank-cnt { flex: 0 0 auto; color: #FACB3D; font-size: .74rem; }
    #sq-ac { display: none; position: absolute; z-index: 20; margin: 0; padding: .25rem 0; list-style: none; background: #0B1628; border: 1px solid #2B394F; border-radius: 6px; box-shadow: 0 3px 10px rgba(0,0,0,.52), 0 6px 14px rgba(0,0,0,.28); max-height: 50vh; overflow-y: auto; }
    #sq-ac li { display: flex; flex-wrap: nowrap; align-items: baseline; gap: .5rem; padding: .4rem .7rem; cursor: pointer; }
    #sq-ac li.on, #sq-ac li:hover { background: #13223A; }
    #sq-ac .ac-kind { flex: 0 0 auto; font-size: .72rem; line-height: 1.4; padding: 0 .35rem; border-radius: 3px; }
    #sq-ac .ac-name  { background: #0D2F5E; color: #8BBAFF; }
    #sq-ac .ac-memo  { background: #0B3A2E; color: #24C292; }
    #sq-ac .ac-title { background: #13223A; color: #98A8C3; border: 1px solid #2B394F; }
    #sq-ac .ac-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #E3E8F2; }
    #sq-ac .ac-cnt { flex: 0 0 auto; color: #6A7FA0; font-size: .78rem; }
    @media (max-width: 640px) {
      body { padding: .75rem .85rem 5.5rem; font-size: 1rem; }
      li { align-items: flex-start; flex-wrap: wrap; gap: .18rem .35rem; }
      li a { flex: 1 1 0; }
      .star { flex: 0 0 auto; line-height: 1.5; }
      .site { align-self: flex-start; margin-top: .2rem; }
      .memo { flex: 1 0 100%; margin-left: 0; padding-left: 0; overflow-wrap: anywhere; }
      #search-bar { flex-wrap: wrap; gap: .4rem; padding: .5rem 0; }
      #search-bar input { flex: 1 1 100%; width: 100%; min-width: 0; }
      #search-bar select { flex: 1 1 100%; width: 100%; min-width: 0; }
      #search-bar button { flex: 1 1 calc(33.333% - .4rem); min-width: 0; padding: .45rem .35rem; white-space: nowrap; }
      #ziha-mgmt { left: .75rem; right: .75rem; bottom: .75rem; align-items: flex-end; pointer-events: none; }
      #ziha-toggle, #ziha-panel { pointer-events: auto; }
      #ziha-panel { width: 100%; max-width: none; max-height: calc(100vh - 6rem); overflow-y: auto; padding: .85rem; }
      #panel-tabs { gap: .35rem; }
      #panel-tabs button { flex: 1; }
      #tab-edit > div[style*="display:flex"] { flex-wrap: wrap; }
      #ps-q { flex: 1 1 100%; width: 100%; }
      #ps-star, #ps-site { flex: 1 1 auto; min-width: 0; }
      #ps-btn { flex: 0 0 auto; }
      #p-result li { align-items: flex-start; flex-wrap: nowrap; }
      #p-result .item-title { white-space: normal; overflow-wrap: anywhere; }
      #p-result .btn-sm { flex: 0 0 auto; }
      #p-edit-form div[style*="display:flex"] { flex-wrap: wrap; }
      #p-edit-form div[style*="display:flex"] > * { min-width: 0; }
    }
  </style>
</head>
<body>
  <div id="search-bar">
    <input type="text" id="sq" placeholder="제목·배우·메모 검색" autocomplete="off" />
    <select id="sstar">
      <option value="">★ 전체</option>
      <option value="1_gte">★ 이상</option>
      <option value="2_gte">★★ 이상</option>
      <option value="3_gte">★★★</option>
      <option value="1_eq">★ 정확히</option>
      <option value="2_eq">★★ 정확히</option>
      <option value="3_eq">★★★ 정확히</option>
    </select>
    <select id="ssite">
      <option value="">사이트 전체</option>
      ${siteOptions}
    </select>
    <button class="btn-dark" id="sbtn">검색</button>
    <button class="btn-open" id="sbtn-open">열기</button>
    <button class="btn-grey" id="sbtn-reset">초기화</button>
    <ul id="sq-ac" role="listbox"></ul>
  </div>

  <ul id="bm-list">
    ${items}
  </ul>

  <div id="ziha-mgmt">
    <div id="ziha-panel">
      <div id="panel-tabs">
        <button class="active" data-tab="add">추가</button>
        <button data-tab="edit">검색/편집</button>
        <button data-tab="replace">주소변경</button>
        <button data-tab="rank">순위</button>
      </div>
      <div class="panel-section active" id="tab-add">
        <input type="text" id="p-title" placeholder="제목" />
        <input type="text" id="p-url"   placeholder="URL (사이트 태그는 도메인으로 자동 저장, 제목의 사이트명은 자동 제거)" />
        <input type="text" id="p-memo"  placeholder="메모 (선택, 최대 100자)" maxlength="100" />
        <select id="p-star">
          <option value="0">별 없음</option>
          <option value="1">★</option>
          <option value="2">★★</option>
          <option value="3">★★★</option>
        </select>
        <button class="btn btn-primary" id="p-add">저장</button>
      </div>
      <div class="panel-section" id="tab-edit">
        <div style="display:flex;gap:.3rem;margin-bottom:.4rem;">
          <input type="text" id="ps-q" placeholder="제목 검색" style="margin:0;" />
          <select id="ps-star" style="margin:0;width:auto;flex-shrink:0;">
            <option value="">전체</option>
            <option value="1_gte">★ 이상</option>
            <option value="2_gte">★★ 이상</option>
            <option value="3_gte">★★★</option>
            <option value="1_eq">★ 정확히</option>
            <option value="2_eq">★★ 정확히</option>
          </select>
          <select id="ps-site" style="margin:0;width:auto;flex-shrink:0;">
            <option value="">사이트 전체</option>
            ${siteOptions}
          </select>
          <button class="btn btn-primary btn-sm" id="ps-btn" style="flex-shrink:0;">검색</button>
        </div>
        <ul id="p-result"></ul>
        <div id="p-edit-form" style="display:none;margin-top:.6rem;border-top:1px solid #2B394F;padding-top:.6rem;">
          <input type="hidden" id="pe-id" />
          <input type="text"   id="pe-title" placeholder="제목" />
          <input type="text"   id="pe-url"   placeholder="URL" />
          <input type="text"   id="pe-memo"  placeholder="메모 (선택, 최대 100자)" maxlength="100" />
          <div style="display:flex;gap:.4rem;">
            <select id="pe-star" style="flex:1;">
              <option value="0">별 없음</option>
              <option value="1">★</option>
              <option value="2">★★</option>
              <option value="3">★★★</option>
            </select>
            <select id="pe-sort" style="flex:1;">
              <option value="0">비공개 (sort=0)</option>
              <option value="1">🔴 즐겨찾기 (sort=1)</option>
              <option value="">기본 (sort=null)</option>
            </select>
          </div>
          <div style="display:flex;gap:.4rem;margin-top:.3rem;">
            <button class="btn btn-primary" id="pe-save" style="flex:1;">저장</button>
            <button class="btn btn-grey"    id="pe-cancel" style="flex:1;">취소</button>
          </div>
        </div>
      </div>
      <div class="panel-section" id="tab-replace">
        <p style="color:#98A8C3;font-size:.75rem;margin:0 0 .5rem;">URL 중 일치하는 텍스트를 일괄 교체합니다.</p>
        <label style="font-size:.75rem;color:#98A8C3;">찾을 텍스트 (URL 내)</label>
        <input type="text" id="pr-from" placeholder="예: kr43.topgirl.co" />
        <label style="font-size:.75rem;color:#98A8C3;">바꿀 텍스트</label>
        <input type="text" id="pr-to"   placeholder="예: kr99.topgirl.co" />
        <button class="btn btn-primary" id="pr-check" style="width:100%;margin-top:.2rem;">변경하기</button>
        <p id="pr-msg" style="font-size:.75rem;margin:.4rem 0 0;min-height:1em;"></p>
        <div style="border-top:1px solid #2B394F;margin-top:.6rem;padding-top:.6rem;">
          <p style="color:#98A8C3;font-size:.75rem;margin:0 0 .4rem;">제목에 붙은 사이트명(탑걸·쏘걸·123av 등)을 지우고, 사이트 태그를 URL 도메인 기준으로 다시 맞춥니다.</p>
          <button class="btn btn-primary" id="pn-run" style="width:100%;">제목·태그 일괄 정리</button>
          <p id="pn-msg" style="font-size:.75rem;margin:.4rem 0 0;min-height:1em;"></p>
        </div>
      </div>
      <div class="panel-section" id="tab-rank">
        <p style="color:#98A8C3;font-size:.72rem;margin:0 0 .5rem;">제목에서 추출한 배우 언급 순위 TOP 50. 이름을 누르면 검색 페이지가 새 창으로 열립니다.</p>
        <ul id="rank-result"><li style="color:#6A7FA0;padding:.3rem 0;">집계 준비 중…</li></ul>
      </div>
      <p id="p-msg"></p>
    </div>
    <button id="ziha-toggle" title="북마크 관리">⚙️</button>
  </div>

  <script>
  (function () {
    // 탭 전환
    document.querySelectorAll('#panel-tabs button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#panel-tabs button').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.panel-section').forEach(s => s.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
        if (btn.dataset.tab === 'rank') computeRank();
      });
    });

    // 패널 토글
    document.getElementById('ziha-toggle').addEventListener('click', () => {
      const p = document.getElementById('ziha-panel');
      p.style.display = p.style.display === 'none' ? 'block' : 'none';
    });

    function msg(t, ok = true) {
      const el = document.getElementById('p-msg');
      el.style.color = ok ? '#24C292' : '#F6726A';
      el.textContent = t;
      setTimeout(() => el.textContent = '', 3000);
    }

    function parseStarParam(val) {
      if (!val) return {};
      const [star, op] = val.split('_');
      return { star, star_op: op };
    }

    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    var SITE_LABELS = ${JSON.stringify(SITE_LABELS)};
    function siteBadge(site) {
      return site ? '<span class="site site-' + esc(site) + '">' + esc(SITE_LABELS[site] || site) + '</span>' : '';
    }

    // 제목에서 배우이름(한글 성+이름) 추출
    var RANK_SITE = ['AVTopGirl','AVSogirl','AV탑걸','AV쏘걸','MissAV','MGStage','FANZA','Sogirl','TopGirl','탑걸','쏘걸'];
    var RANK_TAGS = ['유모자막','무모자막','자막판','자막','유모','무모','REMOVE','고화질','무삭제','모자이크','풀버전','유출','미리보기','합집'];
    function extractNames(title) {
      var t = String(title || '').split('|')[0];
      // NOTE: 이 스크립트는 .astro 백틱 템플릿 리터럴 안에 있어 정규식 백슬래시를 이중(\\)으로 써야 함
      t = t.replace(/\\([^)]*\\)/g, ' ');
      RANK_SITE.concat(RANK_TAGS).forEach(function (w) { t = t.split(w).join(' '); });
      t = t.replace(/\\d+\\s*세/g, ' ');
      t = t.replace(/[A-Za-z]+[A-Za-z0-9]*\\s*-?\\s*\\d+[A-Za-z]*/g, ' '); // 작품코드 제거
      t = t.replace(/[^가-힣,\\s]/g, ' ');
      var out = [];
      t.split(',').forEach(function (c) {
        c = c.replace(/\\s+/g, ' ').trim();
        if (c && c.indexOf(' ') !== -1 && c.length <= 12) out.push(c); // 성+이름 2단어만
      });
      return out;
    }

    // 순위 링크의 도메인은 북마크 URL 중 가장 많이 쓰인 topgirl 호스트에서 유도 → 주소변경 시 자동 반영
    function deriveSearchHost(rows) {
      var count = {}, best = 'kr45.topgirl.co', max = 0;
      rows.forEach(function (r) {
        try {
          var h = new URL(r.url).hostname;
          if (/topgirl/i.test(h)) count[h] = (count[h] || 0) + 1;
        } catch (e) {}
      });
      for (var h in count) if (count[h] > max) { max = count[h]; best = h; }
      return best;
    }

    async function computeRank() {
      var box = document.getElementById('rank-result');
      box.innerHTML = '<li style="color:#6A7FA0;padding:.3rem 0;">집계 중…</li>';
      try {
        var res = await fetch('/api/ziha-bookmarks').then(function (r) { return r.json(); });
        var rows = res.rows || [];
        var host = deriveSearchHost(rows);
        var counter = {};
        rows.forEach(function (r) {
          extractNames(r.title).forEach(function (name) { counter[name] = (counter[name] || 0) + 1; });
        });
        // 메모에 '은퇴'가 들어간 북마크가 하나라도 있으면 그 배우는 순위에서 완전히 제외.
        // 설명이 긴 제목은 extractNames가 이름을 못 뽑으므로, 집계된 이름이 제목에 포함되는지로 판정한다.
        var retiredTitles = rows
          .filter(function (r) { return String(r.memo || '').indexOf('은퇴') !== -1; })
          .map(function (r) { return String(r.title || '').replace(/\s+/g, ' '); });
        var names = Object.keys(counter);
        retiredTitles.forEach(function (t) {
          names.forEach(function (name) { if (t.indexOf(name) !== -1) delete counter[name]; });
        });
        var top = Object.keys(counter)
          .map(function (name) { return [name, counter[name]]; })
          .sort(function (a, b) { return b[1] - a[1] || a[0].localeCompare(b[0]); })
          .slice(0, 50);
        box.innerHTML = top.length
          ? top.map(function (e, i) {
              var link = 'https://' + host + '/video/search?keyword=' + encodeURIComponent(e[0]);
              return '<li><span class="rank-no">' + (i + 1) + '</span>' +
                '<a class="item-title" href="' + esc(link) + '" target="_blank" rel="noopener">' + esc(e[0]) + '</a>' +
                '<span class="rank-cnt">' + e[1] + '회</span></li>';
            }).join('')
          : '<li style="color:#6A7FA0;padding:.3rem 0;">데이터 없음</li>';
      } catch (e) {
        box.innerHTML = '<li style="color:#F6726A;padding:.3rem 0;">집계 실패</li>';
      }
    }

    // 메인 검색
    async function mainSearch() {
      const q    = document.getElementById('sq').value.trim();
      const { star, star_op } = parseStarParam(document.getElementById('sstar').value);
      const site = document.getElementById('ssite').value;
      const p = new URLSearchParams();
      if (q)       p.set('q', q);
      if (star)    p.set('star', star);
      if (star_op) p.set('star_op', star_op);
      if (site)    p.set('site', site);
      const { rows } = await fetch('/api/ziha-bookmarks?' + p).then(r => r.json());
      document.getElementById('bm-list').innerHTML = rows.length
        ? rows.map(r => '<li>' + (r.star > 0 ? '<span class="star">' + '★'.repeat(r.star) + '</span>' : '') + '<a href="' + esc(r.url) + '" target="_blank" rel="noopener">' + esc(r.title) + '</a>' + siteBadge(r.site) + (r.memo ? '<span class="memo">' + esc(r.memo) + '</span>' : '') + '</li>').join('')
        : '<li style="color:#6A7FA0;">결과 없음</li>';
    }

    document.getElementById('sbtn').addEventListener('click', mainSearch);
    // 검색 자동완성: 배우이름·메모·제목 (첫 포커스 때 전체 목록을 한 번 받아 둔다)
    var acData = null, acItems = [], acIdx = -1;
    var sqEl = document.getElementById('sq');
    var acBox = document.getElementById('sq-ac');
    async function loadAc() {
      if (acData) return acData;
      var res = await fetch('/api/ziha-bookmarks').then(function (r) { return r.json(); });
      var names = {}, memos = {}, titles = {};
      (res.rows || []).forEach(function (r) {
        extractNames(r.title).forEach(function (n) { names[n] = (names[n] || 0) + 1; });
        var m = String(r.memo || '').trim();
        if (m) memos[m] = (memos[m] || 0) + 1;
        var t = String(r.title || '').trim();
        if (t) titles[t] = 1;
      });
      var byCount = function (o) {
        return Object.keys(o).map(function (k) { return [k, o[k]]; }).sort(function (a, b) { return b[1] - a[1]; });
      };
      acData = { names: byCount(names), memos: byCount(memos), titles: Object.keys(titles) };
      return acData;
    }
    function acClose() { acBox.style.display = 'none'; acItems = []; acIdx = -1; }
    function acRender() {
      if (!acItems.length) { acClose(); return; }
      acBox.innerHTML = acItems.map(function (it, i) {
        return '<li data-i="' + i + '"' + (i === acIdx ? ' class="on"' : '') + '>' +
          '<span class="ac-kind ac-' + it.kind + '">' + it.label + '</span>' +
          '<span class="ac-text">' + esc(it.text) + '</span>' +
          (it.cnt ? '<span class="ac-cnt">' + it.cnt + '</span>' : '') + '</li>';
      }).join('');
      acBox.style.left = sqEl.offsetLeft + 'px';
      acBox.style.top = (sqEl.offsetTop + sqEl.offsetHeight + 2) + 'px';
      acBox.style.width = sqEl.offsetWidth + 'px';
      acBox.style.display = 'block';
      var on = acBox.querySelector('li.on');
      if (on) on.scrollIntoView({ block: 'nearest' });
    }
    async function acUpdate() {
      var q = sqEl.value.trim().toLowerCase();
      if (!q) { acClose(); return; }
      var d = await loadAc();
      if (sqEl.value.trim().toLowerCase() !== q) return; // 기다리는 사이 입력이 바뀌었으면 버린다
      var hit = function (s) { return s.toLowerCase().indexOf(q) !== -1; };
      var out = [];
      d.names.filter(function (e) { return hit(e[0]); }).slice(0, 5)
        .forEach(function (e) { out.push({ kind: 'name', label: '배우', text: e[0], cnt: e[1] }); });
      d.memos.filter(function (e) { return hit(e[0]); }).slice(0, 5)
        .forEach(function (e) { out.push({ kind: 'memo', label: '메모', text: e[0], cnt: e[1] }); });
      d.titles.filter(hit).slice(0, 8)
        .forEach(function (t) { out.push({ kind: 'title', label: '제목', text: t }); });
      acItems = out; acIdx = -1; acRender();
    }
    function acPick(i) {
      var it = acItems[i];
      if (!it) return;
      sqEl.value = it.text;
      acClose();
      mainSearch();
    }
    sqEl.addEventListener('input', acUpdate);
    sqEl.addEventListener('focus', function () { loadAc(); if (sqEl.value.trim()) acUpdate(); });
    sqEl.addEventListener('keydown', function (e) {
      if (e.isComposing || e.keyCode === 229) return; // 한글 조합 중 Enter·화살표는 무시
      var open = acBox.style.display === 'block' && acItems.length > 0;
      if (e.key === 'ArrowDown' && open) { e.preventDefault(); acIdx = (acIdx + 1) % acItems.length; acRender(); return; }
      if (e.key === 'ArrowUp' && open) { e.preventDefault(); acIdx = acIdx <= 0 ? acItems.length - 1 : acIdx - 1; acRender(); return; }
      if (e.key === 'Escape') { acClose(); return; }
      if (e.key === 'Enter') {
        if (open && acIdx >= 0) acPick(acIdx);
        else { acClose(); mainSearch(); }
      }
    });
    acBox.addEventListener('mousedown', function (e) {
      var li = e.target.closest('li[data-i]');
      if (!li) return;
      e.preventDefault(); // 입력창 blur 보다 먼저 고른다
      acPick(Number(li.dataset.i));
    });
    document.addEventListener('click', function (e) {
      if (e.target !== sqEl && !acBox.contains(e.target)) acClose();
    });
    document.getElementById('ssite').addEventListener('change', mainSearch);
    document.getElementById('sbtn-reset').addEventListener('click', () => location.reload());

    document.getElementById('sbtn-open').addEventListener('click', async () => {
      const q = document.getElementById('sq').value.trim();
      const { star, star_op } = parseStarParam(document.getElementById('sstar').value);
      const site = document.getElementById('ssite').value;
      const p = new URLSearchParams();
      if (q)       p.set('q', q);
      if (star)    p.set('star', star);
      if (star_op) p.set('star_op', star_op);
      if (site)    p.set('site', site);
      const { rows } = await fetch('/api/ziha-bookmarks?' + p).then(r => r.json());
      rows.forEach((r, i) => setTimeout(() => {
        const w = window.open(r.url, '_blank', 'noopener,noreferrer');
        if (w) { w.blur(); window.focus(); }
      }, i * 100));
    });

    // 추가
    document.getElementById('p-add').addEventListener('click', async () => {
      const title = document.getElementById('p-title').value.trim();
      const url   = document.getElementById('p-url').value.trim();
      const memo  = document.getElementById('p-memo').value.trim();
      const star  = parseInt(document.getElementById('p-star').value);
      if (!title || !url) { msg('제목과 URL을 입력하세요.', false); return; }
      const res = await fetch('/api/ziha-bookmarks', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, url, star, memo: memo || undefined }),
      });
      if (res.ok) {
        document.getElementById('p-title').value = '';
        document.getElementById('p-url').value   = '';
        document.getElementById('p-memo').value  = '';
        document.getElementById('p-star').value  = '0';
        const saved = await res.json();
        msg('추가됨' + (saved.site ? ' [' + (SITE_LABELS[saved.site] || saved.site) + ']' : '') + ': ' + saved.title + ' (새로고침 시 목록에 반영)');
      } else { msg('저장 실패', false); }
    });

    // 패널 검색
    async function panelSearch() {
      const q    = document.getElementById('ps-q').value.trim();
      const { star, star_op } = parseStarParam(document.getElementById('ps-star').value);
      const site = document.getElementById('ps-site').value;
      const p = new URLSearchParams();
      if (q)       p.set('q', q);
      if (star)    p.set('star', star);
      if (star_op) p.set('star_op', star_op);
      if (site)    p.set('site', site);
      const { rows } = await fetch('/api/ziha-bookmarks?' + p).then(r => r.json());
      const ul = document.getElementById('p-result');
      ul.innerHTML = '';
      if (!rows.length) { ul.innerHTML = '<li style="color:#6A7FA0;padding:.3rem 0;">결과 없음</li>'; return; }
      for (const r of rows) {
        const li = document.createElement('li');
        li.innerHTML =
          '<span class="star" style="color:#FACB3D;font-size:.7rem;flex-shrink:0;">' + '★'.repeat(r.star) + '</span>' +
          siteBadge(r.site) +
          '<a class="item-title" href="' + esc(r.url) + '" target="_blank" rel="noopener">' + esc(r.title) + (r.memo ? ' <span style="color:#6A7FA0;font-size:.7rem;">— ' + esc(r.memo) + '</span>' : '') + '</a>' +
          '<button class="btn btn-primary btn-sm" data-id="' + r.id + '" data-title="' + esc(r.title) + '" data-url="' + esc(r.url) + '" data-star="' + r.star + '" data-memo="' + esc(r.memo || '') + '" data-sort="' + (r.sort == null ? '' : r.sort) + '">편집</button>' +
          '<button class="btn btn-danger  btn-sm" data-del="' + r.id + '">삭제</button>';
        ul.appendChild(li);
      }
      ul.querySelectorAll('[data-del]').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm('삭제할까요?')) return;
          await fetch('/api/ziha-bookmarks', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: Number(btn.dataset.del) }) });
          msg('삭제됨.');
          document.getElementById('p-edit-form').style.display = 'none';
          panelSearch();
        });
      });
      ul.querySelectorAll('[data-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.getElementById('pe-id').value    = btn.dataset.id;
          document.getElementById('pe-title').value = btn.dataset.title;
          document.getElementById('pe-url').value   = btn.dataset.url;
          document.getElementById('pe-memo').value  = btn.dataset.memo;
          document.getElementById('pe-star').value  = btn.dataset.star;
          document.getElementById('pe-sort').value  = btn.dataset.sort;
          document.getElementById('p-edit-form').style.display = 'block';
          document.getElementById('pe-title').focus();
        });
      });
    }

    document.getElementById('ps-btn').addEventListener('click', panelSearch);
    document.getElementById('ps-q').addEventListener('keydown', e => { if (e.key === 'Enter') panelSearch(); });

    document.getElementById('pe-save').addEventListener('click', async () => {
      const id    = Number(document.getElementById('pe-id').value);
      const title = document.getElementById('pe-title').value.trim();
      const url   = document.getElementById('pe-url').value.trim();
      const memo  = document.getElementById('pe-memo').value.trim();
      const star  = Number(document.getElementById('pe-star').value);
      const sortRaw = document.getElementById('pe-sort').value;
      const sort  = sortRaw === '' ? null : Number(sortRaw);
      if (!title || !url) { msg('제목과 URL을 입력하세요.', false); return; }
      const res = await fetch('/api/ziha-bookmarks', {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, title, url, memo, star, sort }),
      });
      if (res.ok) {
        msg('수정됨.');
        document.getElementById('p-edit-form').style.display = 'none';
        panelSearch();
      } else { msg('수정 실패', false); }
    });

    document.getElementById('pe-cancel').addEventListener('click', () => {
      document.getElementById('p-edit-form').style.display = 'none';
    });

    // 주소변경
    function prMsg(t, ok = true) {
      const el = document.getElementById('pr-msg');
      el.style.color = ok ? '#24C292' : '#F6726A';
      el.textContent = t;
    }

    document.getElementById('pr-check').addEventListener('click', async () => {
      const from = document.getElementById('pr-from').value.trim();
      const to   = document.getElementById('pr-to').value.trim();
      if (!from) { prMsg('찾을 텍스트를 입력하세요.', false); return; }

      const { count } = await fetch('/api/ziha-bookmarks', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ from, to, preview: true }),
      }).then(r => r.json());

      if (count === 0) { prMsg('일치하는 링크가 없습니다.', false); return; }

      if (!confirm(count + '개의 링크 URL에서 "' + from + '" → "' + to + '" 로 교체하시겠습니까?')) return;

      const res = await fetch('/api/ziha-bookmarks', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ from, to, preview: false }),
      });
      const data = await res.json();
      if (res.ok) {
        prMsg(data.updated + '개 링크 URL 교체 완료.');
        document.getElementById('pr-from').value = '';
        document.getElementById('pr-to').value   = '';
      } else {
        prMsg('교체 실패: ' + (data.error ?? ''), false);
      }
    });

    // 제목·태그 일괄 정리
    function pnMsg(t, ok = true) {
      const el = document.getElementById('pn-msg');
      el.style.color = ok ? '#080' : '#c00';
      el.textContent = t;
    }

    document.getElementById('pn-run').addEventListener('click', async () => {
      const pv = await fetch('/api/ziha-bookmarks', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'normalize', preview: true }),
      }).then(r => r.json());
      if (!pv.count) { pnMsg('정리할 항목이 없습니다.'); return; }
      const sample = (pv.samples || []).map(s => '  ' + s.before + '\\n→ ' + s.after).join('\\n');
      if (!confirm('제목 ' + pv.titleCount + '건, 태그 ' + pv.siteCount + '건을 정리합니다.' + (sample ? '\\n\\n예시:\\n' + sample : ''))) return;
      const res = await fetch('/api/ziha-bookmarks', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'normalize', preview: false }),
      });
      const data = await res.json();
      if (res.ok) pnMsg(data.updated + '건 정리 완료. 새로고침 시 반영됩니다.');
      else pnMsg('정리 실패: ' + (data.error ?? ''), false);
    });
  })();
  </script>
</body>
</html>`;

  return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}

const isError = Astro.request.method === 'POST';
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>인증</title>
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0B1628" />
    <style>
      html { color-scheme: dark; background: #07101F; }
      body { font-family: Inter, 'Pretendard Variable', Pretendard, system-ui, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #07101F; color: #CAD3E2; }
      input[type="text"], input[type="password"] { padding: .6rem .8rem; background: #07101F; color: #E3E8F2; border: 1px solid #2B394F; border-radius: 4px; font-size: 1rem; width: 100%; box-sizing: border-box; }
      button { padding: .6rem; background: #61A2FF; color: #07101F; font-weight: 500; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; width: 100%; }
      button:hover { background: #8BBAFF; }
      input::placeholder { color: #6A7FA0; }
      input:focus { outline: none; border-color: #61A2FF; box-shadow: 0 0 0 1px #61A2FF; }
      .error { color: #F6726A; font-size: .875rem; }
    </style>
  </head>
  <body>
    <div style="display:flex;flex-direction:column;gap:1rem;width:280px;">
      <form method="POST" style="background:#0B1628;border:1px solid #2B394F;padding:2rem;border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.35);display:flex;flex-direction:column;gap:1rem;">
        <label style="font-weight:600;color:#E3E8F2">오늘의 코드</label>
        <input type="text" name="token" autocomplete="off" autofocus placeholder="xxxxxxxx" />
        {isError && <span class="error">잘못된 코드입니다.</span>}
        <button type="submit">확인</button>
      </form>

      <details style="background:#0B1628;border:1px solid #2B394F;padding:1rem 1.5rem;border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.35);font-size:.875rem;">
        <summary style="cursor:pointer;font-weight:600;color:#98A8C3;">코드 계산기</summary>
        <div style="margin-top:.75rem;display:flex;flex-direction:column;gap:.5rem;">
          <input id="calc-secret" type="password" placeholder="비밀키 입력" style="letter-spacing:.15em;" />
          <button id="calc-btn" type="button">오늘 코드 보기</button>
          <code id="calc-result" style="display:none;text-align:center;font-size:1.4rem;letter-spacing:.2em;padding:.5rem;background:#0E1A2E;color:#E3E8F2;border-radius:4px;"></code>
        </div>
      </details>
    </div>

    <script>
      document.getElementById('calc-btn').addEventListener('click', async () => {
        const secret = document.getElementById('calc-secret').value.trim();
        if (!secret) return;
        const date = new Date().toISOString().slice(0, 10).replace(/-/g, '');
        const key = await crypto.subtle.importKey('raw', new TextEncoder().encode(secret),
          { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
        const sig = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(date));
        const token = [...new Uint8Array(sig)].map(b => b.toString(16).padStart(2, '0')).join('').slice(0, 8);
        const result = document.getElementById('calc-result');
        result.textContent = token;
        result.style.display = 'block';
      });
    </script>
  </body>
</html>

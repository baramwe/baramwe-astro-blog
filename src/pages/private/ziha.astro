      var hit = function (s) { return s.toLowerCase().indexOf(q) !== -1; };
      var out = [];
      d.names.filter(function (e) { return hit(e[0]); }).slice(0, 5)
        .forEach(function (e) { out.push({ kind: 'name', label: '배우', text: e[0], cnt: e[1] }); });
      d.memos.filter(function (e) { return hit(e[0]); }).slice(0, 5)
        .forEach(function (e) { out.push({ kind: 'memo', label: '메모', text: e[0], cnt: e[1] }); });
      d.titles.filter(hit).slice(0, 8)
        .forEach(function (t) { out.push({ kind: 'title', label: '제목', text: t }); });
      acItems = out; acIdx = -1; acRender();
    }
    function acPick(i) {
      var it = acItems[i];
      if (!it) return;
      sqEl.value = it.text;
      state.q = it.text;
      acClose();
      render();
    }
    var searchTimer = null;
    sqEl.addEventListener('input', function () {
      acUpdate();
      clearTimeout(searchTimer);
      searchTimer = setTimeout(function () { state.q = sqEl.value.trim(); render(); }, 120);
    });
    sqEl.addEventListener('focus', function () { if (sqEl.value.trim()) acUpdate(); });
    sqEl.addEventListener('keydown', function (e) {
      if (e.isComposing || e.keyCode === 229) return; // 한글 조합 중 Enter·화살표는 무시
      var open = acBox.style.display === 'block' && acItems.length > 0;
      if (e.key === 'ArrowDown' && open) { e.preventDefault(); acIdx = (acIdx + 1) % acItems.length; acRender(); return; }
      if (e.key === 'ArrowUp' && open) { e.preventDefault(); acIdx = acIdx <= 0 ? acItems.length - 1 : acIdx - 1; acRender(); return; }
      if (e.key === 'Escape') { acClose(); return; }
      if (e.key === 'Enter') {
        if (open && acIdx >= 0) { e.preventDefault(); acPick(acIdx); }
        else { acClose(); clearTimeout(searchTimer); state.q = sqEl.value.trim(); render(); }
      }
    });
    acBox.addEventListener('mousedown', function (e) {
      var li = e.target.closest('li[data-i]');
      if (!li) return;
      e.preventDefault(); // 입력창 blur 보다 먼저 고른다
      acPick(Number(li.dataset.i));
    });
    document.addEventListener('click', function (e) {
      if (e.target !== sqEl && !acBox.contains(e.target)) acClose();
    });
    // '/' 로 검색창 포커스 (입력 중일 때는 무시)
    document.addEventListener('keydown', function (e) {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      var tag = (document.activeElement && document.activeElement.tagName) || '';
      if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
      e.preventDefault();
      sqEl.focus();
    });

    document.getElementById('sstar').addEventListener('change', function (e) { state.star = e.target.value; render(); });
    document.getElementById('sgroup').addEventListener('change', function (e) { state.group = e.target.value; render(); });
    document.getElementById('sbtn-reset').addEventListener('click', function () {
      state = { q: '', star: '', site: '', memo: '', actor: [], group: 'sort' };
      sqEl.value = '';
      document.getElementById('sstar').value = '';
      document.getElementById('sgroup').value = 'sort';
      acClose();
      render();
    });

    // 열기: 지금 화면에 걸러진 북마크를 모두 새 탭으로 연다.
    document.getElementById('sbtn-open').addEventListener('click', function () {
      var rows = current.slice();
      if (!rows.length) return;
      if (rows.length > 30 && !confirm(rows.length + '개를 모두 새 탭으로 열까요?')) return;
      rows.forEach(function (r, i) {
        setTimeout(function () {
          var w = window.open(fullUrl(r.url), '_blank', 'noopener,noreferrer');
          if (w) { w.blur(); window.focus(); }
        }, i * 100);
      });
    });

    buildChips();
    render();

    // 추가
    document.getElementById('p-add').addEventListener('click', async () => {
      const title = document.getElementById('p-title').value.trim();
      const url   = document.getElementById('p-url').value.trim();
      const memo  = document.getElementById('p-memo').value.trim();
      const star  = parseInt(document.getElementById('p-star').value);
      if (!title || !url) { msg('제목과 URL을 입력하세요.', false); return; }
      const res = await fetch('/api/ziha-bookmarks', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ title, url, star, memo: memo || undefined }),
      });
      if (res.ok) {
        document.getElementById('p-title').value = '';
        document.getElementById('p-url').value   = '';
        document.getElementById('p-memo').value  = '';
        document.getElementById('p-star').value  = '0';
        const saved = await res.json();
        msg('추가됨' + (saved.site ? ' [' + (SITE_LABELS[saved.site] || saved.site) + ']' : '') + ': ' + saved.title + ' (새로고침 시 목록에 반영)');
      } else { msg('저장 실패', false); }
    });

    // 패널 검색
    async function panelSearch() {
      const q    = document.getElementById('ps-q').value.trim();
      const { star, star_op } = parseStarParam(document.getElementById('ps-star').value);
      const site = document.getElementById('ps-site').value;
      const p = new URLSearchParams();
      if (q)       p.set('q', q);
      if (star)    p.set('star', star);
      if (star_op) p.set('star_op', star_op);
      if (site)    p.set('site', site);
      const { rows } = await fetch('/api/ziha-bookmarks?' + p).then(r => r.json());
      const ul = document.getElementById('p-result');
      ul.innerHTML = '';
      if (!rows.length) { ul.innerHTML = '<li style="color:#6A7FA0;padding:.3rem 0;">결과 없음</li>'; return; }
      for (const r of rows) {
        const li = document.createElement('li');
        li.innerHTML =
          '<span class="star" style="color:#FACB3D;font-size:.7rem;flex-shrink:0;">' + '★'.repeat(r.star) + '</span>' +
          siteBadge(r.site) +
          '<a class="item-title" href="' + esc(r.url) + '" target="_blank" rel="noopener">' + esc(r.title) + (r.memo ? ' <span style="color:#6A7FA0;font-size:.7rem;">— ' + esc(r.memo) + '</span>' : '') + '</a>' +
          '<button class="btn btn-primary btn-sm" data-id="' + r.id + '" data-title="' + esc(r.title) + '" data-url="' + esc(r.url) + '" data-star="' + r.star + '" data-memo="' + esc(r.memo || '') + '" data-sort="' + (r.sort == null ? '' : r.sort) + '">편집</button>' +
          '<button class="btn btn-danger  btn-sm" data-del="' + r.id + '">삭제</button>';
        ul.appendChild(li);
      }
      ul.querySelectorAll('[data-del]').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm('삭제할까요?')) return;
          await fetch('/api/ziha-bookmarks', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: Number(btn.dataset.del) }) });
          msg('삭제됨.');
          document.getElementById('p-edit-form').style.display = 'none';
          panelSearch();
        });
      });
      ul.querySelectorAll('[data-id]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.getElementById('pe-id').value    = btn.dataset.id;
          document.getElementById('pe-title').value = btn.dataset.title;
          document.getElementById('pe-url').value   = btn.dataset.url;
          document.getElementById('pe-memo').value  = btn.dataset.memo;
          document.getElementById('pe-star').value  = btn.dataset.star;
          document.getElementById('pe-sort').value  = btn.dataset.sort;
          document.getElementById('p-edit-form').style.display = 'block';
          document.getElementById('pe-title').focus();
        });
      });
    }

    document.getElementById('ps-btn').addEventListener('click', panelSearch);
    document.getElementById('ps-q').addEventListener('keydown', e => { if (e.key === 'Enter') panelSearch(); });

    document.getElementById('pe-save').addEventListener('click', async () => {
      const id    = Number(document.getElementById('pe-id').value);
      const title = document.getElementById('pe-title').value.trim();
      const url   = document.getElementById('pe-url').value.trim();
      const memo  = document.getElementById('pe-memo').value.trim();
      const star  = Number(document.getElementById('pe-star').value);
      const sortRaw = document.getElementById('pe-sort').value;
      const sort  = sortRaw === '' ? null : Number(sortRaw);
      if (!title || !url) { msg('제목과 URL을 입력하세요.', false); return; }
      const res = await fetch('/api/ziha-bookmarks', {
        method: 'PATCH', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, title, url, memo, star, sort }),
      });
      if (res.ok) {
        msg('수정됨.');
        document.getElementById('p-edit-form').style.display = 'none';
        panelSearch();
      } else { msg('수정 실패', false); }
    });

    document.getElementById('pe-cancel').addEventListener('click', () => {
      document.getElementById('p-edit-form').style.display = 'none';
    });

    // 주소변경
    function prMsg(t, ok = true) {
      const el = document.getElementById('pr-msg');
      el.style.color = ok ? '#24C292' : '#F6726A';
      el.textContent = t;
    }

    document.getElementById('pr-check').addEventListener('click', async () => {
      const from = document.getElementById('pr-from').value.trim();
      const to   = document.getElementById('pr-to').value.trim();
      if (!from) { prMsg('찾을 텍스트를 입력하세요.', false); return; }

      const { count } = await fetch('/api/ziha-bookmarks', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ from, to, preview: true }),
      }).then(r => r.json());

      if (count === 0) { prMsg('일치하는 링크가 없습니다.', false); return; }

      if (!confirm(count + '개의 링크 URL에서 "' + from + '" → "' + to + '" 로 교체하시겠습니까?')) return;

      const res = await fetch('/api/ziha-bookmarks', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ from, to, preview: false }),
      });
      const data = await res.json();
      if (res.ok) {
        prMsg(data.updated + '개 링크 URL 교체 완료.');
        document.getElementById('pr-from').value = '';
        document.getElementById('pr-to').value   = '';
      } else {
        prMsg('교체 실패: ' + (data.error ?? ''), false);
      }
    });

    // 제목·태그 일괄 정리
    function pnMsg(t, ok = true) {
      const el = document.getElementById('pn-msg');
      el.style.color = ok ? '#080' : '#c00';
      el.textContent = t;
    }

    document.getElementById('pn-run').addEventListener('click', async () => {
      const pv = await fetch('/api/ziha-bookmarks', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'normalize', preview: true }),
      }).then(r => r.json());
      if (!pv.count) { pnMsg('정리할 항목이 없습니다.'); return; }
      const sample = (pv.samples || []).map(s => '  ' + s.before + '\\n→ ' + s.after).join('\\n');
      if (!confirm('제목 ' + pv.titleCount + '건, 태그 ' + pv.siteCount + '건을 정리합니다.' + (sample ? '\\n\\n예시:\\n' + sample : ''))) return;
      const res = await fetch('/api/ziha-bookmarks', {
        method: 'PUT', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'normalize', preview: false }),
      });
      const data = await res.json();
      if (res.ok) pnMsg(data.updated + '건 정리 완료. 새로고침 시 반영됩니다.');
      else pnMsg('정리 실패: ' + (data.error ?? ''), false);
    });
  })();
  </script>
</body>
</html>`;

  return new Response(html, { headers: { 'Content-Type': 'text/html; charset=utf-8' } });
}

const isError = Astro.request.method === 'POST';
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>인증</title>
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0B1628" />
    <style>
      html { color-scheme: dark; background: #07101F; }
      body { font-family: Inter, 'Pretendard Variable', Pretendard, system-ui, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #07101F; color: #CAD3E2; }
      input[type="text"], input[type="password"] { padding: .6rem .8rem; background: #07101F; color: #E3E8F2; border: 1px solid #2B394F; border-radius: 4px; font-size: 1rem; width: 100%; box-sizing: border-box; }
      button { padding: .6rem; background: #61A2FF; color: #07101F; font-weight: 500; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; width: 100%; }
      button:hover { background: #8BBAFF; }
      input::placeholder { color: #6A7FA0; }
      input:focus { outline: none; border-color: #61A2FF; box-shadow: 0 0 0 1px #61A2FF; }
      .error { color: #F6726A; font-size: .875rem; }
    </style>
  </head>
  <body>
    <div style="display:flex;flex-direction:column;gap:1rem;width:280px;">
      <form method="POST" style="background:#0B1628;border:1px solid #2B394F;padding:2rem;border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.35);display:flex;flex-direction:column;gap:1rem;">
        <label style="font-weight:600;color:#E3E8F2">오늘의 코드</label>
        <input type="text" name="token" autocomplete="off" autofocus placeholder="xxxxxxxx" />
        {isError && <span class="error">잘못된 코드입니다.</span>}
        <button type="submit">확인</button>
      </form>

      <details style="background:#0B1628;border:1px solid #2B394F;padding:1rem 1.5rem;border-radius:8px;box-shadow:0 1px 2px rgba(0,0,0,.35);font-size:.875rem;">
        <summary style="cursor:pointer;font-weight:600;color:#98A8C3;">코드 계산기</summary>
        <div style="margin-top:.75rem;display:flex;flex-direction:column;gap:.5rem;">
          <input id="calc-secret" type="password" placeholder="비밀키 입력" style="letter-spacing:.15em;" />
          <button id="calc-btn" type="button">오늘 코드 보기</button>
          <code id="calc-result" style="display:none;text-align:center;font-size:1.4rem;letter-spacing:.2em;padding:.5rem;background:#0E1A2E;color:#E3E8F2;border-radius:4px;"></code>
        </div>
      </details>
    </div>

    <script>
      document.getElementById('calc-btn').addEventListener('click', async () => {
        const secret = document.getElementById('calc-secret').value.trim();
        if (!secret) return;
        const date = new Date().toISOString().slice(0, 10).replace(/-/g, '');
        const key = await crypto.subtle.importKey('raw', new TextEncoder().encode(secret),
          { name: 'HMAC', hash: 'SHA-256' }, false, ['sign']);
        const sig = await crypto.subtle.sign('HMAC', key, new TextEncoder().encode(date));
        const token = [...new Uint8Array(sig)].map(b => b.toString(16).padStart(2, '0')).join('').slice(0, 8);
        const result = document.getElementById('calc-result');
        result.textContent = token;
        result.style.display = 'block';
      });
    </script>
  </body>
</html>

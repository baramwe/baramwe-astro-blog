    </div>
    <button id="ziha-toggle" title="북마크 관리">⚙️</button>
  </div>

  <script>
  (function () {
    // 탭 전환
    document.querySelectorAll('#panel-tabs button').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#panel-tabs button').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.panel-section').forEach(s => s.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
        if (btn.dataset.tab === 'rank') computeRank();
      });
    });

    // 패널 토글
    document.getElementById('ziha-toggle').addEventListener('click', () => {
      const p = document.getElementById('ziha-panel');
      p.style.display = p.style.display === 'none' ? 'block' : 'none';
    });

    function msg(t, ok = true) {
      const el = document.getElementById('p-msg');
      el.style.color = ok ? '#24C292' : '#F6726A';
      el.textContent = t;
      setTimeout(() => el.textContent = '', 3000);
    }

    function parseStarParam(val) {
      if (!val) return {};
      const [star, op] = val.split('_');
      return { star, star_op: op };
    }

    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    var SITE_LABELS = ${JSON.stringify(SITE_LABELS)};
    function siteBadge(site) {
      return site ? '<span class="site site-' + esc(site) + '">' + esc(SITE_LABELS[site] || site) + '</span>' : '';
    }

    // 제목에서 배우이름(한글 성+이름) 추출
    var RANK_SITE = ['AVTopGirl','AVSogirl','AV탑걸','AV쏘걸','MissAV','MGStage','FANZA','Sogirl','TopGirl','탑걸','쏘걸'];
    var RANK_TAGS = ['유모자막','무모자막','자막판','자막','유모','무모','REMOVE','고화질','무삭제','모자이크','풀버전','유출','미리보기','합집'];
    function extractNames(title) {
      var t = String(title || '').split('|')[0];
      // NOTE: 이 스크립트는 .astro 백틱 템플릿 리터럴 안에 있어 정규식 백슬래시를 이중(\\)으로 써야 함
      t = t.replace(/\\([^)]*\\)/g, ' ');
      RANK_SITE.concat(RANK_TAGS).forEach(function (w) { t = t.split(w).join(' '); });
      t = t.replace(/\\d+\\s*세/g, ' ');
      t = t.replace(/[A-Za-z]+[A-Za-z0-9]*\\s*-?\\s*\\d+[A-Za-z]*/g, ' '); // 작품코드 제거
      t = t.replace(/[^가-힣,\\s]/g, ' ');
      var out = [];
      t.split(',').forEach(function (c) {
        c = c.replace(/\\s+/g, ' ').trim();
        if (c && c.indexOf(' ') !== -1 && c.length <= 12) out.push(c); // 성+이름 2단어만
      });
      return out;
    }

    // 순위 링크의 도메인은 북마크 URL 중 가장 많이 쓰인 topgirl 호스트에서 유도 → 주소변경 시 자동 반영
    function deriveSearchHost(rows) {
      var count = {}, best = 'kr45.topgirl.co', max = 0;
      rows.forEach(function (r) {
        try {
          var h = new URL(r.url).hostname;
          if (/topgirl/i.test(h)) count[h] = (count[h] || 0) + 1;
        } catch (e) {}
      });
      for (var h in count) if (count[h] > max) { max = count[h]; best = h; }
      return best;
    }

    async function computeRank() {
      var box = document.getElementById('rank-result');
      box.innerHTML = '<li style="color:#6A7FA0;padding:.3rem 0;">집계 중…</li>';
      try {
        var res = await fetch('/api/ziha-bookmarks').then(function (r) { return r.json(); });
        var rows = res.rows || [];
        var host = deriveSearchHost(rows);
        var counter = {};
        rows.forEach(function (r) {
          extractNames(r.title).forEach(function (name) { counter[name] = (counter[name] || 0) + 1; });
        });
        // 메모에 '은퇴'가 들어간 북마크가 하나라도 있으면 그 배우는 순위에서 완전히 제외.
        // 설명이 긴 제목은 extractNames가 이름을 못 뽑으므로, 집계된 이름이 제목에 포함되는지로 판정한다.
        var retiredTitles = rows
          .filter(function (r) { return String(r.memo || '').indexOf('은퇴') !== -1; })
          .map(function (r) { return String(r.title || '').replace(/\s+/g, ' '); });
        var names = Object.keys(counter);
        retiredTitles.forEach(function (t) {
          names.forEach(function (name) { if (t.indexOf(name) !== -1) delete counter[name]; });
        });
        var top = Object.keys(counter)
          .map(function (name) { return [name, counter[name]]; })
          .sort(function (a, b) { return b[1] - a[1] || a[0].localeCompare(b[0]); })
          .slice(0, 50);
        box.innerHTML = top.length
          ? top.map(function (e, i) {
              var link = 'https://' + host + '/video/search?keyword=' + encodeURIComponent(e[0]);
              return '<li><span class="rank-no">' + (i + 1) + '</span>' +
                '<a class="item-title" href="' + esc(link) + '" target="_blank" rel="noopener">' + esc(e[0]) + '</a>' +
                '<span class="rank-cnt">' + e[1] + '회</span></li>';
            }).join('')
          : '<li style="color:#6A7FA0;padding:.3rem 0;">데이터 없음</li>';
      } catch (e) {
        box.innerHTML = '<li style="color:#F6726A;padding:.3rem 0;">집계 실패</li>';
      }
    }

    // ── 메인 목록: 서버가 심어 둔 전체 북마크를 필터·분류해서 카드로 그린다 ──
    var ALL = JSON.parse(document.getElementById('bm-data').textContent || '[]');
    var SITE_KEYS = Object.keys(SITE_LABELS);
    var SORT_LABELS = { '0': '고정', '1': '즐겨찾기', '2': '기본' };
    var state = { q: '', star: '', site: '', memo: '', actor: [], group: 'sort' }; // actor 는 여러 명 선택(OR)
    var current = [];
    var listEl = document.getElementById('bm-list');

    function fullUrl(u) { u = String(u || ''); return u.indexOf('://') === -1 ? 'https://' + u : u; }
    function hostOf(u) { try { return new URL(fullUrl(u)).host; } catch (e) { return String(u || ''); } }
    function memoOf(r) { return String(r.memo || '').trim(); }
    // 메모는 '|' 로 여러 키워드를 담는다 (예: "학생|학교|선생") — 칩·필터·태그·분류는 키워드 단위로 본다.
    function splitMemo(s) {
      var out = [];
      String(s || '').split('|').forEach(function (t) { t = t.trim(); if (t && out.indexOf(t) === -1) out.push(t); });
      return out;
    }
    function memosOf(r) { return splitMemo(r.memo); }
    function displayTitle(t) { var s = String(t || '').split('🔳').join('').trim(); return s || String(t || ''); }

    // 검색어는 API 와 같은 규칙: '&&' 로 나누면 AND, 각 단어는 제목·메모에서 찾는다.
    function matches(r) {
      if (state.q) {
        var terms = state.q.indexOf('&&') !== -1 ? state.q.split('&&') : [state.q];
        var hay = (String(r.title || '') + ' ' + memoOf(r)).toLowerCase();
        for (var i = 0; i < terms.length; i++) {
          var t = terms[i].trim().toLowerCase();
          if (t && hay.indexOf(t) === -1) return false;
        }
      }
      if (state.star) {
        var p = state.star.split('_'), n = Number(p[0]);
        if (p[1] === 'eq' ? r.star !== n : r.star < n) return false;
      }
      if (state.site && (state.site === 'none' ? !!r.site : r.site !== state.site)) return false;
      if (state.memo && memosOf(r).indexOf(state.memo) === -1) return false;
      if (state.actor.length) { // 고른 배우 중 한 명이라도 제목에 있으면 보인다
        var nt = normTitle(r.title);
        if (!state.actor.some(function (a) { return nt.indexOf(a) !== -1; })) return false;
      }
      return true;
    }

    // 섹션 안 순서는 항상 서버 정렬(sort 그룹 → 최근 등록순)을 그대로 따른다.
    function groupsOf(rows) {
      var order = [], map = {};
      function add(k, label, r) {
        if (!map[k]) { map[k] = { label: label, rows: [] }; order.push(k); }
        map[k].rows.push(r);
      }
      if (state.group === 'site') {
        rows.forEach(function (r) { add(r.site || '~', r.site ? (SITE_LABELS[r.site] || r.site) : '기타', r); });
        var idx = function (k) { var i = SITE_KEYS.indexOf(k); return i === -1 ? 999 : i; };
        order.sort(function (a, b) { return idx(a) - idx(b); });
      } else if (state.group === 'memo') {
        rows.forEach(function (r) {
          var ms = memosOf(r);
          if (!ms.length) add('~', '메모 없음', r);
          ms.forEach(function (m) { add(m, m, r); }); // 키워드가 여러 개면 각 섹션에 모두 보인다
        });
        order.sort(function (a, b) {
          if (a === '~' || b === '~') return a === '~' ? 1 : -1;
          return map[b].rows.length - map[a].rows.length;
        });
      } else {
        rows.forEach(function (r) { var k = r.sort === 0 ? '0' : r.sort === 1 ? '1' : '2'; add(k, SORT_LABELS[k], r); });
        order.sort();
      }
      return order.map(function (k) { return map[k]; });
    }

    function cardHtml(r) {
      var host = hostOf(r.url);
      var tags = '';
      if (r.star > 0) tags += '<span class="tag star">' + '★'.repeat(r.star) + '</span>';
      if (r.site) tags += '<span class="tag site-' + esc(r.site) + '">' + esc(SITE_LABELS[r.site] || r.site) + '</span>';
      memosOf(r).forEach(function (m) { tags += '<span class="tag memo">' + esc(m) + '</span>'; });
      // 링크 안에 버튼을 넣을 수 없어서 카드 = 링크 + 편집 버튼(형제)으로 나눈다.
      return '<div class="card" data-id="' + r.id + '">' +
        '<a class="card-link" href="' + esc(fullUrl(r.url)) + '" target="_blank" rel="noopener" title="' + esc(r.url) + '">' +
        '<span class="tt">' + esc(displayTitle(r.title)) + '</span>' +
        (r.site ? '' : '<span class="hh">' + esc(host) + '</span>') + // 사이트 태그가 있으면 도메인은 중복이라 숨긴다
        (tags ? '<span class="tags">' + tags + '</span>' : '') + '</a>' +
        '<button class="card-edit" type="button" data-id="' + r.id + '" aria-label="메모·별 편집" title="메모·별 편집" aria-expanded="false">' +
        '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>' +
        '</button></div>';
    }

    function syncChips() {
      document.querySelectorAll('.chip[data-kind]').forEach(function (c) {
        var v = state[c.dataset.kind];
        c.setAttribute('aria-pressed', String(Array.isArray(v) ? (c.dataset.k ? v.indexOf(c.dataset.k) !== -1 : !v.length) : v === c.dataset.k));
      });
    }

    function render() {
      qeClose();
      current = ALL.filter(matches);
      listEl.innerHTML = groupsOf(current).map(function (g) {
        return '<section><h2>' + esc(g.label) + '<span class="cnt">' + g.rows.length + '</span></h2>' +
          '<div class="grid">' + g.rows.map(cardHtml).join('') + '</div></section>';
      }).join('');
      document.getElementById('empty').style.display = current.length ? 'none' : 'block';
      document.getElementById('stats').textContent = current.length + ' / ' + ALL.length + '개';
      syncChips();
    }

    // ── 카드 빠른 편집 팝업: 별·메모를 바로 저장한다 ──
    var qe = document.getElementById('qe');
    var qeMemo = document.getElementById('qe-memo');
    var qeTitle = document.getElementById('qe-title');
    var qeRow = null, qeBtn = null, qeTimer = null;
    function qeStatus(t, kind) {
      var el = document.getElementById('qe-status');
      el.textContent = t;
      el.style.color = kind === 'ok' ? '#24C292' : kind === 'err' ? '#F6726A' : '#6A7FA0';
      clearTimeout(qeTimer);
      if (kind === 'ok') qeTimer = setTimeout(function () { el.textContent = ''; }, 1800);
    }
    function qeFill() {
      var r = qeRow;

    #sq-ac .ac-text { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #E3E8F2; }
    #sq-ac .ac-cnt { flex: 0 0 auto; color: #6A7FA0; font-size: .78rem; }
    @media (max-width: 640px) {
      body { padding: 0 0 5.5rem; font-size: 1rem; }
      .wrap { padding: 0 .85rem; }
      header { position: static; padding-top: .65rem; }
      .top { flex-wrap: wrap; gap: .5rem; }
      h1 { flex: 1 1 auto; }
      .stats { order: 2; }
      .search { order: 3; flex: 1 1 100%; }
      .search kbd { display: none; }
      .ctrls { order: 4; flex: 1 1 100%; }
      .ctrls select, .ctrls button { flex: 1 1 0; min-width: 0; padding: .34rem .3rem; }
      .chip-label { flex-basis: 2.2rem; }
      .grid { grid-template-columns: 1fr; gap: .45rem; }

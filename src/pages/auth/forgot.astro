---
export const prerender = false
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>비밀번호 재설정</title>
</head>
<body style="font-family:system-ui;max-width:420px;margin:60px auto;padding:0 16px">
  <h1 style="font-size:22px;margin-bottom:24px">비밀번호 재설정</h1>

  <form id="request-form" style="display:flex;flex-direction:column;gap:8px">
    <input id="email" type="email" required placeholder="가입한 이메일" style="padding:10px;border:1px solid #ccc;border-radius:6px" />
    <button type="submit" style="padding:10px;background:#1f6feb;color:#fff;border:0;border-radius:6px">재설정 코드 받기</button>
  </form>

  <form id="reset-form" style="display:none;flex-direction:column;gap:8px;margin-top:16px">
    <input id="code" type="text" inputmode="numeric" autocomplete="one-time-code" required maxlength="10" placeholder="6자리 인증 코드" style="padding:10px;border:1px solid #ccc;border-radius:6px" />
    <input id="password" type="password" required minlength="8" placeholder="새 비밀번호 (8자 이상)" style="padding:10px;border:1px solid #ccc;border-radius:6px" />
    <button type="submit" style="padding:10px;background:#16a34a;color:#fff;border:0;border-radius:6px">비밀번호 변경</button>
  </form>

  <p id="msg" style="margin-top:16px;color:#b91c1c;min-height:20px"></p>
  <p style="margin-top:24px;font-size:14px"><a href="/auth/login">로그인으로 돌아가기</a></p>

  <script is:inline>
    const $ = (id) => document.getElementById(id)
    const msg = (t, color = '#b91c1c') => { const m = $('msg'); m.style.color = color; m.textContent = t }

    $('request-form').addEventListener('submit', async (e) => {
      e.preventDefault()
      msg('전송 중...', '#374151')
      const res = await fetch('/api/auth/forgot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: $('email').value }),
      })
      const data = await res.json().catch(() => ({}))
      if (!res.ok) return msg(data.error || '오류')
      msg('가입된 이메일이라면 재설정 코드가 발송됩니다.', '#16a34a')
      $('reset-form').style.display = 'flex'
    })

    $('reset-form').addEventListener('submit', async (e) => {
      e.preventDefault()
      msg('변경 중...', '#374151')
      const code = ($('code').value || '').replace(/\D/g, '')
      if (code.length !== 6) return msg('6자리 숫자를 입력해주세요.')
      const res = await fetch('/api/auth/reset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: $('email').value,
          code,
          password: $('password').value,
        }),
      })
      const data = await res.json().catch(() => ({}))
      if (!res.ok) return msg(data.error || '오류')
      msg('비밀번호가 변경되었습니다. 로그인 페이지로 이동합니다...', '#16a34a')
      setTimeout(() => { location.href = '/auth/login' }, 1200)
    })
  </script>
</body>
</html>

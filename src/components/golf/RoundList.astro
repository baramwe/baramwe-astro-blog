---
import { countryName, type RoundListItem } from '../../lib/golf/repo'

interface Props { rounds: RoundListItem[] }
const { rounds } = Astro.props
---
<ul class="space-y-2">
  {rounds.map((r) => (
    <li>
      <a href={`/private/golf/score/rounds/${r.id}`} class="g-card !p-3 flex items-center gap-3 hover:border-emerald-400">
        <div class="flex-1 min-w-0">
          <div class="text-xs text-gray-500">{r.played_on} · {countryName(r.country_code)}</div>
          <div class="font-semibold truncate">
            {r.club_name}
            <span class="text-xs font-normal text-gray-500 ml-1">{r.front_course}{r.back_course ? ` · ${r.back_course}` : ' (9홀)'}</span>
          </div>
          {r.companions && <div class="text-xs text-gray-500 truncate">with {r.companions}</div>}
          {r.memo && <div class="text-sm text-gray-700 truncate mt-0.5">“{r.memo}”</div>}
        </div>
        <div class="text-2xl font-bold text-emerald-800 tabular-nums">{r.my_total ?? '-'}</div>
      </a>
    </li>
  ))}
</ul>

---
import '../styles/tw.css'
import GolfSearch from '../components/golf/GolfSearch.tsx'

interface Props {
  title: string
  /** 상단 탭 하이라이트 */
  active?: 'home' | 'friends' | 'ranking' | 'rounds' | 'new' | 'clubs' | 'manage'
}

const { title, active } = Astro.props
const BASE = '/private/golf/score'
const tabs = [
  { key: 'home', label: '홈', href: BASE },
  { key: 'friends', label: '골친', href: `${BASE}/friends` },
  { key: 'ranking', label: '랭킹', href: `${BASE}/ranking` },
]
// 톱니바퀴 팝업 메뉴
const menu = [
  { key: 'new', label: '+ 라운드 입력', href: `${BASE}/rounds/new` },
  { key: 'clubs', label: '골프장 · 코스', href: `${BASE}/clubs` },
  { key: 'manage', label: '기록 관리', href: `${BASE}/manage` },
]
const menuActive = menu.some((m) => m.key === active)
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#f4f1ea" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} · 골프 스코어</title>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    :root { --g-ink: #20231f; --g-muted: #73766f; --g-line: #d9d8d1; --g-paper: #f4f1ea; --g-accent: #176d50; }
    body { margin: 0; background: var(--g-paper); color: var(--g-ink); font-family: 'Pretendard Variable', 'Pretendard', 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; letter-spacing: -.018em; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
    button:disabled { cursor: not-allowed; opacity: .5; }
    input, select, textarea { font: inherit; color: inherit; }
    table { border-collapse: collapse; }
    .g-input { width: 100%; padding: .65rem 0; border: 0; border-bottom: 1px solid var(--g-line); border-radius: 0; background: transparent; font-size: 16px; }
    .g-input:focus { outline: 0; border-color: var(--g-accent); }
    .g-btn { padding: .65rem 1rem; border-radius: 0; background: var(--g-accent); color: #fff; font-weight: 700; letter-spacing: -.01em; transition: background-color .18s ease, opacity .18s ease; }
    .g-btn:hover { background: #125740; }
    .g-btn-ghost { padding: .55rem .7rem; border-radius: 0; border-bottom: 1px solid #aeb1a9; background: transparent; transition: border-color .18s ease, color .18s ease; }
    .g-btn-ghost:hover { border-color: var(--g-accent); color: var(--g-accent); }
    .g-card { border-top: 1px solid var(--g-line); padding: 1rem 0; }
    .g-data { font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace; font-variant-numeric: tabular-nums; letter-spacing: -.045em; }
  </style>
</head>
<body>
  <header class="sticky top-0 z-20 border-b border-[#d9d8d1] bg-[#f4f1ea]/95 text-[#20231f] backdrop-blur">
    <div class="mx-auto flex max-w-3xl items-center gap-3 px-4 pb-3 pt-4">
      <a href={BASE} class="shrink-0 font-serif text-[1.1rem] font-bold tracking-[-.05em]"><span class="hidden min-[400px]:inline">골프 </span>스코어</a>
      <GolfSearch client:idle />
      <details id="golf-menu" class="relative shrink-0">
        <summary aria-label="메뉴" title="메뉴" class={`list-none cursor-pointer select-none border-b pb-0.5 text-xs font-bold tracking-[.08em] [&::-webkit-details-marker]:hidden ${menuActive ? 'border-[#176d50] text-[#176d50]' : 'border-[#aeb1a9] text-[#53564f]'}`}>MENU</summary>
        <div class="absolute right-0 top-full z-30 mt-3 w-44 border border-[#d9d8d1] bg-[#fdfcf8] py-1 text-[#20231f]">
          {menu.map((m) => (
            <a href={m.href} class={`block px-4 py-2.5 text-[15px] transition-colors hover:bg-[#e8eee8] ${active === m.key ? 'font-semibold text-[#176d50]' : ''}`}>{m.label}</a>
          ))}
        </div>
      </details>
    </div>
    <nav class="mx-auto flex max-w-3xl gap-6 overflow-x-auto px-4 text-sm">
      {tabs.map((t) => (
        <a
          href={t.href}
          class={`whitespace-nowrap border-b-2 py-2.5 transition-colors ${active === t.key ? 'border-[#176d50] font-bold text-[#176d50]' : 'border-transparent text-[#73766f] hover:text-[#20231f]'}`}
        >{t.label}</a>
      ))}
    </nav>
  </header>
  <main class="mx-auto max-w-3xl px-4 py-8 pb-14">
    <slot />
  </main>
  <script>
    // 톱니바퀴 메뉴: 바깥을 누르거나 Esc 면 닫기
    const menu = document.getElementById('golf-menu') as HTMLDetailsElement | null
    document.addEventListener('click', (e) => {
      if (menu?.open && !menu.contains(e.target as Node)) menu.open = false
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu) menu.open = false
    })
  </script>
</body>
</html>

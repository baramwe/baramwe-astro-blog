---
import '../styles/tw.css'

interface Props {
  title: string
  /** 상단 탭 하이라이트 */
  active?: 'home' | 'friends' | 'rounds' | 'new' | 'clubs' | 'manage'
}

const { title, active } = Astro.props
const BASE = '/private/golf/score'
const tabs = [
  { key: 'home', label: '홈', href: BASE },
  { key: 'friends', label: '골친', href: `${BASE}/friends` },
  { key: 'new', label: '+ 입력', href: `${BASE}/rounds/new` },
  { key: 'clubs', label: '골프장', href: `${BASE}/clubs` },
]
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#065f46" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} · 골프 스코어</title>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: #f5f7f6; color: #111827; font-family: ui-sans-serif, system-ui, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
    button:disabled { cursor: not-allowed; opacity: .5; }
    input, select, textarea { font: inherit; color: inherit; }
    table { border-collapse: collapse; }
    .g-input { width: 100%; padding: .55rem .7rem; border: 1px solid #d1d5db; border-radius: .5rem; background: #fff; font-size: 16px; }
    .g-input:focus { outline: 2px solid #10b981; outline-offset: -1px; border-color: transparent; }
    .g-btn { padding: .55rem 1rem; border-radius: .5rem; background: #047857; color: #fff; font-weight: 600; }
    .g-btn-ghost { padding: .45rem .8rem; border-radius: .5rem; border: 1px solid #d1d5db; background: #fff; }
    .g-card { background: #fff; border: 1px solid #e5e7eb; border-radius: .9rem; padding: 1rem; }
  </style>
</head>
<body>
  <header class="sticky top-0 z-20 bg-emerald-800 text-white shadow">
    <div class="mx-auto max-w-3xl px-4 pt-3 pb-2 flex items-center justify-between">
      <a href={BASE} class="text-lg font-bold tracking-tight">⛳ 골프 스코어</a>
      <a href={`${BASE}/manage`} aria-label="기록 관리" title="기록 관리" class={`text-lg leading-none px-1 ${active === 'manage' ? 'text-white' : 'text-emerald-300/70'}`}>⚙</a>
    </div>
    <nav class="mx-auto max-w-3xl px-2 flex gap-1 overflow-x-auto text-base">
      {tabs.map((t) => (
        <a
          href={t.href}
          class={`px-3.5 py-2.5 whitespace-nowrap border-b-2 ${active === t.key ? 'border-white font-semibold' : 'border-transparent text-emerald-100'}`}
        >{t.label}</a>
      ))}
    </nav>
  </header>
  <main class="mx-auto max-w-3xl px-4 py-5 pb-24">
    <slot />
  </main>
</body>
</html>

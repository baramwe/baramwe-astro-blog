---
import '../styles/tw.css'
import GolfSearch from '../components/golf/GolfSearch.tsx'

interface Props {
  title: string
  /** 상단 탭 하이라이트 */
  active?: 'home' | 'friends' | 'ranking' | 'rounds' | 'new' | 'clubs' | 'manage'
}

const { title, active } = Astro.props
const BASE = '/private/golf/score'
const tabs = [
  { key: 'home', label: '홈', href: BASE },
  { key: 'friends', label: '골친', href: `${BASE}/friends` },
  { key: 'ranking', label: '랭킹', href: `${BASE}/ranking` },
]
// 톱니바퀴 팝업 메뉴
const menu = [
  { key: 'new', label: '+ 라운드 입력', href: `${BASE}/rounds/new` },
  { key: 'clubs', label: '골프장 · 코스', href: `${BASE}/clubs` },
  { key: 'manage', label: '기록 관리', href: `${BASE}/manage` },
]
const menuActive = menu.some((m) => m.key === active)
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#065f46" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title} · 골프 스코어</title>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin: 0; background: #f5f7f6; color: #111827; font-family: ui-sans-serif, system-ui, -apple-system, 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; border: 0; background: none; color: inherit; }
    button:disabled { cursor: not-allowed; opacity: .5; }
    input, select, textarea { font: inherit; color: inherit; }
    table { border-collapse: collapse; }
    .g-input { width: 100%; padding: .55rem .7rem; border: 1px solid #d1d5db; border-radius: .5rem; background: #fff; font-size: 16px; }
    .g-input:focus { outline: 2px solid #10b981; outline-offset: -1px; border-color: transparent; }
    .g-btn { padding: .55rem 1rem; border-radius: .5rem; background: #047857; color: #fff; font-weight: 600; }
    .g-btn-ghost { padding: .45rem .8rem; border-radius: .5rem; border: 1px solid #d1d5db; background: #fff; }
    .g-card { background: #fff; border: 1px solid #e5e7eb; border-radius: .9rem; padding: 1rem; }
  </style>
</head>
<body>
  <header class="sticky top-0 z-20 bg-emerald-800 text-white shadow">
    <div class="mx-auto max-w-3xl px-4 pt-3 pb-2 flex items-center gap-3">
      <a href={BASE} class="shrink-0 text-lg font-bold tracking-tight">⛳<span class="hidden min-[400px]:inline"> 골프 스코어</span></a>
      <GolfSearch client:idle />
      <details id="golf-menu" class="relative shrink-0">
        <summary aria-label="메뉴" title="메뉴" class={`list-none cursor-pointer select-none text-lg leading-none px-1 [&::-webkit-details-marker]:hidden ${menuActive ? 'text-white' : 'text-emerald-300/70'}`}>⚙</summary>
        <div class="absolute right-0 top-full z-30 mt-2 w-44 overflow-hidden rounded-xl border border-gray-200 bg-white py-1 text-gray-900 shadow-lg">
          {menu.map((m) => (
            <a href={m.href} class={`block px-4 py-2.5 text-[15px] hover:bg-emerald-50 ${active === m.key ? 'font-semibold text-emerald-800' : ''}`}>{m.label}</a>
          ))}
        </div>
      </details>
    </div>
    <nav class="mx-auto max-w-3xl px-2 flex gap-1 overflow-x-auto text-base">
      {tabs.map((t) => (
        <a
          href={t.href}
          class={`px-3.5 py-2.5 whitespace-nowrap border-b-2 ${active === t.key ? 'border-white font-semibold' : 'border-transparent text-emerald-100'}`}
        >{t.label}</a>
      ))}
    </nav>
  </header>
  <main class="mx-auto max-w-3xl px-4 py-5 pb-24">
    <slot />
  </main>
  <script>
    // 톱니바퀴 메뉴: 바깥을 누르거나 Esc 면 닫기
    const menu = document.getElementById('golf-menu') as HTMLDetailsElement | null
    document.addEventListener('click', (e) => {
      if (menu?.open && !menu.contains(e.target as Node)) menu.open = false
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu) menu.open = false
    })
  </script>
</body>
</html>
